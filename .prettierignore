tests/fxeq-golden/*.json
tests/morph-dynamics-golden/*.json

# Datasets and the hash-pinned manifests over them. The SFT manifest's bytes
# are hashed into public/models/intent-model-report.json and the manifest
# writer refuses to run when they disagree (scripts/write-intent-model-manifest.mts),
# so reformatting them breaks the training pin — they are inputs, not code.
scripts/data/

# Generated audit reports. The emitter owns their byte shape; the audit
# scripts rewrite them in place.
docs/**/*.report.json

# The generated status page. `npm run status:report` rewrites docs/STATUS.md
# on every run (it carries the generation timestamp), and prettier's only
