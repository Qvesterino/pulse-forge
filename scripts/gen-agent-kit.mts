/**
 * Generate the machine-readable MCP manifest for the agent starter kit
 * (docs/AGENT-KIT.md). Deterministic on purpose: no timestamp, so the committed
 * artifact is exactly the tool surface — and `tests/agent-kit.test.ts` pins it
 * to the live MCP_TOOLS, which is the same strength a drift section would give
 * without touching the shared drift script.
 *
 *   npm run gen:agent-kit
 */
import { mkdirSync, writeFileSync } from "node:fs";
import path from "node:path";
import { MCP_TOOLS } from "../src/mcp/tools";
import { toolAnnotations, toolRisk } from "../src/mcp/agentTrust";

const manifest = {
  format: "kyx-agent-manifest/1",
  note:
    "Generated by `npm run gen:agent-kit` from src/mcp/tools.ts. The risk classes and annotations come from " +
    "src/mcp/agentTrust.ts; tests/agent-kit.test.ts fails if this file and the live surface disagree.",
  tools: MCP_TOOLS.map((tool) => ({
    name: tool.name,
    risk: toolRisk(tool.name),
    annotations: toolAnnotations(tool.name),
  })),
};
const outDir = path.resolve("docs");
mkdirSync(outDir, { recursive: true });
const outPath = path.join(outDir, "mcp-manifest.json");
writeFileSync(outPath, `${JSON.stringify(manifest, null, 2)}\n`, "utf8");
console.log(`wrote ${outPath} (${manifest.tools.length} tools)`);
