[31m+ const phaser: EffectDefinition = {[39m
[31m+   type: "phaser",[39m
[31m+   name: "Phaser",[39m
[31m+   category: "movement",[39m
[31m+   params: phaserParams,[39m
[31m+   factory(ctx, instance, env) {[39m
