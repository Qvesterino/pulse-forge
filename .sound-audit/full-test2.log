[31m+         keyFollower?.dispose();[39m
[31m+         keyInput.disconnect();[39m
[31m+         keyLp?.disconnect();[39m
[31m+         rectifier?.disconnect();[39m
[31m+         smoothLp?.disconnect();[39m
[31m+         sens?.disconnect();[39m
[31m+         clampShape?.disconnect();[39m
[31m+       },[39m
[31m+     };[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Distortion ---------------- */[39m
[31m+ // Harder-hitting waveshaper than Saturation. Cubic clip curve produces more 3rd-order[39m
[31m+ // harmonic content for a recognisable "distortion" voice; tone stages the high end.[39m
[31m+[39m
[31m+ const distortion: EffectDefinition = {[39m
[31m+   type: "distortion",[39m
[31m+   name: "Distortion",[39m
[31m+   category: "character",[39m
[31m+   params: distortionParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     const mix = mixBus(ctx);[39m
[31m+     // Pre-HPF (see saturation): keeps heavy bass out of the shaper so the[39m
[31m+     // distortion generates harmonics of the mids instead of intermod mud.[39m
[31m+     const preHP = ctx.createBiquadFilter();[39m
[31m+     preHP.type = "highpass";[39m
[31m+     preHP.frequency.value = instance.params.preHpfHz ?? 20;[39m
[31m+     preHP.Q.value = 0.7;[39m
[31m+     const pre = ctx.createGain();[39m
[31m+     const shaper = ctx.createWaveShaper();[39m
[31m+     shaper.oversample = "4x";[39m
[31m+     const tone = ctx.createBiquadFilter();[39m
[31m+     tone.type = "lowpass";[39m
[31m+     const out = ctx.createGain();[39m
[31m+     mix.wet.connect(preHP).connect(pre).connect(shaper).connect(tone).connect(out).connect(mix.output);[39m
[31m+[39m
[31m+     let mode = Math.round(instance.params.character ?? 3);[39m
[31m+     let driveVal = instance.params.drive ?? 0.4;[39m
[31m+     let biasVal = instance.params.bias ?? 0;[39m
[31m+     const applyCurve = () => {[39m
[31m+       shaper.curve = characterCurve(Math.max(0, Math.min(4, mode)) as CharacterMode, driveVal, biasVal);[39m
[31m+     };[39m
[31m+     applyCurve();[39m
[31m+     const apply = (id: string, v: number, when: number) => {[39m
[31m+       switch (id) {[39m
[31m+         case "drive":[39m
[31m+           driveVal = v;[39m
[31m+           applyCurve();[39m
[31m+           break;[39m
[31m+         case "character":[39m
[31m+           mode = Math.round(v);[39m
[31m+           applyCurve();[39m
[31m+           break;[39m
[31m+         case "bias":[39m
[31m+           biasVal = v;[39m
[31m+           applyCurve();[39m
[31m+           break;[39m
[31m+         case "tone":[39m
[31m+           smooth(tone.frequency, v, when);[39m
[31m+           break;[39m
[31m+         case "preHpfHz":[39m
[31m+           smooth(preHP.frequency, v, when);[39m
[31m+           break;[39m
