[31m+       }[39m
[31m+     };[39m
[31m+     connectStages();[39m
[31m+[39m
[31m+     const out = ctx.createGain();[39m
[31m+     mix.output.connect(out);[39m
[31m+[39m
[31m+     // C2 tempo-sync: the LFO locks to musical divisions when params.sync is[39m
[31m+     // set; OFF keeps the user's Hz knob authoritative. The R oscillator[39m
[31m+     // tracks the same writes with the spread detune applied.[39m
[31m+     const writeRates = (hz: number, when: number): void => {[39m
[31m+       const safe = Math.max(0.05, hz);[39m
[31m+       oscL.frequency.setTargetAtTime(safe, when, 0.05);[39m
[31m+       oscR.frequency.setTargetAtTime(safe * (1 + 0.03 * spreadVal), when, 0.05);[39m
[31m+     };[39m
[31m+     const lfoSync = createLfoSyncController({[39m
[31m+       rateParamId: "rate",[39m
[31m+       defaultRate: 0.4,[39m
[31m+       initialRate: rateHz,[39m
[31m+       initialSync: instance.params.sync,[39m
[31m+       initialBpm: env.bpm,[39m
[31m+       write: (_id, hz, when) => writeRates(hz, when ?? ctx.currentTime),[39m
[31m+     });[39m
[31m+[39m
[31m+     const apply = (id: string, v: number, when: number) => {[39m
[31m+       switch (id) {[39m
[31m+         case "rate":[39m
[31m+         case "sync":[39m
[31m+           lfoSync.parameter(id, v, when);[39m
[31m+           break;[39m
[31m+         case "depth":[39m
[31m+           depthL.gain.setTargetAtTime(1500 * v, when, 0.05);[39m
[31m+           depthR.gain.setTargetAtTime(1500 * v, when, 0.05);[39m
