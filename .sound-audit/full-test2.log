[31m+           smooth(out.gain, dbToLin(v), when);[39m
[31m+           break;[39m
[31m+       }[39m
[31m+     };[39m
[31m+     for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+     return {[39m
[31m+       input: mix.input,[39m
[31m+       output: mix.output,[39m
[31m+       setParameter: (id, v) => apply(id, v, ctx.currentTime),[39m
[31m+       setParameterAt: (id, v, when) => apply(id, v, when),[39m
[31m+       dispose: () => {[39m
[31m+         mix.input.disconnect();[39m
[31m+         mix.output.disconnect();[39m
[31m+         preHP.disconnect();[39m
[31m+         pre.disconnect();[39m
[31m+         shaper.disconnect();[39m
[31m+         tone.disconnect();[39m
[31m+         out.disconnect();[39m
[31m+       },[39m
[31m+     };[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Bitcrusher ---------------- */[39m
[31m+ // Bit-depth reduction via a stepped WaveShaper curve. `bits` controls the[39m
[31m+ // number of discrete output levels (2^bits). `downsample` is approximated by[39m
[31m+ // adjusting the curve's `n` (finer curves for `factor=1` produce the full[39m
[31m+ // quantised signal; larger factors widen each step, which behaves like a[39m
[31m+ // quantised ramp) — a coarse but AudioWorklet-free approximation.[39m
[31m+[39m
[31m+ const bitcrusher: EffectDefinition = {[39m
[31m+   type: "bitcrusher",[39m
[31m+   name: "Bitcrusher",[39m
[31m+   category: "character",[39m
[31m+   params: bitcrusherParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     // Use AudioWorklet when modules are loaded for THIS context (fixes broken[39m
[31m+     // downsample). OfflineAudioContexts must load their own modules first —[39m
[31m+     // see loadWorkletModules().[39m
[31m+     if (isWorkletReady("bitcrusher", ctx)) {[39m
[31m+       return createBitcrusherNode(ctx, instance);[39m
[31m+     }[39m
[31m+     // Fallback: old WaveShaperNode implementation[39m
[31m+     const mix = mixBus(ctx);[39m
[31m+     const shaper = ctx.createWaveShaper();[39m
[31m+     shaper.oversample = "none";[39m
[31m+     const out = ctx.createGain();[39m
[31m+     mix.wet.connect(shaper).connect(out).connect(mix.output);[39m
[31m+[39m
[31m+     let bitsVal = 8;[39m
[31m+     let factorVal = 1;[39m
[31m+     const buildCurve = (bits: number, factor: number): Float32Array<ArrayBuffer> => {[39m
[31m+       // Curve must be monotonic for WaveShaper; quantise input into discrete[39m
[31m+       // steps. n equals the step count so WaveShaper's linear interp between[39m
[31m+       // samples doesn't smear the plateau (which would defeat quantisation).[39m
[31m+       const steps = Math.max(2, Math.pow(2, Math.max(1, Math.round(bits))));[39m
[31m+       const n = steps;[39m
[31m+       const curve = new Float32Array(new ArrayBuffer(n * 4));[39m
[31m+       const step = 2 / (steps - 1);[39m
[31m+       for (let i = 0; i < n; i++) {[39m
[31m+         const idx = i;[39m
[31m+         const q = -1 + idx * step;[39m
[31m+         curve[i] = q;[39m
[31m+       }[39m
[31m+       // `factor` not used inside the curve math (WaveShaper can't hold a value[39m
[31m+       // across samples without a worklet), but we keep it in the closure so[39m
[31m+       // the parameter is wired and a future AudioWorklet port can take over.[39m
[31m+       void factor;[39m
[31m+       return curve;[39m
[31m+     };[39m
[31m+     shaper.curve = buildCurve(bitsVal, factorVal);[39m
[31m+[39m
[31m+     const apply = (id: string, v: number, when: number) => {[39m
[31m+       switch (id) {[39m
[31m+         case "bits":[39m
[31m+           bitsVal = Math.max(1, v);[39m
[31m+           shaper.curve = buildCurve(bitsVal, factorVal);[39m
[31m+           break;[39m
[31m+         case "downsample":[39m
[31m+           factorVal = Math.max(1, Math.round(v));[39m
[31m+           shaper.curve = buildCurve(bitsVal, factorVal);[39m
[31m+           break;[39m
[31m+         case "mix":[39m
[31m+           mix.setMix(v, when);[39m
[31m+           break;[39m
[31m+         case "output":[39m
[31m+           smooth(out.gain, dbToLin(v), when);[39m
[31m+           break;[39m
[31m+       }[39m
[31m+     };[39m
[31m+     for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+     return {[39m
[31m+       input: mix.input,[39m
[31m+       output: mix.output,[39m
[31m+       degraded: true,[39m
[31m+       degradedReason: "Fallback quality — sample-and-hold downsampling inactive",[39m
[31m+       setParameter: (id, v) => apply(id, v, ctx.currentTime),[39m
[31m+       setParameterAt: (id, v, when) => apply(id, v, when),[39m
[31m+       dispose: () => {[39m
[31m+         mix.input.disconnect();[39m
[31m+         mix.output.disconnect();[39m
[31m+         shaper.disconnect();[39m
[31m+         out.disconnect();[39m
[31m+       },[39m
[31m+     };[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Chorus ---------------- */[39m
[31m+ // Two delay voices in true stereo (worklet); legacy native graph survives as[39m
[31m+ // the degraded fallback for contexts without AudioWorklet.[39m
[31m+[39m
[31m+ function chorusNativeFallback(ctx: BaseAudioContext, instance: EffectInstance): EffectRuntime {[39m
[31m+   const mix = mixBus(ctx);[39m
[31m+   const delay1 = ctx.createDelay(0.05);[39m
[31m+   delay1.delayTime.value = 0.012;[39m
[31m+   const delay2 = ctx.createDelay(0.05);[39m
[31m+   delay2.delayTime.value = 0.018;[39m
[31m+   const lfo1 = ctx.createOscillator();[39m
[31m+   lfo1.type = "sine";[39m
[31m+   lfo1.frequency.value = 0.6;[39m
[31m+   const lfo1Depth = ctx.createGain();[39m
[31m+   lfo1Depth.gain.value = 0.004;[39m
