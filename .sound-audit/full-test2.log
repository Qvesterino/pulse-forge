[31m+     gMidL.gain.value = 0.5;[39m
[31m+     const gMidR = ctx.createGain();[39m
[31m+     gMidR.gain.value = 0.5;[39m
[31m+     const gSideL = ctx.createGain();[39m
[31m+     gSideL.gain.value = 0.5;[39m
[31m+     const gSideR = ctx.createGain();[39m
[31m+     gSideR.gain.value = -0.5;[39m
[31m+[39m
[31m+     // Mid EQ[39m
[31m+     const midLow = ctx.createBiquadFilter();[39m
[31m+     midLow.type = "lowshelf";[39m
[31m+     const midHigh = ctx.createBiquadFilter();[39m
[31m+     midHigh.type = "highshelf";[39m
[31m+     // Side EQ[39m
[31m+     const sideLow = ctx.createBiquadFilter();[39m
[31m+     sideLow.type = "lowshelf";[39m
[31m+     const sideHigh = ctx.createBiquadFilter();[39m
[31m+     sideHigh.type = "highshelf";[39m
[31m+[39m
[31m+     // Decode gains[39m
[31m+     const gLmid = ctx.createGain();[39m
[31m+     gLmid.gain.value = 1;[39m
[31m+     const gLside = ctx.createGain();[39m
[31m+     gLside.gain.value = 1;[39m
[31m+     const gRmid = ctx.createGain();[39m
[31m+     gRmid.gain.value = 1;[39m
[31m+     const gRside = ctx.createGain();[39m
[31m+     gRside.gain.value = -1;[39m
