[31m+     depthL.gain.value = 600;[39m
[31m+     const depthR = ctx.createGain();[39m
[31m+     depthR.gain.value = 600;[39m
[31m+     oscL.connect(depthL);[39m
[31m+     oscR.connect(depthR);[39m
[31m+     oscL.start();[39m
[31m+     oscR.start();[39m
[31m+[39m
[31m+     const baseL = ctx.createGain();[39m
[31m+     const baseR = ctx.createGain();[39m
[31m+     baseL.gain.value = centerHz;[39m
[31m+     baseR.gain.value = centerHz;[39m
[31m+[39m
[31m+     const wireStages = (): void => {[39m
[31m+       for (const g of [baseL, baseR, depthL, depthR]) {[39m
[31m+         try {[39m
[31m+           g.disconnect();[39m
[31m+         } catch {[39m
[31m+           /* nothing to disconnect */[39m
[31m+         }[39m
[31m+       }[39m
[31m+       for (const stage of stagesL) {[39m
[31m+         baseL.connect(stage.frequency);[39m
[31m+         depthL.connect(stage.frequency);[39m
