[31m+         } catch {[39m
[31m+           /* not started */[39m
[31m+         }[39m
[31m+         oscL.disconnect();[39m
[31m+         oscR.disconnect();[39m
[31m+         depthL.disconnect();[39m
[31m+         depthR.disconnect();[39m
[31m+         baseL.disconnect();[39m
[31m+         baseR.disconnect();[39m
[31m+         fbL.disconnect();[39m
[31m+         fbR.disconnect();[39m
[31m+         wetL.disconnect();[39m
[31m+         wetR.disconnect();[39m
[31m+         splitter.disconnect();[39m
[31m+         merger.disconnect();[39m
[31m+         for (const chain of [stagesL, stagesR]) {[39m
[31m+           for (const stage of chain) {[39m
[31m+             try {[39m
[31m+               stage.disconnect();[39m
[31m+             } catch {[39m
[31m+               /* already */[39m
[31m+             }[39m
[31m+           }[39m
[31m+         }[39m
[31m+         mix.input.disconnect();[39m
[31m+         mix.output.disconnect();[39m
[31m+         out.disconnect();[39m
[31m+       },[39m
[31m+     };[39m
[31m+   },[39m
[31m+ };[39m
