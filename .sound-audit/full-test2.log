[31m+ function eqNativeFallback(ctx: BaseAudioContext, instance: EffectInstance): EffectRuntime {[39m
[31m+   const hp = ctx.createBiquadFilter();[39m
[31m+   hp.type = "highpass";[39m
[31m+   const low = ctx.createBiquadFilter();[39m
[31m+   low.type = "lowshelf";[39m
[31m+   const lowMid = ctx.createBiquadFilter();[39m
[31m+   lowMid.type = "peaking";[39m
[31m+   const highMid = ctx.createBiquadFilter();[39m
[31m+   highMid.type = "peaking";[39m
[31m+   const high = ctx.createBiquadFilter();[39m
[31m+   high.type = "highshelf";[39m
[31m+   const lp = ctx.createBiquadFilter();[39m
