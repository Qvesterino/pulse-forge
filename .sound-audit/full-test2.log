[31m+     gMidL.connect(mergerMS, 0, 0);[39m
[31m+     gMidR.connect(mergerMS, 0, 0);[39m
[31m+     gSideL.connect(mergerMS, 0, 1);[39m
[31m+     gSideR.connect(mergerMS, 0, 1);[39m
