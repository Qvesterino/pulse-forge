[31m+       sensitivity.gain.value = 1.5;[39m
[31m+       const clamp = ctx.createWaveShaper();[39m
[31m+       clamp.oversample = "none";[39m
[31m+       clamp.curve = (() => {[39m
[31m+         const n = 1024;[39m
[31m+         const curve = new Float32Array(new ArrayBuffer(n * 4));[39m
[31m+         for (let i = 0; i < n; i++) curve[i] = Math.min(1, Math.max(0, (i / (n - 1)) * 2 - 1));[39m
[31m+         return curve;[39m
[31m+       })();[39m
[31m+       keyLp = lp;[39m
[31m+       rectifier = rect;[39m
[31m+       smoothLp = smooth;[39m
[31m+       sens = sensitivity;[39m
[31m+       clampShape = clamp;[39m
[31m+       keyInput.connect(lp).connect(rect).connect(smooth).connect(sensitivity).connect(clamp).connect(amt);[39m
[31m+     }[39m
[31m+[39m
[31m+     let keySource: AudioNode | null = null;[39m
[31m+[39m
[31m+     let bpm = env.bpm;[39m
[31m+     let release = instance.params.release ?? 0.5;[39m
[31m+     let rateIndex = Math.max(0, Math.min(PUMP_DIVISIONS.length - 1, Math.round(instance.params.rate ?? 2)));[39m
[31m+     let osc: OscillatorNode | null = null;[39m
[31m+[39m
[31m+     if (smoothLp) smoothLp.frequency.value = releaseLpFreq(release);[39m
[31m+[39m
[31m+     const freqOf = () => (bpm / 60) * PUMP_DIVISIONS[rateIndex].mult;[39m
[31m+     const applyCurve = () => {[39m
