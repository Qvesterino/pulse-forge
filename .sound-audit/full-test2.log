[31m+[39m
[31m+     applyCurve();[39m
[31m+     startOsc(0);[39m
[31m+[39m
[31m+     const apply = (id: string, v: number, when: number) => {[39m
[31m+       switch (id) {[39m
[31m+         case "amount":[39m
[31m+           smooth(amt.gain, v, when);[39m
[31m+           break;[39m
[31m+         case "rate":[39m
[31m+           rateIndex = Math.max(0, Math.min(PUMP_DIVISIONS.length - 1, Math.round(v)));[39m
[31m+           if (osc) smooth(osc.frequency, freqOf(), when, 0.05);[39m
[31m+           break;[39m
[31m+         case "release":[39m
