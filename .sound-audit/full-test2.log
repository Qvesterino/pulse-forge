[31m+ const stepGate: EffectDefinition = {[39m
[31m+   type: "stepGate",[39m
[31m+   name: "Step Gate",[39m
[31m+   category: "movement",[39m
[31m+   params: stepGateParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     if (isWorkletReady("stepGate", ctx)) {[39m
[31m+       const handle = createStepGateNode(ctx, instance);[39m
[31m+       if (instance.steps && instance.steps.length > 0) handle.setPattern(instance.steps);[39m
[31m+       return {[39m
[31m+         input: handle.input,[39m
[31m+         output: handle.output,[39m
[31m+         setParameter: handle.setParameter,[39m
[31m+         setParameterAt: handle.setParameterAt,[39m
[31m+         syncBpm: handle.syncBpm,[39m
[31m+         onTransportStarted: handle.onTransportStarted,[39m
[31m+         dispose: handle.dispose,[39m
[31m+       };[39m
[31m+     }[39m
[31m+     // Transparent 1:1 bypass fallback — a gate that doesn't gate silently[39m
[31m+     // would be worse than no gate; the UI shows the warning badge.[39m
[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — step gate bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- SV Filter (TPT SVF) ---------------- */[39m
[31m+ // Zero-delay topology-preserving state variable filter (Andy Simper).[39m
[31m+ // LP/HP/BP/Notch modes, resonance up to self-oscillation, tanh drive.[39m
[31m+ // Unlike BiquadFilterNode, the feedback path has NO one-sample delay —[39m
[31m+ // modulated cutoff stays clean and the resonance behaviour is analog-like.[39m
[31m+[39m
[31m+ const svFilter: EffectDefinition = {[39m
[31m+   type: "svFilter",[39m
[31m+   name: "SV Filter",[39m
