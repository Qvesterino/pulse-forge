[31m+[39m
[31m+ /* ---------------- Haas Widener ---------------- */[39m
[31m+[39m
[31m+ const haasWidener: EffectDefinition = {[39m
[31m+   type: "haasWidener",[39m
[31m+   name: "Haas Widener",[39m
[31m+   category: "movement",[39m
[31m+   params: haasWidenerParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     const input = ctx.createGain();[39m
[31m+     const output = ctx.createGain();[39m
[31m+     const splitter = ctx.createChannelSplitter(2);[39m
[31m+     const merger = ctx.createChannelMerger(2);[39m
[31m+     const delay = ctx.createDelay(0.05);[39m
[31m+     delay.delayTime.value = (instance.params.delayMs ?? 12) / 1000;[39m
[31m+     const wet = ctx.createGain();[39m
[31m+     wet.gain.value = instance.params.width ?? 0.7;[39m
[31m+     const dry = ctx.createGain();[39m
[31m+     dry.gain.value = 1 - (instance.params.width ?? 0.7);[39m
[31m+     // CROSSFEED: a (optionally inverted) delayed copy of L is ADDED to the[39m
[31m+     // right channel — true inter-channel decorrelation (real width), not[39m
[31m+     // just the L comb filter the old version produced.[39m
[31m+     const xf = ctx.createGain();[39m
[31m+     const applyXf = (level: number, invert: boolean, when: number): void => {[39m
[31m+       xf.gain.setTargetAtTime(Math.max(0, Math.min(1, level)) * (invert ? -1 : 1) * 0.8, when, 0.03);[39m
[31m+     };[39m
[31m+     applyXf(instance.params.crossfeed ?? 0.4, Math.round(instance.params.invert ?? 0) >= 0.5, ctx.currentTime);[39m
[31m+     const fb = ctx.createGain();[39m
[31m+     fb.gain.value = instance.params.feedback ?? 0;[39m
[31m+[39m
[31m+     // L channel Haas: dry + delayed via width blend. Upmix mono first — a[39m
[31m+     // bare splitter fed mono leaves channel 1 (the untouched right leg) dead.[39m
[31m+     const upmixIn = stereoUpmix(ctx);[39m
[31m+     input.connect(upmixIn).connect(splitter);[39m
[31m+     splitter.connect(delay, 0);[39m
[31m+     splitter.connect(dry, 0);[39m
[31m+     delay.connect(wet);[39m
[31m+     wet.connect(merger, 0, 0);[39m
[31m+     dry.connect(merger, 0, 0);[39m
[31m+     // R channel direct[39m
[31m+     splitter.connect(merger, 1, 1);[39m
[31m+     // Delayed-left copy into the RIGHT channel (crossfeed — the widening).[39m
[31m+     delay.connect(xf).connect(merger, 0, 1);[39m
[31m+     // Feedback: delayed L back into delay input (adds shimmer)[39m
[31m+     wet.connect(fb).connect(delay);[39m
[31m+     merger.connect(output);[39m
[31m+[39m
[31m+     const apply = (id: string, v: number, when: number) => {[39m
[31m+       switch (id) {[39m
[31m+         case "delayMs":[39m
[31m+           smooth(delay.delayTime, v / 1000, when, 0.05);[39m
[31m+           break;[39m
[31m+         case "width":[39m
[31m+           smooth(wet.gain, v, when);[39m
[31m+           smooth(dry.gain, 1 - v, when);[39m
[31m+           break;[39m
[31m+         case "crossfeed":[39m
[31m+           applyXf(v, Math.round(instance.params.invert ?? 0) >= 0.5, when);[39m
[31m+           break;[39m
[31m+         case "invert":[39m
[31m+           applyXf(instance.params.crossfeed ?? 0.4, Math.round(v) >= 0.5, when);[39m
[31m+           break;[39m
[31m+         case "feedback":[39m
[31m+           smooth(fb.gain, v, when);[39m
[31m+           break;[39m
[31m+       }[39m
[31m+     };[39m
[31m+     for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+     return {[39m
[31m+       input,[39m
[31m+       output,[39m
[31m+       setParameter: (id, v) => apply(id, v, ctx.currentTime),[39m
[31m+       setParameterAt: (id, v, when) => apply(id, v, when),[39m
[31m+       getAudioParam: (paramId: string) => {[39m
[31m+         switch (paramId) {[39m
[31m+           case "delayMs":[39m
[31m+             return delay.delayTime;[39m
[31m+           case "width":[39m
[31m+             return wet.gain;[39m
[31m+           case "feedback":[39m
[31m+             return fb.gain;[39m
[31m+           default:[39m
[31m+             return null;[39m
[31m+         }[39m
[31m+       },[39m
[31m+       dispose: () => {[39m
[31m+         input.disconnect();[39m
[31m+         output.disconnect();[39m
[31m+         upmixIn.disconnect();[39m
[31m+         splitter.disconnect();[39m
[31m+         merger.disconnect();[39m
[31m+         delay.disconnect();[39m
[31m+         wet.disconnect();[39m
[31m+         dry.disconnect();[39m
[31m+         xf.disconnect();[39m
[31m+         fb.disconnect();[39m
[31m+       },[39m
[31m+     };[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Multiband Processor (3-band crossover gains) ---------------- */[39m
[31m+[39m
[31m+ const multiband: EffectDefinition = {[39m
[31m+   type: "multiband",[39m
[31m+   name: "Multiband",[39m
[31m+   category: "tone",[39m
[31m+   params: multibandParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     const mix = mixBus(ctx);[39m
[31m+     // Complementary 3-band crossover (unity-sum): low = LP(lowFreq, wet)[39m
[31m+     // midHigh = wet − low; mid = LP(highFreq, midHigh); high = midHigh − mid[39m
[31m+     // Each branch feeds a gain stage (−12..+12 dB), then a PARALLEL[39m
[31m+     // per-band compressor (COMP crossfades band → compressed band) and a[39m
[31m+     // SOLO gate (any solo active mutes the other bands).[39m
[31m+     const lowLP = ctx.createBiquadFilter();[39m
[31m+     lowLP.type = "lowpass";[39m
[31m+     const midLP = ctx.createBiquadFilter();[39m
[31m+     midLP.type = "lowpass";[39m
[31m+     const gLow = ctx.createGain();[39m
[31m+     const gMid = ctx.createGain();[39m
[31m+     const gHigh = ctx.createGain();[39m
[31m+     const invLow = ctx.createGain();[39m
[31m+     invLow.gain.value = -1;[39m
[31m+     const invMid = ctx.createGain();[39m
[31m+     invMid.gain.value = -1;[39m
[31m+     const midHighSum = ctx.createGain();[39m
[31m+     const highSum = ctx.createGain();[39m
[31m+[39m
[31m+     // Per-band parallel compressor + solo gate. COMP crossfades the band[39m
[31m+     // between dry and compressed; a solo active anywhere mutes the others.[39m
[31m+     const makeBand = (): {[39m
[31m+       input: GainNode;[39m
[31m+       setComp: (amount: number, when: number) => void;[39m
[31m+       setSolo: (soloed: boolean, when: number) => void;[39m
[31m+       output: GainNode;[39m
[31m+       dispose: () => void;[39m
[31m+     } => {[39m
[31m+       const input = ctx.createGain();[39m
[31m+       const dry = ctx.createGain();[39m
[31m+       const comp = ctx.createDynamicsCompressor();[39m
[31m+       comp.threshold.value = -24;[39m
[31m+       comp.ratio.value = 4;[39m
[31m+       comp.attack.value = 0.005;[39m
[31m+       comp.release.value = 0.2;[39m
[31m+       comp.knee.value = 12;[39m
[31m+       const compWet = ctx.createGain();[39m
[31m+       const solo = ctx.createGain();[39m
[31m+       const output = ctx.createGain();[39m
[31m+       input.connect(dry).connect(output);[39m
[31m+       input.connect(comp).connect(compWet).connect(output);[39m
[31m+       output.connect(solo);[39m
[31m+       const setComp = (amount: number, when: number): void => {[39m
[31m+         const a = Math.max(0, Math.min(1, amount));[39m
[31m+         compWet.gain.setTargetAtTime(a, when, 0.03);[39m
[31m+         dry.gain.setTargetAtTime(1 - a, when, 0.03);[39m
[31m+       };[39m
[31m+       const setSolo = (soloed: boolean, when: number): void => {[39m
[31m+         solo.gain.setTargetAtTime(soloed ? 1 : 0, when, 0.015);[39m
[31m+       };[39m
[31m+       const dispose = (): void => {[39m
[31m+         input.disconnect();[39m
[31m+         dry.disconnect();[39m
[31m+         comp.disconnect();[39m
[31m+         compWet.disconnect();[39m
[31m+         output.disconnect();[39m
[31m+         solo.disconnect();[39m
[31m+       };[39m
[31m+       return { input, setComp, setSolo, output, dispose };[39m
[31m+     };[39m
[31m+     const bandLow = makeBand();[39m
[31m+     const bandMid = makeBand();[39m
[31m+     const bandHigh = makeBand();[39m
[31m+     const soloFlags = (): [boolean, boolean, boolean] => [[39m
[31m+       Math.round(instance.params.soloLow ?? 0) >= 0.5,[39m
[31m+       Math.round(instance.params.soloMid ?? 0) >= 0.5,[39m
[31m+       Math.round(instance.params.soloHigh ?? 0) >= 0.5,[39m
[31m+     ];[39m
[31m+     const applySolos = (when: number): void => {[39m
[31m+       const [lo, mid, hi] = soloFlags();[39m
[31m+       const any = lo || mid || hi;[39m
[31m+       bandLow.setSolo(!any || lo, when);[39m
[31m+       bandMid.setSolo(!any || mid, when);[39m
[31m+       bandHigh.setSolo(!any || hi, when);[39m
[31m+     };[39m
[31m+[39m
[31m+     mix.wet.connect(lowLP);[39m
[31m+     lowLP.connect(gLow).connect(bandLow.input);[39m
[31m+     bandLow.output.connect(mix.output);[39m
[31m+     // wet − low → midHighSum[39m
[31m+     mix.wet.connect(midHighSum);[39m
[31m+     lowLP.connect(invLow).connect(midHighSum);[39m
[31m+     midHighSum.connect(midLP);[39m
[31m+     midLP.connect(gMid).connect(bandMid.input);[39m
[31m+     bandMid.output.connect(mix.output);[39m
[31m+     // midHighSum − mid → high branch[39m
[31m+     midHighSum.connect(highSum);[39m
[31m+     midLP.connect(invMid).connect(highSum);[39m
[31m+     highSum.connect(gHigh).connect(bandHigh.input);[39m
[31m+     bandHigh.output.connect(mix.output);[39m
[31m+[39m
[31m+     const apply = (id: string, v: number, when: number) => {[39m
[31m+       switch (id) {[39m
[31m+         case "lowFreq":[39m
[31m+           smooth(lowLP.frequency, v, when);[39m
[31m+           break;[39m
[31m+         case "highFreq":[39m
[31m+           smooth(midLP.frequency, v, when);[39m
[31m+           break;[39m
[31m+         case "lowGain":[39m
[31m+           smooth(gLow.gain, dbToLin(v), when);[39m
[31m+           break;[39m
[31m+         case "midGain":[39m
[31m+           smooth(gMid.gain, dbToLin(v), when);[39m
[31m+           break;[39m
[31m+         case "highGain":[39m
[31m+           smooth(gHigh.gain, dbToLin(v), when);[39m
[31m+           break;[39m
[31m+         case "comp":[39m
[31m+           bandLow.setComp(v, when);[39m
[31m+           bandMid.setComp(v, when);[39m
[31m+           bandHigh.setComp(v, when);[39m
[31m+           break;[39m
[31m+         case "soloLow":[39m
[31m+         case "soloMid":[39m
[31m+         case "soloHigh":[39m
[31m+           applySolos(when);[39m
[31m+           break;[39m
[31m+         case "mix":[39m
[31m+           mix.setMix(v, when);[39m
[31m+           break;[39m
[31m+       }[39m
[31m+     };[39m
[31m+     applySolos(ctx.currentTime);[39m
[31m+     for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+     return {[39m
[31m+       input: mix.input,[39m
[31m+       output: mix.output,[39m
[31m+       setParameter: (id, v) => apply(id, v, ctx.currentTime),[39m
[31m+       setParameterAt: (id, v, when) => apply(id, v, when),[39m
[31m+       getAudioParam: (paramId: string) => {[39m
[31m+         switch (paramId) {[39m
[31m+           case "lowFreq":[39m
[31m+             return lowLP.frequency;[39m
[31m+           case "highFreq":[39m
[31m+             return midLP.frequency;[39m
[31m+           case "lowGain":[39m
[31m+             return gLow.gain;[39m
[31m+           case "midGain":[39m
[31m+             return gMid.gain;[39m
[31m+           case "highGain":[39m
[31m+             return gHigh.gain;[39m
[31m+           case "mix":[39m
[31m+             return mix.wet.gain;[39m
[31m+           default:[39m
[31m+             return null;[39m
[31m+         }[39m
[31m+       },[39m
[31m+       dispose: () => {[39m
[31m+         mix.input.disconnect();[39m
[31m+         mix.output.disconnect();[39m
[31m+         lowLP.disconnect();[39m
[31m+         midLP.disconnect();[39m
[31m+         gLow.disconnect();[39m
[31m+         gMid.disconnect();[39m
[31m+         gHigh.disconnect();[39m
[31m+         invLow.disconnect();[39m
[31m+         invMid.disconnect();[39m
[31m+         midHighSum.disconnect();[39m
[31m+         highSum.disconnect();[39m
[31m+         bandLow.dispose();[39m
[31m+         bandMid.dispose();[39m
[31m+         bandHigh.dispose();[39m
[31m+       },[39m
[31m+     };[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Compressor ---------------- */[39m
[31m+[39m
[31m+ const compressor: EffectDefinition = {[39m
[31m+   type: "compressor",[39m
[31m+   name: "Compressor",[39m
[31m+   category: "dynamics",[39m
[31m+   params: compressorParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     if (isWorkletReady("compressor", ctx)) return createCompressorNode(ctx, instance);[39m
[31m+     // Native fallback: DynamicsCompressorNode approximation — no sidechain,[39m
[31m+     // no detector HPF, coarse GR. Degraded so the UI warns (never silent).[39m
[31m+     const mix = mixBus(ctx);[39m
[31m+     const comp = ctx.createDynamicsCompressor();[39m
[31m+     const makeup = ctx.createGain();[39m
[31m+     mix.wet.connect(comp).connect(makeup).connect(mix.output);[39m
[31m+     const apply = (id: string, v: number, when: number) => {[39m
[31m+       switch (id) {[39m
[31m+         case "threshold":[39m
[31m+           smooth(comp.threshold, v, when);[39m
[31m+           break;[39m
[31m+         case "ratio":[39m
[31m+           smooth(comp.ratio, v, when);[39m
[31m+           break;[39m
[31m+         case "attack":[39m
[31m+           smooth(comp.attack, v, when);[39m
[31m+           break;[39m
[31m+         case "release":[39m
[31m+           smooth(comp.release, v, when);[39m
[31m+           break;[39m
[31m+         case "knee":[39m
[31m+           smooth(comp.knee, v, when);[39m
[31m+           break;[39m
[31m+         case "makeup":[39m
[31m+           smooth(makeup.gain, dbToLin(v), when);[39m
[31m+           break;[39m
[31m+         case "mix":[39m
[31m+           mix.setMix(v, when);[39m
[31m+           break;[39m
[31m+         case "detector":[39m
[31m+         case "scHpf":[39m
[31m+           break; // no native equivalent — parameter stays stored[39m
[31m+       }[39m
[31m+     };[39m
[31m+     for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+     const reduction = () => {[39m
[31m+       const raw = (comp as unknown as { reduction?: number | { value: number } }).reduction;[39m
[31m+       const value =[39m
[31m+         typeof raw === "number" ? raw : typeof raw === "object" && raw && typeof raw.value === "number" ? raw.value : 0;[39m
[31m+       return Math.max(0, Number.isFinite(value) ? -value : 0);[39m
[31m+     };[39m
[31m+     return {[39m
[31m+       input: mix.input,[39m
[31m+       output: mix.output,[39m
[31m+       degraded: true,[39m
[31m+       degradedReason: "Fallback — native approximation (sidechain & HPF inactive)",[39m
[31m+       setParameter: (id, v) => apply(id, v, ctx.currentTime),[39m
[31m+       setParameterAt: (id, v, when) => apply(id, v, when),[39m
[31m+       setSidechainInput: () => undefined, // accepted, inactive on the fallback path[39m
[31m+       getGainReductionDb: reduction,[39m
[31m+       dispose: () => {[39m
[31m+         mix.input.disconnect();[39m
[31m+         mix.output.disconnect();[39m
[31m+         comp.disconnect();[39m
[31m+         makeup.disconnect();[39m
[31m+       },[39m
[31m+     };[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Saturation (character engine) ---------------- */[39m
[31m+[39m
[31m+ const saturation: EffectDefinition = {[39m
[31m+   type: "saturation",[39m
[31m+   name: "Saturation",[39m
[31m+   category: "character",[39m
[31m+   params: saturationParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     const mix = mixBus(ctx);[39m
[31m+     // Pre-HPF: band-limits what reaches the shaper so heavy bass doesn't[39m
[31m+     // intermodulate the whole spectrum (decapitator-style FOCUS).[39m
[31m+     const preHP = ctx.createBiquadFilter();[39m
[31m+     preHP.type = "highpass";[39m
[31m+     preHP.frequency.value = instance.params.preHpfHz ?? 20;[39m
[31m+     preHP.Q.value = 0.7;[39m
[31m+     const shaper = ctx.createWaveShaper();[39m
[31m+     shaper.oversample = "4x";[39m
[31m+     const tone = ctx.createBiquadFilter();[39m
[31m+     tone.type = "lowpass";[39m
[31m+     const out = ctx.createGain();[39m
