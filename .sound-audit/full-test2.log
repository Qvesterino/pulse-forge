[31m+         // collapsed the modulation into target.gain in one sample (audible[39m
[31m+         // jump) and left the pump dead until the new oscillator started at[39m
[31m+         // `when`. onended fires at the stop time; the replacement oscillator[39m
[31m+         // starts at the same `when`, so the handover is sample-continuous.[39m
[31m+         const old = osc;[39m
[31m+         try {[39m
[31m+           old.stop(when);[39m
[31m+         } catch {[39m
[31m+           /* not started */[39m
[31m+         }[39m
[31m+         old.onended = () => {[39m
[31m+           try {[39m
[31m+             old.disconnect();[39m
[31m+           } catch {[39m
[31m+             /* already gone */[39m
[31m+           }[39m
