[31m+     const splitter = ctx.createChannelSplitter(2);[39m
[31m+     const merger = ctx.createChannelMerger(2);[39m
[31m+[39m
[31m+     const connectStages = (): void => {[39m
[31m+       try {[39m
[31m+         mix.wet.disconnect();[39m
[31m+       } catch {[39m
[31m+         /* nothing */[39m
[31m+       }[39m
[31m+       try {[39m
[31m+         splitter.disconnect();[39m
[31m+       } catch {[39m
[31m+         /* nothing */[39m
[31m+       }[39m
[31m+       try {[39m
[31m+         merger.disconnect();[39m
[31m+       } catch {[39m
[31m+         /* nothing */[39m
[31m+       }[39m
[31m+       for (const chain of [stagesL, stagesR]) {[39m
[31m+         for (const stage of chain) {[39m
[31m+           try {[39m
[31m+             stage.disconnect();[39m
[31m+           } catch {[39m
[31m+             /* nothing */[39m
[31m+           }[39m
[31m+         }[39m
[31m+       }[39m
[31m+       try {[39m
[31m+         fbL.disconnect();[39m
[31m+         fbR.disconnect();[39m
[31m+         wetL.disconnect();[39m
[31m+         wetR.disconnect();[39m
[31m+       } catch {[39m
[31m+         /* nothing */[39m
[31m+       }[39m
