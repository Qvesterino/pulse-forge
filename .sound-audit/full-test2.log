[31m+     // Transparent bypass fallback — the TPT resonance character can't be[39m
[31m+     // faked by a BiquadFilterNode; a degraded approximation would be misleading.[39m
[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — SV filter bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Flanger ---------------- */[39m
[31m+ // Per-sample modulated delay with ZERO-DELAY feedback (worklet feeds back[39m
[31m+ // within the same sample, unlike native DelayNode loops which add one render[39m
[31m+ // quantum). Stereo spread via L/R LFO phase offset.[39m
[31m+[39m
[31m+ const flanger: EffectDefinition = {[39m
[31m+   type: "flanger",[39m
[31m+   name: "Flanger",[39m
[31m+   category: "movement",[39m
[31m+   params: flangerParams,[39m
