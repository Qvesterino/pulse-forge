[31m+         stagesR[stagesR.length - 1].connect(wetR).connect(merger, 0, 1);[39m
[31m+         stagesL[stagesL.length - 1].connect(fbL).connect(stagesL[0]);[39m
[31m+         stagesR[stagesR.length - 1].connect(fbR).connect(stagesR[0]);[39m
