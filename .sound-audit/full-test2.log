[31m+ }[39m
[31m+[39m
[31m+ /* ---------------- M/S EQ — mid/side encode, 2×2-band  ---------------- */[39m
[31m+[39m
[31m+ const msEq: EffectDefinition = {[39m
[31m+   type: "msEq",[39m
[31m+   name: "M/S EQ",[39m
[31m+   category: "tone",[39m
