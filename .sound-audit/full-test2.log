[31m+           applyCurve();[39m
[31m+           if (keyReleaseParam) keyReleaseParam.setTargetAtTime(releaseMsOf(v) / 1000, when, 0.05);[39m
[31m+           else if (smoothLp) smooth(smoothLp.frequency, releaseLpFreq(v), when, 0.05);[39m
[31m+           break;[39m
[31m+       }[39m
[31m+     };[39m
[31m+     for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+[39m
[31m+     return {[39m
[31m+       input,[39m
[31m+       output,[39m
[31m+       // The native key envelope is symmetric (no fast-attack stage) — flag[39m
[31m+       // it while a key is wired so the UI stays honest. Oscillator mode and[39m
[31m+       // the worklet follower never degrade.[39m
[31m+       get degraded() {[39m
[31m+         return keySource !== null && !useKeyFollower;[39m
[31m+       },[39m
[31m+       degradedReason: "Pump key on native envelope — attack follows release",[39m
[31m+       setParameter: (id, v) => apply(id, v, ctx.currentTime),[39m
[31m+       setParameterAt: (id, v, when) => apply(id, v, when),[39m
[31m+       syncBpm(next, when) {[39m
[31m+         bpm = next;[39m
[31m+         if (osc) smooth(osc.frequency, freqOf(), when ?? ctx.currentTime, 0.05);[39m
[31m+       },[39m
[31m+       onTransportStarted(time, beatPhase) {[39m
[31m+         if (keySource) return; // key owns the groove — no oscillator restart[39m
[31m+         const beatSec = 60 / bpm;[39m
[31m+         const nextBeat = time + (1 - beatPhase) * beatSec;[39m
[31m+         startOsc(nextBeat);[39m
[31m+       },[39m
[31m+       /**[39m
[31m+        * Real sidechain key (kick/buss track via the SOURCE picker). While a[39m
[31m+        * key is wired the oscillator stops and the kick's own envelope ducks[39m
[31m+        * the target; disconnecting falls back to the beat-synced oscillator.[39m
[31m+        */[39m
[31m+       setSidechainInput(source: AudioNode | null) {[39m
