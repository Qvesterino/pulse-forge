[31m+     // an honest badge.[39m
[31m+     if (isWorkletReady("fxeq", ctx)) {[39m
[31m+       return createFxEqNode(ctx, instance, FXEQ_PARAM_DEFAULTS, env?.seed);[39m
[31m+     }[39m
[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — PRISM bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Ultina (VocalForge plugin, vendored DSP oracle) ---------------- */[39m
[31m+ // Neutron-class modular mixing suite: EQ, Comp, Gate, Exciter, Transient,[39m
[31m+ // Clipper, Density, Sculptor, Phase, Unmask + LUFS/autogain. DSP runs in an[39m
[31m+ // AudioWorklet (vendored core is bit-exact with the VocalForge vectors —[39m
[31m+ // tests/ultina-vectors.test.ts). The rack exposes the global surface and[39m
[31m+ // quick module toggles; per-module editing lands with the Ultina panel.[39m
[31m+[39m
[31m+ const ultina: EffectDefinition = {[39m
[31m+   type: "ultina",[39m
[31m+   name: "VLYX",[39m
[31m+   category: "dynamics",[39m
[31m+   params: ultinaParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     if (isWorkletReady("ultina", ctx)) {[39m
[31m+       return createUltinaNode(ctx, instance, ULTINA_PARAM_DEFAULTS);[39m
