[31m+ /* ---------------- Reverb ---------------- */[39m
[31m+[39m
[31m+ function makeImpulseResponse(ctx: BaseAudioContext, decaySec: number, seed: number): AudioBuffer {[39m
[31m+   const length = Math.max(1, Math.floor(ctx.sampleRate * decaySec));[39m
[31m+   const buffer = ctx.createBuffer(2, length, ctx.sampleRate);[39m
[31m+   const rand = mulberry32(seed);[39m
[31m+   for (let ch = 0; ch < 2; ch++) {[39m
[31m+     const data = buffer.getChannelData(ch);[39m
[31m+     for (let i = 0; i < length; i++) {[39m
[31m+       data[i] = (rand() * 2 - 1) * Math.pow(1 - i / length, 2.4);[39m
[31m+     }[39m
[31m+   }[39m
[31m+   return buffer;[39m
[31m+ }[39m
