[31m+ /** Effects intentionally exposed in the new mixer Add Effect menu. */[39m
[31m+[39m
[31m+ /** Flagship plugin suites exposed alongside the core effects. */[39m
[31m+[39m
[31m+ /**[39m
[31m+  * Core effects grouped by their registry category for the Add Effect menu —[39m
[31m+  * one optgroup per category (Tone / Dynamics / Character / Movement / Space),[39m
[31m+  * order inside each group follows CORE_EFFECT_ORDER.[39m
[31m+  */[39m
[31m+ export const CORE_EFFECT_GROUP_ORDER = ["tone", "dynamics", "character", "movement", "space"] as const;[39m
[31m+ export type CoreEffectGroupKey = (typeof CORE_EFFECT_GROUP_ORDER)[number];[39m
[31m+ export const CORE_EFFECT_GROUP_LABELS: Record<CoreEffectGroupKey, string> = {[39m
[31m+   tone: "TONE",[39m
[31m+   dynamics: "DYNAMICS",[39m
[31m+   character: "CHARACTER",[39m
[31m+   movement: "MOVEMENT",[39m
[31m+   space: "SPACE",[39m
[31m+ };[39m
[31m+ export interface CoreEffectGroup {[39m
[31m+   key: CoreEffectGroupKey;[39m
[31m+   label: string;[39m
[31m+   types: EffectType[];[39m
[31m+ }[39m
[31m+ export const CORE_EFFECT_GROUPS: CoreEffectGroup[] = CORE_EFFECT_GROUP_ORDER.map((key) => ({[39m
[31m+   key,[39m
[31m+   label: CORE_EFFECT_GROUP_LABELS[key],[39m
[31m+   types: CORE_EFFECT_ORDER.filter((type) => EFFECT_DEFS[type].category === key),[39m
[31m+ }));[39m
[31m+[39m
[31m+ const DEVICE_MENU_EFFECTS = new Set<EffectType>([...CORE_EFFECT_ORDER, ...FLAGSHIP_EFFECT_ORDER]);[39m
[31m+ export const ADDITIONAL_EFFECT_GROUPS: CoreEffectGroup[] = CORE_EFFECT_GROUP_ORDER.map((key) => ({[39m
[31m+   key,[39m
[31m+   label: `MORE ${CORE_EFFECT_GROUP_LABELS[key]}`,[39m
[31m+   types: EFFECT_ORDER.filter((type) => !DEVICE_MENU_EFFECTS.has(type) && EFFECT_DEFS[type].category === key),[39m
[31m+ })).filter((group) => group.types.length > 0);[39m
[31m+[39m
[31m+ /**[39m
[31m+  * Validate the FULL parameter map of a flagship plugin effect (ultina/fxeq/[39m
[31m+  * ozvena) from persisted state. These plugins expose deep, namespaced[39m
[31m+  * parameters ("eq.band3.gainDb", "band2.satDriveDb", "engines.e1.mix"…)[39m
[31m+  * authored by their panels, far beyond the registry's rack param list —[39m
[31m+  * `normalizeEffects` must not silently strip them on project load or every[39m
[31m+  * saved plugin mix resets itself.[39m
[31m+  *[39m
[31m+  * Returns the complete validated param map (rack defaults + deep params),[39m
[31m+  * or null for effect types without a plugin-deep surface (caller falls back[39m
[31m+  * to rack-default retention). Unknown ids are dropped; every retained value[39m
[31m+  * is finite; ultina/fxeq values are clamped to their authoritative DSP[39m
[31m+  * schemas, ozvena values are validated at the worklet's setPath boundary.[39m
