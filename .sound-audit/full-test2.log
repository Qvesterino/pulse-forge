[31m+     for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+     return {[39m
[31m+       input: mix.input,[39m
[31m+       output,[39m
[31m+       setParameter: (id, v) => apply(id, v, ctx.currentTime),[39m
[31m+       setParameterAt: (id, v, when) => apply(id, v, when),[39m
[31m+       dispose: () => {[39m
[31m+         mix.input.disconnect();[39m
[31m+         mix.output.disconnect();[39m
[31m+         pre.disconnect();[39m
[31m+         shaper.disconnect();[39m
[31m+         post.disconnect();[39m
[31m+         ceilingGuard.disconnect();[39m
