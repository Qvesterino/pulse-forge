[31m+   lfo1.start();[39m
[31m+   const lfo2 = ctx.createOscillator();[39m
[31m+   lfo2.type = "sine";[39m
[31m+   lfo2.frequency.value = 0.9;[39m
[31m+   const lfo2Depth = ctx.createGain();[39m
[31m+   lfo2Depth.gain.value = 0.005;[39m
[31m+   lfo2.connect(lfo2Depth).connect(delay2.delayTime);[39m
[31m+   lfo2.start();[39m
[31m+   const d1Mix = ctx.createGain();[39m
[31m+   d1Mix.gain.value = 0.5;[39m
[31m+   const d2Mix = ctx.createGain();[39m
[31m+   d2Mix.gain.value = 0.5;[39m
[31m+   mix.wet.connect(delay1).connect(d1Mix).connect(mix.output);[39m
[31m+   mix.wet.connect(delay2).connect(d2Mix).connect(mix.output);[39m
[31m+   const out = ctx.createGain();[39m
[31m+   mix.output.connect(out);[39m
[31m+[39m
[31m+   const apply = (id: string, v: number, when: number) => {[39m
[31m+     switch (id) {[39m
[31m+       case "rate": {[39m
[31m+         lfo1.frequency.setTargetAtTime(v, when, 0.05);[39m
[31m+         // Second LFO is offset for richer movement[39m
[31m+         lfo2.frequency.setTargetAtTime(v * 1.4, when, 0.05);[39m
[31m+         break;[39m
[31m+       }[39m
[31m+       case "depth": {[39m
[31m+         const d = 0.001 + v * 0.008;[39m
[31m+         lfo1Depth.gain.setTargetAtTime(d, when, 0.05);[39m
[31m+         lfo2Depth.gain.setTargetAtTime(d * 1.25, when, 0.05);[39m
[31m+         break;[39m
[31m+       }[39m
[31m+       case "mix":[39m
[31m+         mix.setMix(v, when);[39m
[31m+         break;[39m
[31m+       case "output":[39m
[31m+         smooth(out.gain, dbToLin(v), when);[39m
[31m+         break;[39m
[31m+       case "spread":[39m
[31m+         break; // worklet-only — no native equivalent, parameter stays stored[39m
[31m+     }[39m
[31m+   };[39m
[31m+   for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+   return {[39m
[31m+     input: mix.input,[39m
[31m+     output: out,[39m
[31m+     degraded: true,[39m
[31m+     degradedReason: "AudioWorklet unavailable — Chorus on legacy native graph",[39m
[31m+     setParameter: (id, v) => apply(id, v, ctx.currentTime),[39m
[31m+     setParameterAt: (id, v, when) => apply(id, v, when),[39m
[31m+     syncBpm(bpm, when) {[39m
[31m+       // Snap the LFO to 1/4-beat rate (musical default for chorus motion).[39m
[31m+       // `when` (offline scene lanes) schedules the snap at the window start.[39m
[31m+       const at = when ?? ctx.currentTime;[39m
[31m+       const beatHz = bpm / 60 / 4;[39m
[31m+       lfo1.frequency.setTargetAtTime(beatHz, at, 0.05);[39m
[31m+       lfo2.frequency.setTargetAtTime(beatHz * 1.4, at, 0.05);[39m
[31m+     },[39m
[31m+     dispose: () => {[39m
[31m+       try {[39m
[31m+         lfo1.stop();[39m
[31m+       } catch {[39m
[31m+         /* not started */[39m
[31m+       }[39m
[31m+       try {[39m
[31m+         lfo2.stop();[39m
[31m+       } catch {[39m
[31m+         /* not started */[39m
[31m+       }[39m
[31m+       lfo1.disconnect();[39m
[31m+       lfo2.disconnect();[39m
[31m+       lfo1Depth.disconnect();[39m
[31m+       lfo2Depth.disconnect();[39m
[31m+       delay1.disconnect();[39m
[31m+       delay2.disconnect();[39m
[31m+       d1Mix.disconnect();[39m
[31m+       d2Mix.disconnect();[39m
[31m+       mix.input.disconnect();[39m
[31m+       mix.output.disconnect();[39m
[31m+       out.disconnect();[39m
[31m+     },[39m
[31m+   };[39m
[31m+ }[39m
[31m+[39m
[31m+ const chorus: EffectDefinition = {[39m
[31m+   type: "chorus",[39m
[31m+   name: "Chorus",[39m
[31m+   category: "movement",[39m
[31m+   params: chorusParams,[39m
[31m+   factory(ctx, instance, env) {[39m
[31m+     if (isWorkletReady("chorus", ctx)) return createChorusNode(ctx, instance, env.bpm);[39m
[31m+     return chorusNativeFallback(ctx, instance);[39m
[31m+   },[39m
[31m+ };[39m
