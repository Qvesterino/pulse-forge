[31m+     sideHigh.connect(gRside);[39m
[31m+     gLmid.connect(mergerOut, 0, 0);[39m
[31m+     gLside.connect(mergerOut, 0, 0);[39m
[31m+     gRmid.connect(mergerOut, 0, 1);[39m
[31m+     gRside.connect(mergerOut, 0, 1);[39m
[31m+     mergerOut.connect(output);[39m
[31m+[39m
[31m+     const apply = (id: string, v: number, when: number) => {[39m
