[31m+ /* ---------------- Clipper ---------------- */[39m
[31m+[39m
[31m+ const clipper: EffectDefinition = {[39m
[31m+   type: "clipper",[39m
[31m+   name: "Clipper",[39m
[31m+   category: "character",[39m
[31m+   params: clipperParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     // Parallel topology via mixBus: MIX < 100 blends the CLEAN path back in[39m
[31m+     // (the classic "parallel clipper" — transient snap without the crushed[39m
[31m+     // body). The dry reference is pre-drive, so DRIVE does not change the[39m
[31m+     // blended level.[39m
[31m+     const mix = mixBus(ctx);[39m
