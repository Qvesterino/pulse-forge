[31m+     mix.output.connect(ceilingGuard).connect(output);[39m
[31m+     let ceiling = instance.params.ceiling ?? -1;[39m
[31m+     let softness = instance.params.softness ?? 0.2;[39m
[31m+     const curveOf = () => {[39m
[31m+       const c = dbToLin(ceiling);[39m
[31m+       const n = 2048;[39m
[31m+       const curve = new Float32Array(new ArrayBuffer(n * 4));[39m
[31m+       for (let i = 0; i < n; i++) {[39m
[31m+         const u = (i / (n - 1)) * 2 - 1;[39m
[31m+         let shaped: number;[39m
[31m+         if (softness < 0.02) {[39m
