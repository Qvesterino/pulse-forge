[31m+     switch (id) {[39m
[31m+       case "hpFreq":[39m
[31m+         smooth(hp.frequency, v, when);[39m
[31m+         break;[39m
[31m+       case "lpFreq":[39m
[31m+         smooth(lp.frequency, v, when);[39m
[31m+         break;[39m
[31m+       case "lowShelfGain":[39m
[31m+         smooth(low.gain, v, when);[39m
[31m+         break;[39m
[31m+       case "lowShelfFreq":[39m
[31m+         smooth(low.frequency, v, when);[39m
[31m+         break;[39m
[31m+       case "lowMidGain":[39m
[31m+         smooth(lowMid.gain, v, when);[39m
[31m+         break;[39m
[31m+       case "lowMidFreq":[39m
[31m+         smooth(lowMid.frequency, v, when);[39m
[31m+         break;[39m
[31m+       case "lowMidQ":[39m
[31m+         smooth(lowMid.Q, v, when);[39m
[31m+         break;[39m
[31m+       case "highMidGain":[39m
[31m+         smooth(highMid.gain, v, when);[39m
[31m+         break;[39m
[31m+       case "highMidFreq":[39m
[31m+         smooth(highMid.frequency, v, when);[39m
[31m+         break;[39m
[31m+       case "highMidQ":[39m
[31m+         smooth(highMid.Q, v, when);[39m
[31m+         break;[39m
[31m+       case "highShelfGain":[39m
[31m+         smooth(high.gain, v, when);[39m
[31m+         break;[39m
[31m+       case "highShelfFreq":[39m
[31m+         smooth(high.frequency, v, when);[39m
[31m+         break;[39m
[31m+       case "lowGain":[39m
[31m+         if (instance.params.lowShelfGain === undefined) smooth(low.gain, v, when);[39m
[31m+         break;[39m
[31m+       case "lowFreq":[39m
[31m+         if (instance.params.lowShelfFreq === undefined) smooth(low.frequency, v, when);[39m
[31m+         break;[39m
[31m+       case "midGain":[39m
[31m+         if (instance.params.lowMidGain === undefined) smooth(lowMid.gain, v, when);[39m
[31m+         break;[39m
[31m+       case "midFreq":[39m
[31m+         if (instance.params.lowMidFreq === undefined) smooth(lowMid.frequency, v, when);[39m
[31m+         break;[39m
[31m+       case "midQ":[39m
[31m+         if (instance.params.lowMidQ === undefined) smooth(lowMid.Q, v, when);[39m
[31m+         break;[39m
[31m+       case "highGain":[39m
[31m+         if (instance.params.highShelfGain === undefined) smooth(high.gain, v, when);[39m
[31m+         break;[39m
[31m+       case "highFreq":[39m
