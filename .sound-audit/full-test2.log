[31m+         case "lpFreq":[39m
[31m+           return lp.frequency;[39m
[31m+         case "lowShelfFreq":[39m
[31m+         case "lowFreq":[39m
[31m+           return low.frequency;[39m
[31m+         case "lowShelfGain":[39m
[31m+         case "lowGain":[39m
[31m+           return low.gain;[39m
[31m+         case "lowMidFreq":[39m
[31m+         case "midFreq":[39m
[31m+           return lowMid.frequency;[39m
[31m+         case "lowMidGain":[39m
[31m+         case "midGain":[39m
[31m+           return lowMid.gain;[39m
[31m+         case "lowMidQ":[39m
[31m+         case "midQ":[39m
[31m+           return lowMid.Q;[39m
[31m+         case "highMidFreq":[39m
[31m+           return highMid.frequency;[39m
[31m+         case "highMidGain":[39m
[31m+           return highMid.gain;[39m
[31m+         case "highMidQ":[39m
[31m+           return highMid.Q;[39m
[31m+         case "highShelfFreq":[39m
[31m+         case "highFreq":[39m
