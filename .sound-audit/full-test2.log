[31m+ interface MixBus {[39m
[31m+   input: GainNode;[39m
[31m+   output: GainNode;[39m
[31m+   wet: GainNode;[39m
[31m+   setMix(m: number, when: number): void;[39m
[31m+ }[39m
[31m+[39m
[31m+ function mixBus(ctx: BaseAudioContext): MixBus {[39m
[31m+   const input = ctx.createGain();[39m
[31m+   const output = ctx.createGain();[39m
[31m+   const dry = ctx.createGain();[39m
[31m+   const wet = ctx.createGain();[39m
[31m+   // Wet starts SILENT. Factories replay instance params through setMix on[39m
[31m+   // construction, which smooths (setTargetAtTime); starting wet at 1 meant a[39m
[31m+   // full-wet effect briefly summed dry+wet (~+6 dB decaying over ~60 ms) on[39m
[31m+   // every insertion and every rack rebuild. From dry-only, the init smoothing[39m
[31m+   // is a short crossfade into the saved mix instead.[39m
[31m+   dry.gain.value = 1;[39m
[31m+   wet.gain.value = 0;[39m
[31m+   input.connect(dry).connect(output);[39m
[31m+   input.connect(wet);[39m
[31m+   const setMix = (m: number, when: number) => {[39m
[31m+     smooth(wet.gain, m, when);[39m
[31m+     smooth(dry.gain, 1 - m, when);[39m
[31m+   };[39m
[31m+   return { input, output, wet, setMix };[39m
[31m+ }[39m
