[31m+ /* ---------------- Core dynamics and utility ---------------- */[39m
[31m+[39m
[31m+ function createWorkletRuntime([39m
[31m+   ctx: BaseAudioContext,[39m
[31m+   instance: EffectInstance,[39m
[31m+   processor: "transient-processor" | "gate-processor",[39m
[31m+   readyType: "transient" | "gate",[39m
[31m+ ): EffectRuntime | null {[39m
[31m+   if (!isWorkletReady(readyType, ctx)) return null;[39m
[31m+   const node = new AudioWorkletNode(ctx, processor, {[39m
[31m+     numberOfInputs: 1,[39m
[31m+     numberOfOutputs: 1,[39m
[31m+     outputChannelCount: [2],[39m
[31m+     channelCount: 2,[39m
[31m+   });[39m
[31m+   attachProcessorErrorGuard(node, processor);[39m
[31m+   const input = ctx.createGain();[39m
[31m+   const output = ctx.createGain();[39m
[31m+   input.connect(node).connect(output);[39m
[31m+   // The gate reports its look-ahead delay once at construction (transient[39m
[31m+   // never posts) — surface it so the engine's PDC keeps tracks aligned.[39m
[31m+   let latencySamples = 0;[39m
[31m+   const latencyListeners = new Set<() => void>();[39m
[31m+   node.port.onmessage = (event: MessageEvent<{ type?: string; samples?: number }>) => {[39m
[31m+     const msg = event.data;[39m
[31m+     if (msg?.type === "latency" && typeof msg.samples === "number") {[39m
[31m+       latencySamples = msg.samples;[39m
[31m+       for (const listener of latencyListeners) listener();[39m
[31m+     }[39m
[31m+   };[39m
[31m+   const apply = (id: string, value: number, when: number) => {[39m
[31m+     const param = node.parameters.get(id);[39m
[31m+     if (param) param.setValueAtTime(value, when);[39m
[31m+   };[39m
[31m+   for (const [id, value] of Object.entries(instance.params)) apply(id, value, ctx.currentTime);[39m
[31m+   return {[39m
[31m+     input,[39m
[31m+     output,[39m
[31m+     getLatencySec: () => latencySamples / ctx.sampleRate,[39m
[31m+     onLatencyChange(listener: () => void) {[39m
[31m+       latencyListeners.add(listener);[39m
[31m+       return () => {[39m
[31m+         latencyListeners.delete(listener);[39m
[31m+       };[39m
[31m+     },[39m
[31m+     setParameter: (id, value) => apply(id, value, ctx.currentTime),[39m
[31m+     setParameterAt: apply,[39m
[31m+     dispose: () => {[39m
[31m+       node.port.onmessage = null;[39m
[31m+       node.disconnect();[39m
[31m+       input.disconnect();[39m
[31m+       output.disconnect();[39m
[31m+     },[39m
[31m+   };[39m
[31m+ }[39m
[31m+[39m
[31m+ const transient: EffectDefinition = {[39m
[31m+   type: "transient",[39m
[31m+   name: "Transient Shaper",[39m
[31m+   category: "dynamics",[39m
[31m+   params: transientParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     const worklet = createWorkletRuntime(ctx, instance, "transient-processor", "transient");[39m
[31m+     if (worklet) return worklet;[39m
[31m+     // Transparent 1:1 bypass when AudioWorklet is unavailable — never silence,[39m
[31m+     // always flagged so the UI can warn (see effectProcessorStatus).[39m
[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — transient shaper bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ const gate: EffectDefinition = {[39m
[31m+   type: "gate",[39m
[31m+   name: "Gate",[39m
[31m+   category: "dynamics",[39m
[31m+   params: gateParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     const worklet = createWorkletRuntime(ctx, instance, "gate-processor", "gate");[39m
[31m+     if (worklet) return worklet;[39m
[31m+     // Transparent 1:1 bypass fallback — the gate never silently stops gating[39m
[31m+     // without the UI knowing (degraded flag → warning badge).[39m
[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — gate bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Shimmer / Chime Exciter (universal instrument modifier) ---------------- */[39m
[31m+ // Universal "plugin" modifier for any instrument: HP exciter + shimmer tail.[39m
[31m+ // Use as track effect on any instrument bus — adds icy brightness without new kind.[39m
[31m+[39m
[31m+ const shimmer: EffectDefinition = {[39m
[31m+   type: "shimmer",[39m
[31m+   name: "Shimmer",[39m
[31m+   category: "character",[39m
[31m+   params: shimmerParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     const mix = mixBus(ctx);[39m
[31m+     const hp = ctx.createBiquadFilter();[39m
[31m+     hp.type = "highpass";[39m
[31m+     hp.frequency.value = 2200 + (instance.params.tone ?? 0.5) * 7800;[39m
[31m+     hp.Q.value = 0.7;[39m
[31m+     const shaper = ctx.createWaveShaper();[39m
[31m+     shaper.oversample = "4x";[39m
[31m+     const buildCurve = (drive: number) => {[39m
[31m+       const k = 1 + drive * 10;[39m
[31m+       const n = 1024;[39m
[31m+       const c = new Float32Array(new ArrayBuffer(n * 4));[39m
[31m+       for (let i = 0; i < n; i++) {[39m
[31m+         const x = (i / (n - 1)) * 2 - 1;[39m
[31m+         c[i] = Math.tanh(x * k) * (1 - drive * 0.15) + x * drive * 0.15;[39m
[31m+       }[39m
[31m+       return c;[39m
[31m+     };[39m
[31m+     shaper.curve = buildCurve(instance.params.amount ?? 0.35);[39m
[31m+     const exciteGain = ctx.createGain();[39m
[31m+     exciteGain.gain.value = 0.7 + (instance.params.amount ?? 0.35) * 0.6;[39m
[31m+     const delay = ctx.createDelay(1);[39m
[31m+     delay.delayTime.value = 0.11;[39m
[31m+     const fb = ctx.createGain();[39m
[31m+     fb.gain.value = (instance.params.decay ?? 0.35) * 0.55;[39m
[31m+     const lp = ctx.createBiquadFilter();[39m
[31m+     lp.type = "lowpass";[39m
[31m+     lp.frequency.value = 5200 + (instance.params.tone ?? 0.5) * 3000;[39m
[31m+     // Pitch-shifted shimmer voice: a +12 (default) copy of the exciter feeds[39m
[31m+     // the delay loop, so the SHIFTED tail recirculates — the defining[39m
[31m+     // shimmer sound. Reuses the always-loaded pitchshift worklet (COLA[39m
[31m+     // granular engine); without the worklet the effect degrades to the[39m
[31m+     // plain exciter+tail, never to silence.[39m
[31m+     let shiftNode: ReturnType<typeof createPitchShiftNode> | null = null;[39m
[31m+     const shimmerGain = ctx.createGain();[39m
[31m+     shimmerGain.gain.value = instance.params.shimmer ?? 0.6;[39m
[31m+     if (isWorkletReady("pitchShift", ctx)) {[39m
[31m+       shiftNode = createPitchShiftNode(ctx, {[39m
[31m+         id: instance.id ? `${instance.id}:shimmer` : "shimmer-voice",[39m
[31m+         params: {[39m
[31m+           semitones: instance.params.shift ?? 12,[39m
[31m+           grainMs: 45,[39m
[31m+           width: 0.4,[39m
[31m+           mix: 1,[39m
[31m+         },[39m
[31m+       });[39m
[31m+       exciteGain.connect(shiftNode.input);[39m
[31m+       shiftNode.output.connect(shimmerGain).connect(delay);[39m
[31m+     }[39m
[31m+     // Chain: wet -> hp -> shaper -> exciteGain -> delay -> lp -> feedback -> delay loop[39m
[31m+     // Wet tap to output: lp feeds back to mix output via wet path[39m
[31m+     mix.wet.connect(hp).connect(shaper).connect(exciteGain).connect(delay);[39m
[31m+     delay.connect(lp).connect(fb).connect(delay);[39m
[31m+     // shimmer tail + direct exciter both feed wet path's output[39m
[31m+     // mixBus: wet node will be summed to output via its internal dry/wet gains — we wire lp to mix output via wet[39m
[31m+     lp.connect(mix.output);[39m
[31m+     exciteGain.connect(mix.output);[39m
[31m+     mix.setMix(instance.params.mix ?? 0.4, ctx.currentTime);[39m
[31m+[39m
[31m+     return {[39m
[31m+       input: mix.input,[39m
[31m+       output: mix.output,[39m
[31m+       setParameter(id: string, value: number) {[39m
[31m+         switch (id) {[39m
[31m+           case "amount":[39m
[31m+             shaper.curve = buildCurve(value);[39m
[31m+             exciteGain.gain.setTargetAtTime(0.7 + value * 0.6, ctx.currentTime, 0.02);[39m
[31m+             break;[39m
[31m+           case "tone":[39m
[31m+             hp.frequency.setTargetAtTime(2200 + value * 7800, ctx.currentTime, 0.02);[39m
[31m+             lp.frequency.setTargetAtTime(5200 + value * 3000, ctx.currentTime, 0.02);[39m
[31m+             break;[39m
[31m+           case "decay":[39m
[31m+             fb.gain.setTargetAtTime(value * 0.55, ctx.currentTime, 0.02);[39m
[31m+             break;[39m
[31m+           case "shift":[39m
[31m+             shiftNode?.setParameter("semitones", value);[39m
[31m+             break;[39m
[31m+           case "shimmer":[39m
[31m+             shimmerGain.gain.setTargetAtTime(value, ctx.currentTime, 0.03);[39m
[31m+             break;[39m
[31m+           case "mix":[39m
[31m+             mix.setMix(value, ctx.currentTime);[39m
[31m+             break;[39m
[31m+         }[39m
[31m+       },[39m
[31m+       setParameterAt(id: string, value: number, when: number) {[39m
[31m+         switch (id) {[39m
[31m+           case "amount":[39m
[31m+             shaper.curve = buildCurve(value);[39m
[31m+             exciteGain.gain.setValueAtTime(0.7 + value * 0.6, when);[39m
[31m+             break;[39m
[31m+           case "tone":[39m
[31m+             hp.frequency.setValueAtTime(2200 + value * 7800, when);[39m
[31m+             lp.frequency.setValueAtTime(5200 + value * 3000, when);[39m
[31m+             break;[39m
[31m+           case "decay":[39m
[31m+             fb.gain.setValueAtTime(value * 0.55, when);[39m
[31m+             break;[39m
[31m+           case "shift":[39m
[31m+             shiftNode?.setParameterAt?.("semitones", value, when);[39m
[31m+             break;[39m
[31m+           case "shimmer":[39m
[31m+             shimmerGain.gain.setValueAtTime(value, when);[39m
[31m+             break;[39m
[31m+           case "mix":[39m
[31m+             mix.setMix(value, when);[39m
[31m+             break;[39m
[31m+         }[39m
[31m+       },[39m
[31m+       dispose() {[39m
[31m+         try {[39m
[31m+           mix.input.disconnect();[39m
[31m+         } catch {}[39m
[31m+         try {[39m
[31m+           mix.output.disconnect();[39m
[31m+         } catch {}[39m
[31m+         try {[39m
[31m+           hp.disconnect();[39m
[31m+         } catch {}[39m
[31m+         try {[39m
[31m+           shaper.disconnect();[39m
[31m+         } catch {}[39m
[31m+         try {[39m
[31m+           delay.disconnect();[39m
[31m+         } catch {}[39m
[31m+         // The delay→lp→fb→delay feedback loop and the exciter feed must also[39m
[31m+         // be severed — every other factory releases its full subgraph.[39m
[31m+         try {[39m
[31m+           lp.disconnect();[39m
[31m+         } catch {}[39m
[31m+         try {[39m
[31m+           fb.disconnect();[39m
[31m+         } catch {}[39m
[31m+         try {[39m
[31m+           exciteGain.disconnect();[39m
[31m+         } catch {}[39m
[31m+         try {[39m
[31m+           shimmerGain.disconnect();[39m
[31m+         } catch {}[39m
[31m+         try {[39m
[31m+           shiftNode?.dispose();[39m
[31m+         } catch {}[39m
[31m+       },[39m
[31m+     };[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- FXEQ Multiband (VocalForge plugin, vendored DSP oracle) ---------------- */[39m
[31m+ // Multiband crossover (2-6 bands, LR4) feeding per-band Sat/LoFi/Mod/Delay/Rev[39m
[31m+ // chains with a final limiter. DSP runs in an AudioWorklet (vendored core is[39m
[31m+ // bit-exact with the VocalForge golden fixtures — tests/fxeq-golden.test.ts).[39m
[31m+ // The rack exposes the top-level surface; per-band editing lands with the[39m
[31m+ // EQ-paint panel.[39m
[31m+[39m
[31m+ const fxeq: EffectDefinition = {[39m
[31m+   type: "fxeq",[39m
[31m+   name: "PRISM",[39m
[31m+   category: "character",[39m
[31m+   params: fxeqParams,[39m
[31m+   factory(ctx, instance, env) {[39m
[31m+     // Worklet DSP when the module loaded for THIS context (offline renders[39m
[31m+     // load it too); transparent degraded bypass otherwise — fxeq has no[39m
