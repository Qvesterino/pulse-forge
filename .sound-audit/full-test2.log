[31m+       return stages;[39m
[31m+     };[39m
[31m+[39m
[31m+     let stageCount =[39m
[31m+       PHASER_STAGE_COUNTS[[39m
[31m+         Math.max(0, Math.min(PHASER_STAGE_COUNTS.length - 1, Math.round(instance.params.stages ?? 1)))[39m
[31m+       ];[39m
[31m+     let stagesL = buildStages(stageCount);[39m
[31m+     let stagesR = buildStages(stageCount);[39m
[31m+[39m
[31m+     let centerHz = instance.params.center ?? 800;[39m
[31m+     let spreadVal = instance.params.spread ?? 0.5;[39m
[31m+     let rateHz = instance.params.rate ?? 0.4;[39m
[31m+[39m
[31m+     const oscL = ctx.createOscillator();[39m
[31m+     oscL.type = "sine";[39m
[31m+     oscL.frequency.value = rateHz;[39m
[31m+     const oscR = ctx.createOscillator();[39m
[31m+     oscR.type = "sine";[39m
[31m+     oscR.frequency.value = rateHz * (1 + 0.03 * spreadVal);[39m
