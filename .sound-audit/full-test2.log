[31m+ const stutter: EffectDefinition = {[39m
[31m+   type: "stutter",[39m
[31m+   name: "Stutter",[39m
[31m+   category: "movement",[39m
[31m+   params: stutterParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     if (isWorkletReady("stutter", ctx)) {[39m
