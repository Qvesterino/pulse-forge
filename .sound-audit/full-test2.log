[31m+       rect.oversample = "none"; // control-rate envelope, not audio[39m
[31m+       rect.curve = (() => {[39m
[31m+         const n = 1024;[39m
[31m+         const curve = new Float32Array(new ArrayBuffer(n * 4));[39m
[31m+         for (let i = 0; i < n; i++) curve[i] = Math.abs((i / (n - 1)) * 2 - 1);[39m
