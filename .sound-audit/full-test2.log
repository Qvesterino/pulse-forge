[31m+ // Ducks the main signal's gain based on the envelope of a separate audio source.[39m
[31m+ // Web Audio's DynamicsCompressorNode has no sidechain input, and ScriptProcessorNode[39m
[31m+ // is unreliable in OfflineAudioContext (which is what offline render + our[39m
[31m+ // browser-checks use). So we route the sidechain source through an AnalyserNode[39m
[31m+ // and run a JS-side envelope follower that writes `target.gain` via[39m
[31m+ // `setTargetAtTime`. This works in both realtime and offline contexts; the[39m
[31m+ // analysis is main-thread, not audio-rate, so ducking granularity is bounded[39m
[31m+ // by the JS timer — fine for musical sidechain but not for sub-10 ms precision.[39m
[31m+[39m
[31m+ const SIDE_UPDATE_MS = 10; // envelope refresh interval[39m
[31m+[39m
[31m+ const sidechain: EffectDefinition = {[39m
[31m+   type: "sidechain",[39m
[31m+   name: "Sidechain",[39m
[31m+   category: "dynamics",[39m
[31m+   params: sidechainParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     // Use AudioWorklet when modules are loaded for THIS context (audio-rate[39m
[31m+     // envelope, offline-safe)[39m
[31m+     if (isWorkletReady("sidechain", ctx)) {[39m
[31m+       return createSidechainNode(ctx, instance);[39m
[31m+     }[39m
[31m+     // Fallback: old setInterval + AnalyserNode implementation[39m
[31m+     const input = ctx.createGain();[39m
[31m+     const output = ctx.createGain();[39m
[31m+     const target = ctx.createGain();[39m
[31m+     target.gain.value = 1;[39m
[31m+     input.connect(target).connect(output);[39m
[31m+[39m
[31m+     const analyser = ctx.createAnalyser();[39m
[31m+     analyser.fftSize = 1024;[39m
[31m+     analyser.smoothingTimeConstant = 0;[39m
[31m+     const analyserBuf = new Float32Array(analyser.fftSize);[39m
[31m+[39m
[31m+     let env = 0;[39m
[31m+     let thresholdLin = Math.pow(10, -18 / 20);[39m
[31m+     let ratio = 4;[39m
[31m+     let amount = 1;[39m
[31m+     let attackCoef = Math.exp(-1 / (ctx.sampleRate * 0.005));[39m
[31m+     let releaseCoef = Math.exp(-1 / (ctx.sampleRate * 0.2));[39m
[31m+     let sidechainNode: AudioNode | null = null;[39m
[31m+     let active = true;[39m
[31m+     let interval: ReturnType<typeof setInterval> | null = null;[39m
[31m+[39m
[31m+     const computeTargetGain = (): number => {[39m
[31m+       if (sidechainNode === null) return 1;[39m
[31m+       // Read current peak from the analyser buffer.[39m
[31m+       analyser.getFloatTimeDomainData(analyserBuf);[39m
[31m+       let peak = 0;[39m
[31m+       for (let i = 0; i < analyserBuf.length; i++) {[39m
[31m+         const v = Math.abs(analyserBuf[i]);[39m
[31m+         if (v > peak) peak = v;[39m
[31m+       }[39m
[31m+       // Asymmetric envelope follower[39m
[31m+       env = peak > env ? attackCoef * env + (1 - attackCoef) * peak : releaseCoef * env + (1 - releaseCoef) * peak;[39m
[31m+       const envDb = 20 * Math.log10(Math.max(env, 1e-7));[39m
[31m+       const threshDb = 20 * Math.log10(Math.max(thresholdLin, 1e-7));[39m
[31m+       const overDb = Math.max(0, envDb - threshDb);[39m
[31m+       const reductionDb = overDb * (1 - 1 / Math.max(1, ratio));[39m
[31m+       const reduction = Math.pow(10, -reductionDb / 20);[39m
[31m+       return Math.max(0, 1 - amount * (1 - reduction));[39m
[31m+     };[39m
[31m+[39m
[31m+     const tick = () => {[39m
[31m+       if (!active) return;[39m
[31m+       const g = computeTargetGain();[39m
[31m+       target.gain.setTargetAtTime(g, ctx.currentTime, 0.005);[39m
[31m+     };[39m
[31m+     if (typeof setInterval === "function") {[39m
[31m+       interval = setInterval(tick, SIDE_UPDATE_MS);[39m
[31m+     }[39m
[31m+[39m
[31m+     const apply = (id: string, v: number, _when: number) => {[39m
[31m+       switch (id) {[39m
[31m+         case "threshold":[39m
[31m+           thresholdLin = Math.pow(10, v / 20);[39m
[31m+           break;[39m
[31m+         case "ratio":[39m
[31m+           ratio = v;[39m
[31m+           break;[39m
[31m+         case "attack":[39m
[31m+           attackCoef = Math.exp(-1 / (ctx.sampleRate * Math.max(0.001, v)));[39m
[31m+           break;[39m
[31m+         case "release":[39m
[31m+           releaseCoef = Math.exp(-1 / (ctx.sampleRate * Math.max(0.001, v)));[39m
[31m+           break;[39m
[31m+         case "amount":[39m
[31m+           amount = v;[39m
[31m+           break;[39m
[31m+       }[39m
[31m+     };[39m
[31m+     for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+[39m
[31m+     return {[39m
[31m+       input,[39m
[31m+       output,[39m
[31m+       degraded: true,[39m
[31m+       degradedReason: "Fallback — 100 Hz envelope ducking (inactive in offline renders)",[39m
[31m+       setParameter: (id, v) => apply(id, v, ctx.currentTime),[39m
[31m+       setParameterAt: (id, v, when) => apply(id, v, when),[39m
[31m+       setSidechainInput(node: AudioNode | null) {[39m
[31m+         if (sidechainNode === node) return;[39m
[31m+         if (sidechainNode) {[39m
[31m+           try {[39m
[31m+             sidechainNode.disconnect(analyser);[39m
[31m+           } catch {[39m
[31m+             /* not connected */[39m
[31m+           }[39m
[31m+         }[39m
[31m+         sidechainNode = node;[39m
[31m+         if (node) {[39m
[31m+           env = 0;[39m
[31m+           node.connect(analyser);[39m
[31m+         } else {[39m
[31m+           // When sidechain is removed, restore the target gain to neutral.[39m
[31m+           target.gain.setTargetAtTime(1, ctx.currentTime, 0.02);[39m
[31m+         }[39m
[31m+       },[39m
[31m+       dispose: () => {[39m
[31m+         active = false;[39m
[31m+         if (interval !== null) {[39m
[31m+           clearInterval(interval);[39m
[31m+           interval = null;[39m
[31m+         }[39m
[31m+         if (sidechainNode) {[39m
[31m+           try {[39m
[31m+             sidechainNode.disconnect(analyser);[39m
[31m+           } catch {[39m
[31m+             /* not connected */[39m
[31m+           }[39m
[31m+           sidechainNode = null;[39m
[31m+         }[39m
[31m+         try {[39m
[31m+           analyser.disconnect();[39m
[31m+         } catch {[39m
[31m+           /* already disconnected */[39m
[31m+         }[39m
[31m+         input.disconnect();[39m
[31m+         target.disconnect();[39m
[31m+         output.disconnect();[39m
[31m+       },[39m
[31m+     };[39m
[31m+   },[39m
[31m+ };[39m
