[31m+ /**[39m
[31m+  * Force a 2-channel (stereo, speakers) signal stage. ChannelSplitterNode runs[39m
[31m+  * with explicit channelCount + discrete interpretation, so feeding it a MONO[39m
[31m+  * input leaves output channel 1 silent — every splitter-based effect (utility,[39m
[31m+  * haasWidener, msEq, bassBuss) lost its right channel for mono sources. An[39m
[31m+  * explicit-stereo gain node upmixes mono to both channels (speakers rules)[39m
[31m+  * before the split, and passes stereo through untouched.[39m
[31m+  */[39m
[31m+ function stereoUpmix(ctx: BaseAudioContext): GainNode {[39m
[31m+   const up = ctx.createGain();[39m
[31m+   up.channelCount = 2;[39m
[31m+   up.channelCountMode = "explicit";[39m
[31m+   up.channelInterpretation = "speakers";[39m
[31m+   return up;[39m
[31m+ }[39m
