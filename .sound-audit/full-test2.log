[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — autowah bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Stutter ---------------- */[39m
[31m+ // BPM-synced loop-repeat: reads from one full loop cycle behind and gates[39m
[31m+ // the delayed signal with a 16-step pattern. Because the underlying beat is[39m
[31m+ // repetitive, hearing the same gated segments each cycle creates the classic[39m
[31m+ // stutter/glitch feel. Feedback intensifies the loop.[39m
