[31m+   factory(ctx, instance) {[39m
[31m+     const input = ctx.createGain();[39m
[31m+     const output = ctx.createGain();[39m
[31m+     const splitterIn = ctx.createChannelSplitter(2);[39m
[31m+     const mergerMS = ctx.createChannelMerger(2);[39m
[31m+     const splitterMS = ctx.createChannelSplitter(2);[39m
[31m+     const mergerOut = ctx.createChannelMerger(2);[39m
[31m+[39m
[31m+     // Encode: Mid = 0.5*(L+R), Side = 0.5*(L-R)[39m
