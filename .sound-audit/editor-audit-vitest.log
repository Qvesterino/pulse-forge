[31m+       const attackAmt = t < 0.5 ? t * 2 - 1 : (t - 0.5) * 2;[39m
[31m+       const write = (id: string, v: number): void => {[39m
[31m+         const param = transientNode.parameters.get(id);[39m
[31m+         if (param && Number.isFinite(v)) param.setValueAtTime(v, when);[39m
[31m+       };[39m
[31m+       write("attack", attackAmt);[39m
[31m+       write("sustain", t < 0.5 ? -t * 2 * 0.6 : 0);[39m
[31m+       write("mix", 1);[39m
[31m+     };[39m
[31m+     // Glue through the custom worklet compressor (PEAK detector grabs drum[39m
[31m+     // transients); legacy DCN mapping when the core bundle is missing.[39m
[31m+     const glue = createBussComp(ctx, {[39m
[31m+       threshold: -6 - (instance.params.compressor ?? 0.25) * 34,[39m
[31m+       ratio: 1 + (instance.params.compressor ?? 0.25) * 9,[39m
[31m+       attack: Math.max(0.001, 0.02 - (instance.params.transient ?? 0.15) * 0.015),[39m
[31m+       release: 0.12,[39m
[31m+       detector: 1,[39m
