[31m+[39m
[31m+     const analyser = ctx.createAnalyser();[39m
[31m+     analyser.fftSize = 1024;[39m
[31m+     analyser.smoothingTimeConstant = 0;[39m
[31m+     const analyserBuf = new Float32Array(analyser.fftSize);[39m
