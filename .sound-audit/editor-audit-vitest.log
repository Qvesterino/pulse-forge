[31m+         case "tone":[39m
[31m+           smooth(tone.frequency, value, when);[39m
[31m+           break;[39m
[31m+         case "boomFrequency":[39m
[31m+           smooth(boom.frequency, value, when);[39m
[31m+           break;[39m
[31m+         case "boomAmount":[39m
[31m+           smooth(boom.gain, value * 8, when);[39m
[31m+           break;[39m
[31m+         case "mix":[39m
[31m+           mix.setMix(value, when);[39m
[31m+           break;[39m
[31m+         case "output":[39m
[31m+           smooth(out.gain, dbToLin(value), when);[39m
