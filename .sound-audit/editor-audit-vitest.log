[31m+ /* ---------------- Ozvena (VocalForge plugin, vendored DSP oracle) ---------------- */[39m
[31m+ // Neoverb-class three-engine reverb: E1 Reflections, E2 Plate/Chamber,[39m
[31m+ // E3 Hall + pre-delay/pre-EQ/reverb-EQ/mod/duck/safety limiter. DSP runs in[39m
[31m+ // an AudioWorklet (vendored core parity-checked via tests/ozvena-golden.test.ts).[39m
[31m+ // The rack exposes the global surface + blend pad + engine toggles; the[39m
[31m+ // XY Blend Pad canvas lands with the Ozvena panel.[39m
[31m+[39m
[31m+ const OZVENA_PARAM_DEFAULTS: Record<string, number> = {[39m
[31m+   "global.inputGainDb": 0,[39m
[31m+   "global.dryWet": 25,[39m
[31m+   "global.outputGainDb": 0,[39m
[31m+   "blendPad.x": 0.5,[39m
[31m+   "blendPad.y": 0.5,[39m
[31m+   "engines.e1.enabled": 1,[39m
[31m+   "engines.e2.enabled": 1,[39m
[31m+   "engines.e3.enabled": 1,[39m
[31m+   // CPU lever: eco drops the safety limiter to 1× oversampling and the FDN[39m
