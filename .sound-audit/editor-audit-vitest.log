[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Vowel / Formant Filter ---------------- */[39m
[31m+ // 3× peaking cascade morphing across A-E-I-O-U (log-interpole). Resonance scales[39m
[31m+ // Q (3.5→9) and peak gain (7→15 dB). True vowel movement for beat textures.[39m
[31m+[39m
[31m+ const vowel: EffectDefinition = {[39m
[31m+   type: "vowel",[39m
