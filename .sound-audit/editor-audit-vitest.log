[31m+       shaper.connect(glue.input);[39m
[31m+     }[39m
[31m+     glue.output.connect(tone).connect(boom).connect(out).connect(mix.output);[39m
[31m+     const apply = (id: string, value: number, when: number) => {[39m
[31m+       switch (id) {[39m
[31m+         case "drive":[39m
[31m+           shaper.curve = bussCurve(value);[39m
[31m+           break;[39m
[31m+         case "transient":[39m
