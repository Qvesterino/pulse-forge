[31m+[39m
[31m+ // Only audio state belongs in the effect's param map. `schemaVersion`, the[39m
[31m+ // assistant wizard and analyzer bookkeeping are serialized state metadata,[39m
[31m+ // not DSP controls and must not become automatable target ids by accident.[39m
[31m+[39m
[31m+ const ozvena: EffectDefinition = {[39m
[31m+   type: "ozvena",[39m
[31m+   name: "VØID",[39m
[31m+   category: "space",[39m
[31m+   params: ozvenaParams,[39m
[31m+   factory(ctx, instance, env) {[39m
[31m+     if (isWorkletReady("ozvena", ctx)) {[39m
[31m+       // Initial BPM seeds the tempo-synced pre-delay so the first block[39m
[31m+       // already matches the project tempo (syncBpm keeps it live after).[39m
