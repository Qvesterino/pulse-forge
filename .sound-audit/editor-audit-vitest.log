[31m+     const applyCurve = () => {[39m
[31m+       shaper.curve = characterCurve(Math.max(0, Math.min(4, mode)) as CharacterMode, driveVal, biasVal);[39m
[31m+     };[39m
[31m+     applyCurve();[39m
[31m+     const apply = (id: string, v: number, when: number) => {[39m
[31m+       switch (id) {[39m
[31m+         case "drive":[39m
[31m+           driveVal = v;[39m
[31m+           applyCurve();[39m
[31m+           break;[39m
[31m+         case "character":[39m
[31m+           mode = Math.round(v);[39m
[31m+           applyCurve();[39m
[31m+           break;[39m
[31m+         case "bias":[39m
[31m+           biasVal = v;[39m
