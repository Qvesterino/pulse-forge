[31m+ function bussCurve(drive: number): Float32Array<ArrayBuffer> {[39m
[31m+   const curve = new Float32Array(new ArrayBuffer(2048 * 4));[39m
[31m+   const k = 1 + drive * 18;[39m
[31m+   for (let i = 0; i < curve.length; i++) {[39m
[31m+     const x = (i / (curve.length - 1)) * 2 - 1;[39m
[31m+     curve[i] = Math.tanh(x * k);[39m
[31m+   }[39m
[31m+   return curve;[39m
[31m+ }[39m
[31m+[39m
[31m+ /* ---------------- Drum / Bass Buss glue ---------------- */[39m
[31m+ // Both busses drive their glue through the custom compressor worklet[39m
[31m+ // (per-sample PEAK/RMS detector, soft-knee, SC HPF) when the core bundle is[39m
[31m+ // loaded, and fall back to the legacy DynamicsCompressorNode mapping[39m
[31m+ // otherwise. Saturation runs 4× oversampled in both paths.[39m
[31m+[39m
[31m+ interface BussCompStage {[39m
[31m+   input: AudioNode;[39m
[31m+   output: AudioNode;[39m
[31m+   applyComp: (kind: "threshold" | "ratio" | "attack" | "release", v: number, when: number) => void;[39m
[31m+   getGr: () => number;[39m
[31m+   native: boolean;[39m
[31m+   dispose: () => void;[39m
[31m+ }[39m
[31m+[39m
[31m+ function createBussComp([39m
[31m+   ctx: BaseAudioContext,[39m
[31m+   seed: { threshold: number; ratio: number; attack: number; release: number; detector: number },[39m
[31m+ ): BussCompStage {[39m
[31m+   if (isWorkletReady("compressor", ctx)) {[39m
[31m+     const rt = createCompressorNode(ctx, {[39m
[31m+       params: {[39m
[31m+         threshold: seed.threshold,[39m
[31m+         ratio: seed.ratio,[39m
[31m+         attack: seed.attack,[39m
[31m+         release: seed.release,[39m
[31m+         knee: 6,[39m
[31m+         detector: seed.detector,[39m
[31m+         scHpf: 20,[39m
[31m+         makeup: 0,[39m
[31m+         mix: 1,[39m
[31m+       },[39m
[31m+     });[39m
[31m+     return {[39m
[31m+       input: rt.input,[39m
[31m+       output: rt.output,[39m
[31m+       applyComp: (kind, v, when) => rt.setParameterAt?.(kind, v, when),[39m
[31m+       getGr: () => rt.getGainReductionDb?.() ?? 0,[39m
[31m+       native: false,[39m
[31m+       dispose: () => rt.dispose(),[39m
[31m+     };[39m
[31m+   }[39m
[31m+   const comp = ctx.createDynamicsCompressor();[39m
[31m+   comp.threshold.value = seed.threshold;[39m
[31m+   comp.ratio.value = seed.ratio;[39m
[31m+   comp.attack.value = seed.attack;[39m
[31m+   comp.release.value = seed.release;[39m
[31m+   comp.knee.value = 6;[39m
[31m+   const applyComp: BussCompStage["applyComp"] = (kind, v, when) => {[39m
[31m+     switch (kind) {[39m
[31m+       case "threshold":[39m
[31m+         smooth(comp.threshold, v, when);[39m
[31m+         break;[39m
[31m+       case "ratio":[39m
[31m+         smooth(comp.ratio, v, when);[39m
[31m+         break;[39m
[31m+       case "attack":[39m
[31m+         smooth(comp.attack, v, when);[39m
[31m+         break;[39m
[31m+       case "release":[39m
[31m+         smooth(comp.release, v, when);[39m
[31m+         break;[39m
[31m+     }[39m
[31m+   };[39m
[31m+   const getGr = () => {[39m
[31m+     const raw = (comp as unknown as { reduction?: number | { value: number } }).reduction;[39m
[31m+     const value =[39m
[31m+       typeof raw === "number" ? raw : typeof raw === "object" && raw && typeof raw.value === "number" ? raw.value : 0;[39m
[31m+     return Math.max(0, Number.isFinite(value) ? -value : 0);[39m
[31m+   };[39m
[31m+   return {[39m
[31m+     input: comp,[39m
[31m+     output: comp,[39m
[31m+     applyComp,[39m
[31m+     getGr,[39m
[31m+     native: true,[39m
[31m+     dispose: () => comp.disconnect(),[39m
[31m+   };[39m
[31m+ }[39m
[31m+[39m
[31m+ const drumBuss: EffectDefinition = {[39m
[31m+   type: "drumBuss",[39m
[31m+   name: "Drum Buss",[39m
[31m+   category: "character",[39m
[31m+   params: drumBussParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     const mix = mixBus(ctx);[39m
[31m+     const shaper = ctx.createWaveShaper();[39m
[31m+     shaper.oversample = "4x";[39m
[31m+     // REAL transient stage: a transient-processor worklet between the shaper[39m
[31m+     // and the glue comp — the TRANSIENT knob now drives its attack/sustain[39m
[31m+     // (0–50% tames sustain, 50–100% boosts attack) in addition to nudging[39m
[31m+     // the comp attack, instead of only nudging comp attack.[39m
[31m+     const transientNode = isWorkletReady("transient", ctx)[39m
[31m+       ? new AudioWorkletNode(ctx, "transient-processor", {[39m
[31m+           numberOfInputs: 1,[39m
[31m+           numberOfOutputs: 1,[39m
[31m+           outputChannelCount: [2],[39m
[31m+           channelCount: 2,[39m
