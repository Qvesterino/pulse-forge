[31m+           applyCurve();[39m
[31m+           if (keyReleaseParam) keyReleaseParam.setTargetAtTime(releaseMsOf(v) / 1000, when, 0.05);[39m
[31m+           else if (smoothLp) smooth(smoothLp.frequency, releaseLpFreq(v), when, 0.05);[39m
[31m+           break;[39m
[31m+       }[39m
[31m+     };[39m
[31m+     for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+[39m
[31m+     return {[39m
[31m+       input,[39m
[31m+       output,[39m
[31m+       // The native key envelope is symmetric (no fast-attack stage) — flag[39m
[31m+       // it while a key is wired so the UI stays honest. Oscillator mode and[39m
