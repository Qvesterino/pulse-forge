[31m+     const pan = ctx.createStereoPanner();[39m
[31m+     // DC BLOCK (GOAL 08/A3): a 12 Hz highpass crossed wet/dry. Engaged it[39m
[31m+     // removes sub-audio DC offset (the thump/click a downstream gain move[39m
[31m+     // causes when the signal rides a DC pedestal); disengaged it is a[39m
[31m+     // unity-gain wire. The param existed for a long time as a dead knob.[39m
[31m+     const dcHp = ctx.createBiquadFilter();[39m
[31m+     dcHp.type = "highpass";[39m
[31m+     dcHp.frequency.value = 12;[39m
[31m+     dcHp.Q.value = 0.5;[39m
[31m+     const dcWet = ctx.createGain();[39m
[31m+     const dcDry = ctx.createGain();[39m
[31m+     merger.connect(dcHp).connect(dcWet).connect(pan);[39m
[31m+     merger.connect(dcDry).connect(pan);[39m
[31m+     pan.connect(output);[39m
[31m+     let dcBlockOn = instance.params.dcBlock === 1;[39m
[31m+     dcWet.gain.value = dcBlockOn ? 1 : 0;[39m
[31m+     dcDry.gain.value = dcBlockOn ? 0 : 1;[39m
[31m+     const applyDcBlock = (when: number) => {[39m
[31m+       smooth(dcWet.gain, dcBlockOn ? 1 : 0, when);[39m
[31m+       smooth(dcDry.gain, dcBlockOn ? 0 : 1, when);[39m
[31m+     };[39m
[31m+     let widthValue = instance.params.width ?? 1;[39m
[31m+     let phaseLeft = instance.params.phaseLeft === 1;[39m
[31m+     let phaseRight = instance.params.phaseRight === 1;[39m
[31m+     const applyWidth = (when: number) => {[39m
[31m+       const width = Math.max(0, Math.min(2, widthValue));[39m
[31m+       smooth(left.gain, ((1 + width) / 2) * (phaseLeft ? -1 : 1), when);[39m
[31m+       smooth(right.gain, ((1 + width) / 2) * (phaseRight ? -1 : 1), when);[39m
[31m+       smooth(crossLeft.gain, (1 - width) / 2, when);[39m
[31m+       smooth(crossRight.gain, (1 - width) / 2, when);[39m
[31m+     };[39m
[31m+     const apply = (id: string, value: number, when: number) => {[39m
[31m+       switch (id) {[39m
[31m+         case "gain":[39m
[31m+           smooth(output.gain, dbToLin(value), when);[39m
[31m+           break;[39m
[31m+         case "pan":[39m
[31m+           smooth(pan.pan, value, when);[39m
[31m+           break;[39m
[31m+         case "width": {[39m
[31m+           widthValue = value;[39m
[31m+           applyWidth(when);[39m
[31m+           break;[39m
[31m+         }[39m
[31m+         case "phaseLeft":[39m
[31m+           phaseLeft = value >= 0.5;[39m
[31m+           applyWidth(when);[39m
[31m+           break;[39m
[31m+         case "phaseRight":[39m
[31m+           phaseRight = value >= 0.5;[39m
[31m+           applyWidth(when);[39m
[31m+           break;[39m
[31m+         case "dcBlock":[39m
[31m+           dcBlockOn = value >= 0.5;[39m
[31m+           applyDcBlock(when);[39m
[31m+           break;[39m
[31m+         case "monoBassFrequency": {[39m
[31m+           const frequency = Math.max(20, value || 20);[39m
[31m+           smooth(highLeft.frequency, frequency, when);[39m
[31m+           smooth(highRight.frequency, frequency, when);[39m
[31m+           smooth(lowLeft.frequency, frequency, when);[39m
[31m+           smooth(lowRight.frequency, frequency, when);[39m
[31m+           const active = value > 0 ? 0.5 : 0;[39m
[31m+           smooth(monoLeft.gain, active, when);[39m
[31m+           smooth(monoRight.gain, active, when);[39m
[31m+           break;[39m
[31m+         }[39m
[31m+       }[39m
[31m+     };[39m
[31m+     for (const [id, value] of Object.entries(instance.params)) apply(id, value, ctx.currentTime);[39m
[31m+     return {[39m
[31m+       input,[39m
[31m+       output,[39m
[31m+       setParameter: (id, value) => apply(id, value, ctx.currentTime),[39m
[31m+       setParameterAt: (id, value, when) => apply(id, value, when),[39m
[31m+       dispose: () => {[39m
[31m+         input.disconnect();[39m
[31m+         output.disconnect();[39m
[31m+         upmixIn.disconnect();[39m
[31m+         splitter.disconnect();[39m
[31m+         merger.disconnect();[39m
[31m+         left.disconnect();[39m
[31m+         right.disconnect();[39m
[31m+         crossLeft.disconnect();[39m
[31m+         crossRight.disconnect();[39m
[31m+         highLeft.disconnect();[39m
[31m+         highRight.disconnect();[39m
[31m+         lowLeft.disconnect();[39m
[31m+         lowRight.disconnect();[39m
[31m+         monoLeft.disconnect();[39m
[31m+         monoRight.disconnect();[39m
[31m+         pan.disconnect();[39m
[31m+       },[39m
[31m+     };[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Look-ahead Limiter ---------------- */[39m
[31m+ // True brickwall limiting: a monotonic max-deque over the look-ahead window[39m
[31m+ // lets gain changes precede transients, so peaks never exceed CEILING (unlike[39m
[31m+ // the native master DynamicsCompressorNode with its 2 ms attack). Latency =[39m
[31m+ // exactly LOOKAHEAD — reported via getLatencySec and compensated by the[39m
[31m+ // engine's PDC. LOOKAHEAD defaults to 5 ms; drop it to 1 ms for insert use on[39m
[31m+ // individual tracks where minimal latency matters more than anticipation.[39m
[31m+[39m
[31m+ const limiter: EffectDefinition = {[39m
[31m+   type: "limiter",[39m
[31m+   name: "Limiter",[39m
[31m+   category: "dynamics",[39m
[31m+   params: limiterParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     if (isWorkletReady("limiter", ctx)) return createLimiterNode(ctx, instance);[39m
[31m+     // Transparent 1:1 bypass fallback — never fake-limit, always warn.[39m
[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — limiter bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Step Gate (trance gate) ---------------- */[39m
[31m+ // Rhythmically gates the input on an editable 8/16/32-step pattern, synced to[39m
[31m+ // the transport grid via syncBpm/onTransportStarted (same hooks as Pump).[39m
[31m+ // Zero latency, deterministic offline (default anchor phase 0 @ time 0).[39m
[31m+ // The pattern lives on EffectInstance.steps (8/16/32 × 0..1 open amounts).[39m
[31m+[39m
[31m+ const stepGate: EffectDefinition = {[39m
[31m+   type: "stepGate",[39m
[31m+   name: "Step Gate",[39m
[31m+   category: "movement",[39m
[31m+   params: stepGateParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     if (isWorkletReady("stepGate", ctx)) {[39m
[31m+       const handle = createStepGateNode(ctx, instance);[39m
[31m+       if (instance.steps && instance.steps.length > 0) handle.setPattern(instance.steps);[39m
[31m+       return {[39m
[31m+         input: handle.input,[39m
[31m+         output: handle.output,[39m
[31m+         setParameter: handle.setParameter,[39m
[31m+         setParameterAt: handle.setParameterAt,[39m
[31m+         syncBpm: handle.syncBpm,[39m
[31m+         onTransportStarted: handle.onTransportStarted,[39m
[31m+         dispose: handle.dispose,[39m
[31m+       };[39m
[31m+     }[39m
[31m+     // Transparent 1:1 bypass fallback — a gate that doesn't gate silently[39m
[31m+     // would be worse than no gate; the UI shows the warning badge.[39m
[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — step gate bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- SV Filter (TPT SVF) ---------------- */[39m
[31m+ // Zero-delay topology-preserving state variable filter (Andy Simper).[39m
[31m+ // LP/HP/BP/Notch modes, resonance up to self-oscillation, tanh drive.[39m
[31m+ // Unlike BiquadFilterNode, the feedback path has NO one-sample delay —[39m
[31m+ // modulated cutoff stays clean and the resonance behaviour is analog-like.[39m
[31m+[39m
[31m+ const svFilter: EffectDefinition = {[39m
[31m+   type: "svFilter",[39m
[31m+   name: "SV Filter",[39m
[31m+   category: "tone",[39m
[31m+   params: svFilterParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     if (isWorkletReady("svFilter", ctx)) return createSvFilterNode(ctx, instance);[39m
[31m+     // Transparent bypass fallback — the TPT resonance character can't be[39m
[31m+     // faked by a BiquadFilterNode; a degraded approximation would be misleading.[39m
[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — SV filter bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Flanger ---------------- */[39m
[31m+ // Per-sample modulated delay with ZERO-DELAY feedback (worklet feeds back[39m
[31m+ // within the same sample, unlike native DelayNode loops which add one render[39m
[31m+ // quantum). Stereo spread via L/R LFO phase offset.[39m
[31m+[39m
[31m+ const flanger: EffectDefinition = {[39m
[31m+   type: "flanger",[39m
[31m+   name: "Flanger",[39m
[31m+   category: "movement",[39m
[31m+   params: flangerParams,[39m
[31m+   factory(ctx, instance, env) {[39m
[31m+     if (isWorkletReady("flanger", ctx)) return createFlangerNode(ctx, instance, env.bpm);[39m
[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — flanger bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Tremolo ---------------- */[39m
[31m+ // Amplitude modulation via LFO. AM mode = classic tremolo, Auto-Pan mode[39m
[31m+ // pans between channels. Shape morphs sine→square for harder rhythmic feel.[39m
[31m+[39m
[31m+ const tremolo: EffectDefinition = {[39m
[31m+   type: "tremolo",[39m
[31m+   name: "Tremolo",[39m
[31m+   category: "movement",[39m
[31m+   params: tremoloParams,[39m
[31m+   factory(ctx, instance, env) {[39m
[31m+     if (isWorkletReady("tremolo", ctx)) return createTremoloNode(ctx, instance, env.bpm);[39m
[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — tremolo bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Autowah ---------------- */[39m
[31m+ // Envelope follower drives a Chamberlin SVF's cutoff per-sample. Playing[39m
[31m+ // harder opens the filter; release closes it gradually. Resonance gives the[39m
[31m+ // classic vocal "wah" quality. Single worklet — truly zero-delay.[39m
[31m+[39m
[31m+ const autowah: EffectDefinition = {[39m
[31m+   type: "autowah",[39m
[31m+   name: "Autowah",[39m
[31m+   category: "movement",[39m
[31m+   params: autowahParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     if (isWorkletReady("autowah", ctx)) return createAutowahNode(ctx, instance);[39m
[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — autowah bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Stutter ---------------- */[39m
[31m+ // BPM-synced loop-repeat: reads from one full loop cycle behind and gates[39m
[31m+ // the delayed signal with a 16-step pattern. Because the underlying beat is[39m
[31m+ // repetitive, hearing the same gated segments each cycle creates the classic[39m
[31m+ // stutter/glitch feel. Feedback intensifies the loop.[39m
[31m+[39m
[31m+ const stutter: EffectDefinition = {[39m
[31m+   type: "stutter",[39m
[31m+   name: "Stutter",[39m
[31m+   category: "movement",[39m
[31m+   params: stutterParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     if (isWorkletReady("stutter", ctx)) {[39m
[31m+       const handle = createStutterNode(ctx, instance);[39m
[31m+       if (instance.steps && instance.steps.length > 0) handle.setPattern(instance.steps);[39m
[31m+       return {[39m
[31m+         input: handle.input,[39m
[31m+         output: handle.output,[39m
[31m+         setParameter: handle.setParameter,[39m
[31m+         setParameterAt: handle.setParameterAt,[39m
[31m+         syncBpm: handle.syncBpm,[39m
[31m+         onTransportStarted: handle.onTransportStarted,[39m
[31m+         dispose: handle.dispose,[39m
[31m+       };[39m
[31m+     }[39m
[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — stutter bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Comb Filter ---------------- */[39m
[31m+ // Static feedback comb — tuned delay with damping, metallic / hollow resonances.[39m
[31m+ // LFO-less cousin of Flanger: delay sets comb fundamental (pitch), feedback[39m
[31m+ // sets resonance depth (positive = harmonic, negative = odd), damp tames highs.[39m
[31m+[39m
[31m+ const comb: EffectDefinition = {[39m
[31m+   type: "comb",[39m
[31m+   name: "Comb",[39m
[31m+   category: "movement",[39m
[31m+   params: combParams,[39m
