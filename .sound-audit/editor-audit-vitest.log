[31m+     const useKeyFollower = isWorkletReady("envFollower", ctx);[39m
[31m+     // RELEASE maps to follower recovery 50..600 ms.[39m
[31m+     const releaseMsOf = (r: number) => 50 + Math.max(0, Math.min(1, r)) * 550;[39m
