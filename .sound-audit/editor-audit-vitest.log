[31m+     const out = ctx.createGain();[39m
[31m+     mix.wet.connect(preHP).connect(shaper).connect(tone).connect(out).connect(mix.output);[39m
[31m+     let mode = Math.round(instance.params.character ?? 0);[39m
[31m+     let driveVal = instance.params.drive ?? 0.3;[39m
