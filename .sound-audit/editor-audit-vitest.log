[31m+ // ducked so the tail preserves its own decay when the dry comes back.[39m
[31m+[39m
[31m+ const duckDelay: EffectDefinition = {[39m
[31m+   type: "duckDelay",[39m
[31m+   name: "Duck Delay",[39m
[31m+   category: "space",[39m
[31m+   params: duckDelayParams,[39m
[31m+   factory(ctx, instance) {[39m
