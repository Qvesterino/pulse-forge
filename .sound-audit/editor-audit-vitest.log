[31m+     const monoLeft = ctx.createGain();[39m
[31m+     const monoRight = ctx.createGain();[39m
[31m+     // Upmix mono→stereo first: a bare splitter fed a mono source reports[39m
[31m+     // channel 1 as silence, so the whole right side (and with it pan/width)[39m
[31m+     // died for mono tracks.[39m
[31m+     const upmixIn = stereoUpmix(ctx);[39m
[31m+     input.connect(upmixIn).connect(splitter);[39m
[31m+     splitter.connect(highLeft, 0);[39m
[31m+     splitter.connect(highRight, 1);[39m
[31m+     highLeft.connect(left).connect(merger, 0, 0);[39m
