[31m+         }[39m
[31m+         curve[i] = c * shaped;[39m
[31m+       }[39m
[31m+       const guardCurve = new Float32Array(new ArrayBuffer(n * 4));[39m
[31m+       for (let i = 0; i < n; i++) {[39m
[31m+         const u = (i / (n - 1)) * 2 - 1;[39m
