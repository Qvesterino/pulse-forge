[31m+     let ratio = 4;[39m
[31m+     let amount = 1;[39m
[31m+     let attackCoef = Math.exp(-1 / (ctx.sampleRate * 0.005));[39m
[31m+     let releaseCoef = Math.exp(-1 / (ctx.sampleRate * 0.2));[39m
