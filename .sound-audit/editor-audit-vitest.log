[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — ducking delay bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ────────────── FX Expansion (beatmaking pass) ────────────── */[39m
