[31m+       try {[39m
[31m+         osc.stop(when);[39m
[31m+       } catch {[39m
[31m+         /* not started */[39m
[31m+       }[39m
[31m+       const old = osc;[39m
[31m+       osc = null;[39m
[31m+       old.onended = () => {[39m
[31m+         try {[39m
[31m+           old.disconnect();[39m
[31m+         } catch {[39m
[31m+           /* already gone */[39m
[31m+         }[39m
[31m+       };[39m
[31m+     };[39m
[31m+     const startOsc = (when: number) => {[39m
[31m+       // A wired key owns the ducking — the oscillator stays out of the way.[39m
[31m+       if (keySource) return;[39m
[31m+       if (osc) {[39m
[31m+         // Disconnect only AFTER the scheduled stop — an immediate disconnect[39m
[31m+         // collapsed the modulation into target.gain in one sample (audible[39m
[31m+         // jump) and left the pump dead until the new oscillator started at[39m
[31m+         // `when`. onended fires at the stop time; the replacement oscillator[39m
[31m+         // starts at the same `when`, so the handover is sample-continuous.[39m
[31m+         const old = osc;[39m
[31m+         try {[39m
[31m+           old.stop(when);[39m
[31m+         } catch {[39m
[31m+           /* not started */[39m
[31m+         }[39m
[31m+         old.onended = () => {[39m
[31m+           try {[39m
[31m+             old.disconnect();[39m
[31m+           } catch {[39m
[31m+             /* already gone */[39m
[31m+           }[39m
[31m+         };[39m
[31m+       }[39m
[31m+       osc = ctx.createOscillator();[39m
[31m+       osc.type = "sawtooth";[39m
[31m+       osc.frequency.value = freqOf();[39m
[31m+       osc.connect(shaper);[39m
[31m+       osc.start(when);[39m
