[31m+[39m
[31m+ /* ---------------- Pump ---------------- */[39m
[31m+[39m
[31m+ export function duckCurve(release: number, n = 1024): Float32Array<ArrayBuffer> {[39m
[31m+   const k = 3 + release * 15;[39m
[31m+   const curve = new Float32Array(new ArrayBuffer(n * 4));[39m
[31m+   for (let i = 0; i < n; i++) {[39m
[31m+     curve[i] = Math.exp(-(i / (n - 1)) * k);[39m
[31m+   }[39m
[31m+   return curve;[39m
[31m+ }[39m
[31m+[39m
[31m+ const pump: EffectDefinition = {[39m
[31m+   type: "pump",[39m
[31m+   name: "Pump",[39m
[31m+   category: "movement",[39m
[31m+   params: pumpParams,[39m
[31m+   factory(ctx, instance, env) {[39m
[31m+     const input = ctx.createGain();[39m
