[31m+     const splitter = ctx.createChannelSplitter(2);[39m
[31m+     const merger = ctx.createChannelMerger(2);[39m
[31m+     const left = ctx.createGain();[39m
[31m+     const right = ctx.createGain();[39m
[31m+     const crossLeft = ctx.createGain();[39m
[31m+     const crossRight = ctx.createGain();[39m
[31m+     const highLeft = ctx.createBiquadFilter();[39m
