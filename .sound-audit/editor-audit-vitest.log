[31m+       input: mix.input,[39m
[31m+       output: mix.output,[39m
[31m+       ...(glue.native[39m
[31m+         ? { degraded: true as const, degradedReason: "Buss compressor on native fallback — glue approximate" }[39m
[31m+         : {}),[39m
[31m+       setParameter: (id, value) => apply(id, value, ctx.currentTime),[39m
[31m+       setParameterAt: (id, value, when) => apply(id, value, when),[39m
[31m+       getGainReductionDb: () => glue.getGr(),[39m
