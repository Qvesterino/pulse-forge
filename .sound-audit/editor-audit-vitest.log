[31m+       output: mix.output,[39m
[31m+       setParameter: (id, v) => apply(id, v, ctx.currentTime),[39m
[31m+       setParameterAt: (id, v, when) => apply(id, v, when),[39m
[31m+       dispose: () => {[39m
[31m+         mix.input.disconnect();[39m
[31m+         mix.output.disconnect();[39m
[31m+         preHP.disconnect();[39m
[31m+         shaper.disconnect();[39m
[31m+         tone.disconnect();[39m
[31m+         out.disconnect();[39m
[31m+       },[39m
[31m+     };[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Tape Saturation (hysteresis) ---------------- */[39m
[31m+[39m
[31m+ const tapeSat: EffectDefinition = {[39m
[31m+   type: "tapeSat",[39m
[31m+   name: "Tape Sat",[39m
[31m+   category: "character",[39m
[31m+   params: tapeSatParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     if (isWorkletReady("tapeSat", ctx)) return createTapeNode(ctx, instance);[39m
[31m+     return bypassRuntime(ctx, "AudioWorklet unavailable — tape saturation bypassed (1:1 signal)");[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Clipper ---------------- */[39m
[31m+[39m
[31m+ const clipper: EffectDefinition = {[39m
[31m+   type: "clipper",[39m
[31m+   name: "Clipper",[39m
[31m+   category: "character",[39m
[31m+   params: clipperParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     // Parallel topology via mixBus: MIX < 100 blends the CLEAN path back in[39m
[31m+     // (the classic "parallel clipper" — transient snap without the crushed[39m
[31m+     // body). The dry reference is pre-drive, so DRIVE does not change the[39m
[31m+     // blended level.[39m
[31m+     const mix = mixBus(ctx);[39m
[31m+     mix.setMix(instance.params.mix ?? 1, ctx.currentTime);[39m
[31m+     const pre = ctx.createGain();[39m
[31m+     const shaper = ctx.createWaveShaper();[39m
[31m+     shaper.oversample = "4x";[39m
[31m+     const post = ctx.createGain();[39m
[31m+     mix.wet.connect(pre).connect(shaper).connect(post).connect(mix.output);[39m
[31m+     const ceilingGuard = ctx.createWaveShaper();[39m
[31m+     ceilingGuard.oversample = "4x";[39m
[31m+     const output = ctx.createGain();[39m
[31m+     mix.output.connect(ceilingGuard).connect(output);[39m
[31m+     let ceiling = instance.params.ceiling ?? -1;[39m
[31m+     let softness = instance.params.softness ?? 0.2;[39m
[31m+     const curveOf = () => {[39m
[31m+       const c = dbToLin(ceiling);[39m
[31m+       const n = 2048;[39m
[31m+       const curve = new Float32Array(new ArrayBuffer(n * 4));[39m
[31m+       for (let i = 0; i < n; i++) {[39m
[31m+         const u = (i / (n - 1)) * 2 - 1;[39m
[31m+         let shaped: number;[39m
[31m+         if (softness < 0.02) {[39m
[31m+           shaped = Math.max(-1, Math.min(1, u));[39m
[31m+         } else {[39m
[31m+           const k = 1 + softness * 7;[39m
