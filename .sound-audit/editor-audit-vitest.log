[31m+     let keyReleaseParam: AudioParam | null = null;[39m
[31m+     // Native fallback chain nodes (built only when the worklet is missing).[39m
[31m+     let keyLp: BiquadFilterNode | null = null;[39m
[31m+     let rectifier: WaveShaperNode | null = null;[39m
[31m+     let smoothLp: BiquadFilterNode | null = null;[39m
[31m+     let sens: GainNode | null = null;[39m
[31m+     let clampShape: WaveShaperNode | null = null;[39m
[31m+     const releaseLpFreq = (r: number) => 120 - Math.max(0, Math.min(1, r)) * 108; // 12..120 Hz recovery[39m
[31m+     if (useKeyFollower) {[39m
[31m+       const follower = createEnvFollowerNode(ctx, {[39m
[31m+         params: { attackMs: 2, releaseMs: releaseMsOf(instance.params.release ?? 0.5), sensitivity: 2 },[39m
[31m+       });[39m
[31m+       keyFollower = follower;[39m
[31m+       keyReleaseParam = follower.getAudioParam?.("release") ?? null;[39m
[31m+       keyInput.connect(follower.input);[39m
[31m+       follower.output.connect(amt);[39m
[31m+     } else {[39m
[31m+       const lp = ctx.createBiquadFilter();[39m
[31m+       lp.type = "lowpass";[39m
[31m+       lp.frequency.value = 200;[39m
[31m+       const rect = ctx.createWaveShaper();[39m
[31m+       rect.oversample = "none"; // control-rate envelope, not audio[39m
[31m+       rect.curve = (() => {[39m
[31m+         const n = 1024;[39m
[31m+         const curve = new Float32Array(new ArrayBuffer(n * 4));[39m
[31m+         for (let i = 0; i < n; i++) curve[i] = Math.abs((i / (n - 1)) * 2 - 1);[39m
[31m+         return curve;[39m
[31m+       })();[39m
[31m+       const smooth = ctx.createBiquadFilter();[39m
[31m+       smooth.type = "lowpass";[39m
[31m+       const sensitivity = ctx.createGain();[39m
[31m+       sensitivity.gain.value = 1.5;[39m
[31m+       const clamp = ctx.createWaveShaper();[39m
[31m+       clamp.oversample = "none";[39m
[31m+       clamp.curve = (() => {[39m
[31m+         const n = 1024;[39m
[31m+         const curve = new Float32Array(new ArrayBuffer(n * 4));[39m
[31m+         for (let i = 0; i < n; i++) curve[i] = Math.min(1, Math.max(0, (i / (n - 1)) * 2 - 1));[39m
[31m+         return curve;[39m
[31m+       })();[39m
[31m+       keyLp = lp;[39m
[31m+       rectifier = rect;[39m
[31m+       smoothLp = smooth;[39m
[31m+       sens = sensitivity;[39m
[31m+       clampShape = clamp;[39m
[31m+       keyInput.connect(lp).connect(rect).connect(smooth).connect(sensitivity).connect(clamp).connect(amt);[39m
[31m+     }[39m
[31m+[39m
[31m+     let keySource: AudioNode | null = null;[39m
[31m+[39m
[31m+     let bpm = env.bpm;[39m
[31m+     let release = instance.params.release ?? 0.5;[39m
[31m+     let rateIndex = Math.max(0, Math.min(PUMP_DIVISIONS.length - 1, Math.round(instance.params.rate ?? 2)));[39m
[31m+     let osc: OscillatorNode | null = null;[39m
[31m+[39m
[31m+     if (smoothLp) smoothLp.frequency.value = releaseLpFreq(release);[39m
[31m+[39m
[31m+     const freqOf = () => (bpm / 60) * PUMP_DIVISIONS[rateIndex].mult;[39m
