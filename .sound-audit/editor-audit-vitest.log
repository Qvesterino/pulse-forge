[31m+         case "mix":[39m
[31m+           mix.setMix(v, when);[39m
[31m+           break;[39m
[31m+         case "output":[39m
[31m+           smooth(out.gain, dbToLin(v), when);[39m
[31m+           break;[39m
[31m+       }[39m
[31m+     };[39m
[31m+     for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+     return {[39m
[31m+       input: mix.input,[39m
