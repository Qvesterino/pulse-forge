[31m+     const apply = (id: string, v: number, when: number) => {[39m
[31m+       switch (id) {[39m
[31m+         case "drive":[39m
[31m+           smooth(pre.gain, 1 + v * 8, when);[39m
[31m+           break;[39m
[31m+         case "ceiling":[39m
