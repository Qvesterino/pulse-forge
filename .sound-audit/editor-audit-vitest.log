[31m+[39m
[31m+ /* ---------------- MORPH DYNAMICS (dynamics-driven morph processor) ----------------[39m
[31m+  * "Your sound becomes the modulator": transient/body/texture analysis becomes[39m
[31m+  * the control system driving dynamics, character, motion and space. PRESSURE[39m
[31m+  * is the signature macro — the depth of reactive transformation. DSP runs in[39m
[31m+  * an AudioWorklet (first-party morph-dynamics-core; see the plugin docs in[39m
[31m+  * src/effects/morph-dynamics/*.md and tests/morph-dynamics-*.test.ts). The[39m
[31m+  * rack exposes the six macros; the full engine (dynamics, stages, mod matrix)[39m
[31m+  * lives in the MORPH panel.[39m
[31m+  */[39m
[31m+[39m
[31m+ const morphdynamics: EffectDefinition = {[39m
[31m+   type: "morphdynamics",[39m
[31m+   name: "MORPH",[39m
[31m+   category: "dynamics",[39m
[31m+   params: morphdynamicsParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     if (isWorkletReady("morphdynamics", ctx)) {[39m
