[31m+           shaper.curve = curveOf();[39m
[31m+           break;[39m
[31m+         case "softness":[39m
[31m+           softness = v;[39m
[31m+           shaper.curve = curveOf();[39m
[31m+           break;[39m
[31m+         case "mix":[39m
[31m+           mix.setMix(v, when);[39m
[31m+           break;[39m
[31m+         case "output":[39m
[31m+           smooth(post.gain, dbToLin(v), when);[39m
[31m+           break;[39m
[31m+       }[39m
[31m+     };[39m
[31m+     for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+     return {[39m
[31m+       input: mix.input,[39m
[31m+       output,[39m
[31m+       setParameter: (id, v) => apply(id, v, ctx.currentTime),[39m
[31m+       setParameterAt: (id, v, when) => apply(id, v, when),[39m
[31m+       dispose: () => {[39m
[31m+         mix.input.disconnect();[39m
[31m+         mix.output.disconnect();[39m
[31m+         pre.disconnect();[39m
[31m+         shaper.disconnect();[39m
[31m+         post.disconnect();[39m
[31m+         ceilingGuard.disconnect();[39m
[31m+         output.disconnect();[39m
[31m+       },[39m
[31m+     };[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Reverb ---------------- */[39m
[31m+[39m
[31m+ function makeImpulseResponse(ctx: BaseAudioContext, decaySec: number, seed: number): AudioBuffer {[39m
[31m+   const length = Math.max(1, Math.floor(ctx.sampleRate * decaySec));[39m
[31m+   const buffer = ctx.createBuffer(2, length, ctx.sampleRate);[39m
[31m+   const rand = mulberry32(seed);[39m
[31m+   for (let ch = 0; ch < 2; ch++) {[39m
[31m+     const data = buffer.getChannelData(ch);[39m
[31m+     for (let i = 0; i < length; i++) {[39m
[31m+       data[i] = (rand() * 2 - 1) * Math.pow(1 - i / length, 2.4);[39m
[31m+     }[39m
[31m+   }[39m
[31m+   return buffer;[39m
[31m+ }[39m
[31m+[39m
[31m+ const reverb: EffectDefinition = {[39m
[31m+   type: "reverb",[39m
[31m+   name: "Reverb",[39m
[31m+   category: "space",[39m
[31m+   params: reverbParams,[39m
[31m+   factory(ctx, instance) {[39m
[31m+     if (isWorkletReady("reverb", ctx)) {[39m
[31m+       const mix = mixBus(ctx);[39m
[31m+       mix.setMix(instance.params.mix ?? 0.3, ctx.currentTime);[39m
[31m+       const preDelay = ctx.createDelay(0.5);[39m
[31m+       const node = createReverbNode(ctx, instance);[39m
[31m+       mix.wet.connect(preDelay).connect(node.input);[39m
[31m+       node.output.connect(mix.output);[39m
[31m+       const apply = (id: string, v: number, when: number) => {[39m
[31m+         switch (id) {[39m
[31m+           case "decay":[39m
[31m+             node.setParameter("decay", v);[39m
[31m+             break;[39m
[31m+           case "predelay":[39m
[31m+             smooth(preDelay.delayTime, v / 1000, when, 0.05);[39m
[31m+             break;[39m
[31m+           case "tone":[39m
[31m+             // Output brightness — separate from the in-loop damping.[39m
[31m+             node.setParameter("tone", v);[39m
[31m+             break;[39m
[31m+           case "damping":[39m
[31m+             // Feedback-loop darkening (how fast the TAIL loses HF).[39m
[31m+             node.setParameter("damping", v);[39m
[31m+             break;[39m
[31m+           case "diffusion":[39m
[31m+             node.setParameter("diffusion", v);[39m
[31m+             break;[39m
[31m+           case "mod":[39m
[31m+             node.setParameter("mod", v);[39m
[31m+             break;[39m
[31m+           case "mix":[39m
[31m+             mix.setMix(v, when);[39m
[31m+             break;[39m
[31m+         }[39m
[31m+       };[39m
[31m+       for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+       return {[39m
[31m+         input: mix.input,[39m
[31m+         output: mix.output,[39m
[31m+         setParameter: (id, v) => apply(id, v, ctx.currentTime),[39m
[31m+         setParameterAt: (id, v, when) => apply(id, v, when),[39m
[31m+         getAudioParam: (paramId: string) => node.getAudioParam?.(paramId) ?? null,[39m
[31m+         dispose: () => {[39m
[31m+           mix.input.disconnect();[39m
[31m+           mix.output.disconnect();[39m
[31m+           preDelay.disconnect();[39m
[31m+           node.dispose();[39m
[31m+         },[39m
[31m+       };[39m
[31m+     }[39m
[31m+     // Fallback: convolution IR (degraded — no FDN, CPU spikes on decay change)[39m
[31m+     const mix = mixBus(ctx);[39m
[31m+     mix.setMix(instance.params.mix ?? 0.3, ctx.currentTime);[39m
[31m+     const preDelay = ctx.createDelay(0.5);[39m
[31m+     const conv = ctx.createConvolver();[39m
[31m+     const tone = ctx.createBiquadFilter();[39m
[31m+     tone.type = "lowpass";[39m
[31m+     mix.wet.connect(preDelay).connect(conv).connect(tone).connect(mix.output);[39m
[31m+     const seed = hashString(instance.id);[39m
[31m+     let worker: Worker | null = null;[39m
[31m+     try {[39m
[31m+       worker = new Worker(new URL("../audio-workers/ir-generator.ts", import.meta.url), { type: "module" });[39m
[31m+       worker.onmessage = (e: MessageEvent<{ left: Float32Array; right: Float32Array; length: number }>) => {[39m
[31m+         const { left, right, length } = e.data;[39m
[31m+         const buffer = ctx.createBuffer(2, length, ctx.sampleRate);[39m
[31m+         buffer.copyToChannel(left as Float32Array<ArrayBuffer>, 0);[39m
[31m+         buffer.copyToChannel(right as Float32Array<ArrayBuffer>, 1);[39m
[31m+         conv.buffer = buffer;[39m
[31m+       };[39m
[31m+     } catch {[39m
[31m+       // Worker not available — sync fallback[39m
[31m+     }[39m
[31m+     const apply = (id: string, v: number, when: number) => {[39m
[31m+       switch (id) {[39m
[31m+         case "decay":[39m
[31m+           if (worker) worker.postMessage({ decay: v, sampleRate: ctx.sampleRate, seed });[39m
[31m+           else conv.buffer = makeImpulseResponse(ctx, v, seed);[39m
[31m+           break;[39m
[31m+         case "predelay":[39m
[31m+           smooth(preDelay.delayTime, v / 1000, when, 0.05);[39m
[31m+           break;[39m
[31m+         case "tone":[39m
[31m+         case "damping":[39m
[31m+           smooth(tone.frequency, v, when);[39m
[31m+           break;[39m
[31m+         case "diffusion":[39m
[31m+           break;[39m
[31m+         case "mix":[39m
[31m+           mix.setMix(v, when);[39m
[31m+           break;[39m
[31m+       }[39m
[31m+     };[39m
[31m+     for (const [k, v] of Object.entries(instance.params)) apply(k, v, ctx.currentTime);[39m
[31m+     return {[39m
[31m+       input: mix.input,[39m
[31m+       output: mix.output,[39m
[31m+       degraded: true,[39m
[31m+       degradedReason: "Fallback convolution — FDN unavailable",[39m
[31m+       setParameter: (id, v) => apply(id, v, ctx.currentTime),[39m
[31m+       setParameterAt: (id, v, when) => apply(id, v, when),[39m
[31m+       getAudioParam: (paramId: string) => {[39m
[31m+         switch (paramId) {[39m
[31m+           case "predelay":[39m
[31m+             return preDelay.delayTime;[39m
[31m+           case "tone":[39m
[31m+           case "damping":[39m
[31m+             return tone.frequency;[39m
[31m+           default:[39m
[31m+             return null;[39m
[31m+         }[39m
[31m+       },[39m
[31m+       dispose: () => {[39m
[31m+         worker?.terminate();[39m
[31m+         mix.input.disconnect();[39m
[31m+         mix.output.disconnect();[39m
[31m+         preDelay.disconnect();[39m
[31m+         conv.disconnect();[39m
[31m+         tone.disconnect();[39m
[31m+       },[39m
[31m+     };[39m
[31m+   },[39m
[31m+ };[39m
[31m+[39m
[31m+ /* ---------------- Delay ---------------- */[39m
[31m+ // Stereo tempo-aware worklet (damped loop, ping-pong, BPM sync); the legacy[39m
[31m+ // DelayNode graph survives as the degraded fallback.[39m
[31m+[39m
[31m+ function delayNativeFallback(ctx: BaseAudioContext, instance: EffectInstance): EffectRuntime {[39m
[31m+   const mix = mixBus(ctx);[39m
[31m+   const delayNode = ctx.createDelay(2);[39m
[31m+   const feedback = ctx.createGain();[39m
[31m+   const damp = ctx.createBiquadFilter();[39m
[31m+   damp.type = "lowpass";[39m
[31m+   mix.wet.connect(delayNode);[39m
[31m+   delayNode.connect(damp).connect(feedback).connect(delayNode);[39m
[31m+   delayNode.connect(mix.output);[39m
[31m+   const apply = (id: string, v: number, when: number) => {[39m
[31m+     switch (id) {[39m
[31m+       case "time":[39m
[31m+         smooth(delayNode.delayTime, v / 1000, when, 0.05);[39m
[31m+         break;[39m
