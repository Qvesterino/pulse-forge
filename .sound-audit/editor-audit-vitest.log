[31m+ const sidechain: EffectDefinition = {[39m
[31m+   type: "sidechain",[39m
[31m+   name: "Sidechain",[39m
[31m+   category: "dynamics",[39m
[31m+   params: sidechainParams,[39m
[31m+   factory(ctx, instance) {[39m
