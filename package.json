{
  "name": "pulse-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "productName": "KYX",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-size.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:clean": "node -e \"try{require('fs').unlinkSync('tsconfig.tsbuildinfo')}catch{try{require('fs').unlinkSync('./tsconfig.tsbuildinfo')}catch{}}\" && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ai:baseline": "vite-node scripts/ai-baseline.mts",
    "ai:baseline:browser": "node scripts/ai-baseline-browser.mjs",
    "ai:performance": "vite-node scripts/ai-performance.mts",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:browser:factory-presets": "node scripts/verify-factory-presets.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test 01-landing-to-studio 02-panel-toggles 03-generate-flow 04-persistence-roundtrip",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "curated:seeds": "node scripts/render-curated-seeds.mjs",
    "presets:loudness": "node scripts/measure-preset-loudness.mjs",
    "presets:fx-loudness": "node scripts/measure-fx-preset-loudness.mjs",
    "ranker:train": "vite-node scripts/generate-intent-ranker-dataset.mts && node scripts/validate-intent-ranker-golden.mjs && python scripts/train-intent-ranker.py && node scripts/validate-intent-ranker.mjs",
    "ranker:golden:validate": "node scripts/validate-intent-ranker-golden.mjs",
    "prior:train": "vite-node scripts/generate-symbolic-prior-dataset.mts && python scripts/train-symbolic-prior.py --augmented scripts/data/augmented-drum-dataset.json && node scripts/validate-symbolic-prior.mjs",
    "prior:v2": "vite-node scripts/generate-symbolic-prior-dataset.mts && python scripts/train-symbolic-prior.py --embedding scripts/data/style-embeddings.json --augmented scripts/data/augmented-drum-dataset.json && node scripts/validate-symbolic-prior.mjs v2",
    "prior:v3": "vite-node scripts/generate-symbolic-prior-dataset.mts && python scripts/train-symbolic-prior.py --embedding scripts/data/style-embeddings.json --hybrid --augmented scripts/data/augmented-drum-dataset.json && node scripts/validate-symbolic-prior.mjs v3",
    "prior:melodic": "vite-node scripts/generate-symbolic-melodic-dataset.mts && python scripts/train-symbolic-melodic.py --augmented scripts/data/augmented-melodic-dataset.json && node scripts/validate-symbolic-melodic.mjs",
    "prior:melodic:v2": "vite-node scripts/generate-symbolic-melodic-dataset.mts && python scripts/train-symbolic-melodic.py --embedding scripts/data/style-embeddings.json --augmented scripts/data/augmented-melodic-dataset.json && node scripts/validate-symbolic-melodic.mjs v2",
    "pca:module": "node scripts/generate-pca-projection-module.mjs",
    "prior:favorites": "vite-node scripts/export-favorites-training.mts",
    "favorites:retrain": "vite-node scripts/export-favorites-training.mts",
    "semantic:fetch": "node scripts/fetch-semantic-model.mjs",
    "semantic:smoke": "vite-node scripts/smoke-semantic.mts",
    "audio:fetch": "node scripts/fetch-audio-model.mjs",
    "embedding:train": "npx vite-node scripts/train-embedding-prior.mts",
    "embedding:ab": "vite-node scripts/shadow-embedding-ab.mts",
    "listening:v1v3": "node scripts/render-v1v3-listening.mjs",
    "rerank:fit": "node scripts/fit-rerank-weights.mjs",
    "ranker:golden-template": "vite-node scripts/generate-golden-template.mts",
    "ranker:ort-sync": "node scripts/sync-ort-assets.mjs",
    "ranker:activate": "node scripts/activate-intent-ranker.mjs",
    "test:browser:production": "node scripts/verify-production-browser.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:server-smoke": "node scripts/release-server-smoke.mjs",
    "release:deployed-smoke": "node scripts/release-deployed-smoke.mjs",
    "preview": "vite preview",
    "collab": "node server/collab-server.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/desktop-package.mjs",
    "desktop:build:mac:mrt2": "node scripts/desktop-package-mrt2-mac.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "build:mrt2-native-host": "node scripts/build-mrt2-native-host.mjs",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "prepare": "node scripts/setup-hooks.mjs",
    "build:fxeq": "node scripts/build-fxeq-worklet.mjs",
    "predev": "npm run build:core-worklets && npm run build:fxeq && npm run build:ultina && npm run build:ozvena && npm run build:morph-dynamics",
    "prebuild": "npm run build:core-worklets && npm run build:fxeq && npm run build:ultina && npm run build:ozvena && npm run build:morph-dynamics",
    "build:core-worklets": "node scripts/build-core-worklets.mjs",
    "build:ultina": "node scripts/build-ultina-worklet.mjs",
    "build:ozvena": "node scripts/build-ozvena-worklet.mjs",
    "ranker:golden": "vite-node scripts/generate-intent-ranker-golden.mts",
    "ranker:review-pack": "node scripts/render-golden-review-pack.mjs",
    "video:beat": "node scripts/make-promo-beat.mjs",
    "video:promo": "remotion render remotion/index.ts PulseForgePromo out/pulse-forge-promo.mp4 --codec=h264 --public-dir=./remotion/public",
    "video:stills": "remotion still remotion/index.ts PulseForgePromo remotion/qa/preview.png --frame=700 --public-dir=./remotion/public",
    "references:genres": "node scripts/measure-genre-references.mjs",
    "listening:morph": "vite-node scripts/render-morph-listening.mjs",
    "listening:serve": "node scripts/serve-listening.mjs",
    "listening:room": "vite-node scripts/render-listening-room.mjs",
    "listening:ingest": "node scripts/ingest-listening-verdicts.mjs",
    "taste:train": "node scripts/train-my-taste.mjs",
    "goldens:capture": "vite-node scripts/capture-domain-goldens.mts",
    "build:morph-dynamics": "node scripts/build-morph-dynamics-worklet.mjs",
    "ecosystem:sync": "node scripts/sync-to-qvester.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@huggingface/transformers": "^4.3.0",
    "electron-updater": "^6.8.9",
    "lz-string": "^1.5.0",
    "onnxruntime-web": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.525",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "remotion": "^4.0.525",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8",
    "ws": "^8.21.3"
  }
}
