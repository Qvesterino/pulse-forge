{
  "name": "pulse-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:clean": "node -e \"try{require('fs').unlinkSync('tsconfig.tsbuildinfo')}catch{try{require('fs').unlinkSync('./tsconfig.tsbuildinfo')}catch{}}\" && tsc --noEmit --incremental false",
    "test": "vitest run",
    "ai:baseline": "vite-node scripts/ai-baseline.mts",
    "ai:baseline:browser": "node scripts/ai-baseline-browser.mjs",
    "ai:performance": "vite-node scripts/ai-performance.mts",
    "test:browser": "node scripts/verify-browser.mjs",
    "preview": "vite preview",
    "collab": "node server/collab-server.mjs",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "prepare": "node scripts/setup-hooks.mjs",
    "build:fxeq": "node scripts/build-fxeq-worklet.mjs",
    "predev": "npm run build:fxeq && npm run build:ultina",
    "prebuild": "npm run build:fxeq && npm run build:ultina",
    "build:ultina": "node scripts/build-ultina-worklet.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^2.3.0",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8",
    "ws": "^8.21.3"
  }
}
