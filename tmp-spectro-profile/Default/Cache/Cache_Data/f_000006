const __vite__css = "/* Cascade entry — split from src/styles.css (12 579 lines) by scripts/split-styles.mjs.\n   Files are imported in the ORIGINAL cascade order; reordering changes\n   specificity resolution, so treat the sequence below as load-bearing. */\n:root {\n  /* Molten — the default identity. These values mirror THEME_PRESETS[0]\n     (\"Molten\") in src/ui/theme.ts so the very first paint (before\n     initTheme() runs) already wears the branded palette. Changing one\n     without the other is a bug. */\n  --bg: #0b0c10;\n  --bg-panel: #12141a;\n  --bg-panel-2: #181b22;\n  --bg-raise: #1f232b;\n  --border: #2a2e37;\n  --border-soft: #20242c;\n  --text: #d9dbe1;\n  --text-dim: #8d94a2;\n  --text-faint: #7a8290;\n  --accent: #f59e0b;\n  --accent-soft: rgba(245, 158, 11, 0.14);\n  --play: #4ade80;\n  --stop: #f87171;\n  --mono: \"Cascadia Code\", \"JetBrains Mono\", Consolas, \"SF Mono\", monospace;\n  --sans: Inter, \"Segoe UI\", system-ui, sans-serif;\n  --glass-scene: rgba(255, 255, 255, 0.035);\n  --glass-scene-strong: rgba(255, 255, 255, 0.07);\n  --glass-scene-stroke: rgba(255, 255, 255, 0.1);\n  /* Sequencer label column — mirrors STEPS_LABEL_PX in Sequencer.tsx. */\n  --steps-label: 168px;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml,\nbody,\n#root {\n  height: 100%;\n  margin: 0;\n}\n\nbody {\n  background: var(--bg);\n  color: var(--text);\n  font-variant-numeric: tabular-nums;\n  font-family: var(--sans);\n  font-size: 13px;\n  overflow: hidden;\n  user-select: none;\n}\n\nbutton {\n  font-family: inherit;\n  color: inherit;\n  background: none;\n  border: none;\n  cursor: pointer;\n}\n\n.app {\n  height: 100%;\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  display: grid;\n  grid-template-rows: 48px minmax(0, 1fr) auto auto 26px;\n}\n\n/* ---------- Top bar ---------- */\n\n.topbar {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n  position: relative;\n  z-index: 80;\n  overflow: visible;\n  gap: 10px;\n  padding: 0 14px;\n  background: linear-gradient(180deg, var(--bg-panel), color-mix(in srgb, var(--bg-panel) 88%, #000));\n  border-bottom: 1px solid var(--border);\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.04),\n    0 1px 12px rgba(0, 0, 0, 0.35);\n}\n\n.brand {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  flex-shrink: 0;\n}\n\n.brand-mark {\n  display: grid;\n  place-items: center;\n  width: 26px;\n  height: 26px;\n  background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 78%, #fff), var(--accent));\n  color: #141008;\n  font-family: var(--mono);\n  font-weight: 700;\n  font-size: 11px;\n  border-radius: 5px;\n  letter-spacing: -0.5px;\n  box-shadow:\n    0 0 12px color-mix(in srgb, var(--accent) 45%, transparent),\n    inset 0 1px 0 rgba(255, 255, 255, 0.35);\n}\n\n.brand-name {\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 2.5px;\n  color: var(--text);\n  text-shadow: 0 0 12px color-mix(in srgb, var(--accent) 25%, transparent);\n}\n\n.transport-cluster {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 3px 9px;\n  border-left: 1px solid var(--border-soft);\n  border-right: 1px solid var(--border-soft);\n  /* Recessed console plate: the transport reads as one instrument cluster. */\n  background: rgba(0, 0, 0, 0.16);\n  border-radius: 8px;\n  box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.35);\n  /* Anchor for the floating song-mode guard chip (.mode-hint). */\n  position: relative;\n}\n\n.btn {\n  display: inline-grid;\n  place-items: center;\n  min-width: 34px;\n  height: 30px;\n  padding: 0 10px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  font-size: 12px;\n  color: var(--text-dim);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);\n  transition:\n    background 0.12s,\n    color 0.12s,\n    border-color 0.12s,\n    box-shadow 0.12s;\n}\n\n.btn:hover {\n  color: var(--text);\n  border-color: #343945;\n}\n\n.btn-play {\n  color: var(--play);\n  font-size: 13px;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);\n}\n\n.btn-play.active {\n  background: rgba(74, 222, 128, 0.14);\n  border-color: rgba(74, 222, 128, 0.55);\n  color: #86efac;\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.1),\n    0 0 14px rgba(74, 222, 128, 0.45);\n  text-shadow: 0 0 8px rgba(74, 222, 128, 0.8);\n}\n\n/* MIDI record arm — red dot, pulses while armed so the state is unmistakable\n   mid-take. */\n.btn-record {\n  color: #f87171;\n  font-size: 12px;\n}\n\n.btn-record.armed {\n  background: rgba(248, 113, 113, 0.16);\n  border-color: #f87171;\n  color: #fecaca;\n  box-shadow: 0 0 12px rgba(248, 113, 113, 0.5);\n  animation: record-arm-pulse 1.1s ease-in-out infinite alternate;\n}\n\n@keyframes record-arm-pulse {\n  from {\n    background: rgba(248, 113, 113, 0.1);\n  }\n  to {\n    background: rgba(248, 113, 113, 0.32);\n  }\n}\n\n.rec-option {\n  height: 30px;\n  max-width: 96px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text-dim);\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.4px;\n}\n\n.btn-countin.active,\n.btn-preroll.active,\n.btn-metronome.active {\n  background: var(--accent-soft);\n  border-color: rgba(245, 158, 11, 0.45);\n  color: var(--accent);\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.06),\n    0 0 10px color-mix(in srgb, var(--accent) 30%, transparent);\n}\n\n.btn-stop {\n  color: var(--stop);\n}\n\n.btn-history {\n  min-width: 28px;\n  width: 28px;\n  height: 26px;\n  padding: 0;\n  font-size: 14px;\n  line-height: 1;\n  color: var(--text-dim);\n}\n\n.btn-history:hover:not(:disabled) {\n  color: var(--text);\n  border-color: #343945;\n}\n\n.btn-history:disabled {\n  opacity: 0.3;\n}\n\n.btn-ghost.active {\n  background: var(--accent-soft);\n  border-color: rgba(245, 158, 11, 0.45);\n  color: var(--accent);\n}\n\n.btn-small {\n  height: 24px;\n  min-width: 52px;\n  font-size: 10px;\n  letter-spacing: 1px;\n}\