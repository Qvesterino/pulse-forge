keyframes dl-pulse {\n  0%,\n  100% {\n    transform: scaleY(0.3);\n  }\n  50% {\n    transform: scaleY(1);\n  }\n}\n\n/* Marquee — verb strip between hero and facts. */\n\n.dl-marquee {\n  overflow: hidden;\n  border-top: 1px solid var(--border-soft);\n  border-bottom: 1px solid var(--border-soft);\n  background: rgba(245, 158, 11, 0.035);\n}\n\n.dl-marquee-track {\n  display: flex;\n  width: max-content;\n  animation: dl-marquee 28s linear infinite;\n}\n\n.dl-marquee-track > span {\n  display: inline-flex;\n  align-items: center;\n}\n\n.dl-marquee-track em {\n  display: inline-flex;\n  align-items: center;\n  gap: 26px;\n  padding: 13px;\n  font-style: normal;\n  font-family: var(--mono);\n  font-size: 11.5px;\n  letter-spacing: 0.3em;\n  color: var(--text-dim);\n  white-space: nowrap;\n}\n\n.dl-marquee-track em i {\n  width: 5px;\n  height: 5px;\n  background: var(--accent);\n  transform: rotate(45deg);\n  opacity: 0.65;\n}\n\n@keyframes dl-marquee {\n  from {\n    transform: translateX(0);\n  }\n  to {\n    transform: translateX(-50%);\n  }\n}\n\n/* Bento facts. */\n\n.dl-bento {\n  display: grid;\n  grid-template-columns: repeat(6, 1fr);\n  gap: 14px;\n}\n\n.dl-span-4 {\n  grid-column: span 4;\n}\n\n.dl-span-2 {\n  grid-column: span 2;\n}\n\n.dl-bcard {\n  position: relative;\n  overflow: hidden;\n  padding: 22px;\n  border: 1px solid var(--border-soft);\n  border-radius: 16px;\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.012)), var(--bg-panel);\n  transition:\n    border-color 0.16s ease,\n    transform 0.16s ease;\n}\n\n.dl-bcard:hover {\n  transform: translateY(-2px);\n  border-color: rgba(245, 158, 11, 0.35);\n}\n\n.dl-bcard h3 {\n  margin: 14px 0 8px;\n  font-size: 16px;\n  letter-spacing: -0.01em;\n}\n\n.dl-bcard p {\n  margin: 0;\n  font-size: 13.5px;\n  line-height: 1.62;\n  color: var(--text-dim);\n}\n\n.dl-timeline {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin-top: 16px;\n  font-family: var(--mono);\n  font-size: 10.5px;\n  letter-spacing: 0.08em;\n  color: var(--text-faint);\n}\n\n.dl-tl-step {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.dl-tl-step i {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--accent);\n  box-shadow: 0 0 8px rgba(245, 158, 11, 0.6);\n}\n\n.dl-tl-step + .dl-tl-step::before {\n  content: \"\";\n  width: 22px;\n  height: 1px;\n  margin-right: 6px;\n  background: var(--border);\n}\n\n.dl-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 16px;\n}\n\n.dl-chip {\n  padding: 5px 10px;\n  border: 1px solid var(--border);\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.02);\n  font-family: var(--mono);\n  font-size: 10.5px;\n  letter-spacing: 0.08em;\n  color: var(--text-dim);\n}\n\n/* Fine print — dashed, muted, honest. */\n\n.dl-notes {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 14px;\n  margin-top: 14px;\n}\n\n.dl-note {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  margin: 0;\n  padding: 14px 16px;\n  border: 1px dashed var(--border);\n  border-radius: 12px;\n  font-size: 12.5px;\n  line-height: 1.55;\n  color: var(--text-faint);\n}\n\n.dl-note-icon {\n  flex-shrink: 0;\n  margin-top: 1px;\n  color: var(--text-dim);\n}\n\n/* Install steps. */\n\n.dl-steps {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 14px;\n}\n\n.dl-step {\n  padding: 22px;\n  border: 1px solid var(--border-soft);\n  border-radius: 16px;\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent), var(--bg-panel);\n}\n\n.dl-step-num {\n  font-family: var(--mono);\n  font-size: 26px;\n  font-weight: 700;\n  color: rgba(245, 158, 11, 0.55);\n}\n\n.dl-step h3 {\n  margin: 12px 0 6px;\n  font-size: 15.5px;\n}\n\n.dl-step p {\n  margin: 0;\n  font-size: 13px;\n  line-height: 1.6;\n  color: var(--text-dim);\n}\n\n/* CTA panel — bigger presence than the landing's. */\n\n.dl-cta-panel {\n  background: radial-gradient(420px 220px at 18% 0%, rgba(245, 158, 11, 0.12), transparent 70%), var(--bg-panel-2);\n}\n\n@media (max-width: 960px) {\n  .dl-hero {\n    padding: 60px 0 48px;\n  }\n\n  .dl-bento {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .dl-span-4 {\n    grid-column: span 2;\n  }\n\n  .dl-span-2 {\n    grid-column: span 1;\n  }\n\n  .dl-notes {\n    grid-template-columns: 1fr;\n  }\n\n  .dl-steps {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 640px) {\n  .dl-bento {\n    grid-template-columns: 1fr;\n  }\n\n  .dl-span-4,\n  .dl-span-2 {\n    grid-column: auto;\n  }\n\n  .dl-wave {\n    margin-top: 48px;\n  }\n\n  .dl-hero-actions {\n    flex-direction: column;\n    align-items: stretch;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .dl-wave span {\n    animation: none;\n    transform: scaleY(0.75);\n  }\n\n  .dl-btn-hero::after {\n    display: none;\n  }\n\n  .dl-marquee-track,\n  .dl-title-accent {\n    animation: none;\n  }\n}\n\n/* ── Intent candidate audition (INTENT_ENGINE.md A1) ─────────────────── */\n.intent-candidates {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  margin-top: 8px;\n  padding: 6px;\n  border: 1px solid var(--border, #333);\n  border-radius: 8px;\n  background: rgba(0, 0, 0, 0.25);\n}\n\n.intent-candidate-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 3px 4px;\n  border-radius: 6px;\n}\n\n.intent-candidate-row.winner {\n  background: rgba(255, 208, 0, 0.08);\n}\n\n.intent-candidate-meta {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex: 1;\n  min-width: 0;\n  font-size: 11px;\n  opacity: 0.9;\n}\n\n.intent-candidate-index {\n  font-weight: 600;\n  min-width: 22px;\n}\n\n.intent-candidate-source {\n  font-size: 9px;\n  letter-spacing: 0.06em;\n  padding: 1px 5px;\n  border-radius: 999px;\n  border: 1px solid currentColor;\n}\n\n.intent-candidate-source.symbolic-prior {\n  color: #9ecbff;\n}\n\n.intent-candidate-source.template {\n  color: #9fdf9f;\n}\n\n.intent-candidate-win {\n  color: #ffd000;\n  font-size: 10px;\n}\n\n.intent-candidate-fixed {\n  color: #ffb066;\n  font-size: 10px;\n}\n\n.intent-candidate-score {\n  margin-left: auto;\n  font-variant-numeric: tabular-nums;\n  opacity: 0.75;\n}\n\n.intent-audition-btn,\n.intent-use-btn {\n  min-width: 28px;\n  padding: 2px 8px;\n}\n\n.intent-actions {\n  display: flex;\n  gap: 6px;\n}\n\n.intent-actions .intent-generate-btn {\n  flex: 1;\n}\n\n.intent-song-btn {\n  flex: 1;\n  background: linear-gradient(135deg, rgba(158, 203, 255, 0.18), rgba(158, 203, 255, 0.08));\n}\n\n.intent-route-btn {\n  flex: 1;\n  background: linear-gradient(135deg, rgba(255, 208, 0, 0.16), rgba(255, 208, 0, 0.06));\n}\n\n/* Beat Mangler envelope editor (FX expansion): two stacked lanes — VOL\n   (unipolar 0..1) and PITCH (bipolar −24..24 st). Labels ride the left edge. */\n.beatmangler-editor {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 6px 0;\n}\n\n.beatmangler-repeat-controls {\n  display: grid;\n  grid-template-columns: repeat(5, minmax(76px, 1fr));\n  align-items: end;\n  gap: 6px;\n  padding: 7px 8px 8px;\n  border: 1px solid color-mix(in srgb, #c084fc 35%, var(--border-soft));\n  border-radius: 5px;\n  background: color-mix(in srgb, #c084fc 5%, var(--bg-panel));\n}\n\n.beatmangler-repeat-controls .fx-param-select {\n  min-width: 0;\n}\n\n.beatmangler-repeat-controls .slider {\n  min-width: 0;\n}\n\n.beatmangler-repeat-controls select:disabled {\n  opacity: 0.46;\n}\n\n/* Preset shelf: the signature shapes as one-click chips. */\n.beatmangler-shelf {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n  padding-bottom: 4px;\n  border-bottom: 1px solid var(--border-soft);\n}\n\n.beatmangler-preset {\n  letter-spacing: 0.5px;\n  transition:\n    background 0.12s ease,\n    color 0.12s ease;\n}\n\n.beatmangler-preset.active {\n  background: var(--accent-soft);\n  border-color: rgba(245, 158, 11, 0.45);\n  color: var(--accent);\n}\n\n.beatmangler-lane {\n  display: flex;\n  align-items: stretch;\n  gap: 8px;\n}\n\n.beatmangler-lane-label {\n  width: 34px;\n  display: grid;\n  place-items: center;\n  font-size: 9px;\n  letter-spacing: 1px;\n  color: var(--text-faint);\n  cursor: help;\n}\n\n/* Envelope tools row — steps/resize on the left, shape ops on the right. */\n.beatmangler-actions {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 4px;\n  padding-top: 2px;\n}\n\n.beatmangler-actions-label {\n  font-size: 9px;\n  letter-spacing: 1px;\n  color: var(--text-faint);\n  margin-right: 2px;\n}\n\n.beatmangler-actions-divider {\n  width: 1px;\n  align-self: stretch;\n  background: var(--border-soft);\n  margin: 0 4px;\n}\n\n@container bottom-dock-slot (max-width: 620px) {\n  .beatmangler-repeat-controls {\n    grid-template-columns: repeat(3, minmax(72px, 1fr));\n  }\n}\n\n@container bottom-dock-slot (max-width: 400px) {\n  .beatmangler-repeat-controls {\n    grid-template-columns: repeat(2, minmax(72px, 1fr));\n  }\n}\n/* Landing prompt box (viral growth plan A1) — describe → forge → hear.\n   Visual language follows the existing landing section (11-floating…css). */\n\n.landing-hero-player-col {\n  width: 100%;\n  max-width: 460px;\n  justify-self: end;\n}\n\n.landing-prompt {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  padding: 20px;\n  border: 1px solid #2c313c;\n  border-radius: 16px;\n  background: var(--bg-panel);\n  box-shadow:\n    0 24px 70px rgba(0, 0, 0, 0.55),\n    inset 0 1px 0 rgba(255, 255, 255, 0.04);\n}\n\n.landing-prompt-row {\n  display: flex;\n  gap: 10px;\n}\n\n.landing-prompt-input {\n  flex: 1;\n  min-width: 0;\n  padding: 11px 14px;\n  border: 1px solid #2c313c;\n  border-radius: 10px;\n  background: rgba(0, 0, 0, 0.35);\n  color: var(--text);\n  font-size: 14.5px;\n  outline: none;\n  transition: border-color 120ms ease;\n}\n\n.landing-prompt-input::placeholder {\n  color: var(--text-faint);\n}\n\n.landing-prompt-input:focus {\n  border-color: rgba(245, 158, 11, 0.55);\n}\n\n.landing-forge-btn {\n  white-space: nowrap;\n}\n\n.landing-forge-btn:disabled {\n  opacity: 0.45;\n  cursor: default;\n}\n\n.landing-prompt-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 7px;\n}\n\n.landing-chip {\n  padding: 5px 11px;\n  border: 1px solid #2c313c;\n  border-radius: 999px;\n  background: transparent;\n  color: var(--text-dim);\n  font-size: 12px;\n  cursor: pointer;\n  transition:\n    border-color 120ms ease,\n    color 120ms ease;\n}\n\n.landing-chip:hover:not(:disabled) {\n  border-color: rgba(245, 158, 11, 0.5);\n  color: var(--text);\n}\n\n.landing-chip:disabled {\n  opacity: 0.5;\n  cursor: default;\n}\n\n.landing-prompt-hint {\n  margin: 0;\n  font-size: 12.5px;\n  color: var(--text-faint);\n}\n\n.landing-prompt-error {\n  margin: 0;\n  font-size: 13px;\n  color: #f87171;\n}\n\n/* The forged preview reuses the hero player chrome. */\n.landing-prompt .landing-hero-player {\n  display: block;\n  margin-top: 8px;\n}\n\n.landing-prompt .landing-hero-player .embed-root {\n  position: static;\n  height: 250px;\n  border: 1px solid #2c313c;\n  border-radius: 14px;\n  background: var(--bg-panel);\n}\n\n.landing-prompt .landing-hero-player .embed-main {\n  padding: 16px 18px 6px;\n}\n\n.landing-prompt .landing-hero-player .embed-footer {\n  padding: 6px 18px 14px;\n}\n\n.landing-prompt-actions {\n  display: flex;\n  gap: 10px;\n  margin-top: 12px;\n}\n.effect-intent-assistant {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 8px;\n  min-width: 0;\n}\n\n.effect-intent-trigger {\n  color: var(--accent);\n}\n\n.effect-intent-panel {\n  width: 100%;\n  min-width: 0;\n  padding: 10px;\n  border: 1px solid color-mix(in srgb, var(--accent) 42%, var(--border));\n  border-radius: 6px;\n  background: color-mix(in srgb, var(--accent) 5%, var(--bg-panel-2));\n  display: flex;\n  flex-direction: column;\n  gap: 9px;\n}\n\n.effect-intent-heading,\n.effect-intent-change,\n.effect-intent-actions {\