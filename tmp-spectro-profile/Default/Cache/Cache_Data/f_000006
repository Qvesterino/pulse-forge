rm: translateX(-50%);\n  margin-top: 4px;\n  z-index: 30;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  padding: 4px;\n  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.45);\n}\n\n.slider {\n  position: relative;\n}\n\n.value-menu {\n  min-width: 170px;\n}\n\n.project-name {\n  flex: 1;\n  max-width: 280px;\n  min-width: 100px;\n  margin-left: auto;\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 4px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 13px;\n  padding: 5px 8px;\n}\n\n.project-name:hover {\n  border-color: var(--border);\n}\n\n.project-name:focus {\n  outline: none;\n  border-color: var(--accent);\n  background: var(--bg);\n}\n\n.topbar-right {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n  flex: 0 1 auto;\n  gap: 7px;\n  padding-left: 8px;\n  border-left: 1px solid var(--border-soft);\n}\n\n.topbar-overflow {\n  position: relative;\n  flex: 0 0 auto;\n}\n\n.topbar-overflow-trigger {\n  width: 34px;\n  min-width: 34px;\n  padding: 0;\n  font-size: 18px;\n  line-height: 1;\n}\n\n.topbar-overflow-menu {\n  position: absolute;\n  top: calc(100% + 8px);\n  right: 0;\n  z-index: 120;\n  width: 226px;\n  max-height: calc(100vh - 64px);\n  overflow-y: auto;\n  padding: 7px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.48);\n}\n\n.topbar-overflow-section + .topbar-overflow-section {\n  margin-top: 7px;\n  padding-top: 7px;\n  border-top: 1px solid var(--border-soft);\n}\n\n.topbar-overflow-heading {\n  padding: 3px 8px 5px;\n  color: var(--text-faint);\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 1.4px;\n}\n\n.topbar-overflow-item {\n  display: flex;\n  align-items: center;\n  width: 100%;\n  min-height: 30px;\n  padding: 0 8px;\n  color: var(--text-dim);\n  border: 1px solid transparent;\n  border-radius: 4px;\n  font-size: 11px;\n  text-align: left;\n}\n\n.topbar-overflow-item:hover,\n.topbar-overflow-item:focus-visible,\n.topbar-overflow-item.active {\n  color: var(--text);\n  background: var(--accent-soft);\n  border-color: rgba(245, 158, 11, 0.35);\n}\n\n.topbar-overflow-item.active {\n  color: var(--accent);\n}\n\n.save-status {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 1px;\n  color: var(--text-faint);\n}\n\n.save-saved {\n  color: var(--play);\n}\n\n.save-dirty {\n  color: var(--accent);\n}\n\n.save-error {\n  color: var(--stop);\n}\n\n/* ---------- Workspace ---------- */\n\n.workspace {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 280px;\n  min-height: 0;\n}\n\n/* Tablet band (768–1100px): the fixed 280px inspector left the sequencer\n   ~460px wide, which its 168px label column + 22px step floor cannot fit.\n   Narrow the inspector first; it becomes a row below 860px (see the\n   max-width: 760px block for the phone presentation). */\n@media (max-width: 1100px) {\n  .workspace {\n    grid-template-columns: minmax(0, 1fr) 230px;\n  }\n}\n\n@media (max-width: 860px) {\n  .workspace {\n    grid-template-columns: 1fr;\n    grid-template-rows: minmax(0, 1fr) auto;\n  }\n\n  .workspace > .inspector {\n    max-height: 34vh;\n    overflow-y: auto;\n    border-left: none;\n    border-top: 1px solid var(--border);\n  }\n}\n\n.workspace-main {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  padding: 12px;\n  gap: 8px;\n}\n\n.workspace-main > .sequencer {\n  flex: 1;\n  min-height: 0;\n}\n\n/* ---------- Rack ---------- */\n\n.rack-wrap {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.track-tabs {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.track-tab {\n  height: 26px;\n  padding: 0 14px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.5px;\n  color: var(--text-dim);\n}\n\n.track-tab:hover {\n  color: var(--text);\n}\n\n.track-tab.active {\n  background: var(--accent-soft);\n  border-color: rgba(245, 158, 11, 0.5);\n  color: var(--accent);\n}\n\n.track-tab-rename {\n  height: 26px;\n  padding: 0 10px;\n  background: var(--bg);\n  border: 1px solid var(--accent);\n  border-radius: 4px;\n  font-family: inherit;\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.5px;\n  color: var(--text);\n  outline: none;\n  min-width: 120px;\n}\n\n.track-add {\n  min-width: 76px;\n}\n\n.rack {\n  display: grid;\n  grid-template-columns: repeat(8, 1fr);\n  gap: 6px;\n}\n\n/* Top chrome row: track tabs (leading) + live Note Repeat controls, one row\n   instead of two above the pad grid. */\n.rack-header {\n  grid-column: 1 / -1;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n  row-gap: 4px;\n  padding: 2px 2px;\n}\n\n.rack-header-controls {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n  row-gap: 4px;\n}\n\n.rack-header-divider {\n  width: 1px;\n  align-self: stretch;\n  background: var(--border-soft);\n}\n\n@media (max-width: 1450px) {\n  .rack-header-hint {\n    display: none;\n  }\n}\n\n.rack-header-title {\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 1px;\n  color: var(--text-faint);\n}\n\n.rack-header-field {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--text-faint);\n}\n\n.rack-header-field select {\n  font-family: var(--mono);\n  font-size: 10px;\n  background: var(--bg-panel-2);\n  color: var(--text);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  padding: 1px 3px;\n}\n\n.rack-header-toggle {\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--text-faint);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  background: transparent;\n  padding: 2px 6px;\n  cursor: pointer;\n}\n\n.rack-header-toggle.active {\n  color: var(--accent);\n  border-color: var(--accent);\n  background: rgb(96 165 250 / 0.12);\n}\n\n.rack-header-hint {\n  margin-left: auto;\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--text-faint);\n  opacity: 0.7;\n}\n\n/* Pad keys editor + colour swatches (per-pad customisation). */\n.pad-keys-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 4px;\n  margin-bottom: 6px;\n}\n\n.pad-key-slot {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--text);\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  padding: 3px 5px;\n  cursor: pointer;\n}\n\n.pad-key-slot.capturing {\n  border-color: var(--accent);\n  background: var(--accent-soft);\n  color: var(--accent);\n}\n\n.pad-key-index {\n  color: var(--text-faint);\n  font-size: 8px;\n}\n\n.pad-color-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px;\n  align-items: center;\n  padding: 2px 0 6px;\n}\n\n.pad-color-swatch {\n  width: 18px;\n  height: 18px;\n  border-radius: 4px;\n  border: 1px solid rgb(255 255 255 / 0.3);\n  cursor: pointer;\n}\n\n.pad-color-swatch:hover {\n  transform: scale(1.12);\n}\n\n.pad-color-auto {\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--text-dim);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  background: var(--bg-panel-2);\n  padding: 3px 6px;\n  cursor: pointer;\n}\n\n/* Track colour dot (user-set track colour). */\n.track-color-dot {\n  display: inline-block;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  border: 1px solid rgb(255 255 255 / 0.35);\n  margin-right: 4px;\n  flex: none;\n}\n\n/* Pinned per-pad repeat rate chip (kick 1/16, hat 1/8T …). */\n.pad-rate-badge {\n  position: absolute;\n  top: 2px;\n  right: 3px;\n  font-family: var(--mono);\n  font-size: 8px;\n  color: var(--accent);\n  background: rgb(0 0 0 / 0.45);\n  border: 1px solid var(--accent) 66;\n  border-radius: 3px;\n  padding: 0 2px;\n  line-height: 1.3;\n  pointer-events: none;\n}\n\n.track-tab-badge,\n.track-header-badge {\n  display: inline-block;\n  margin-right: 6px;\n  padding: 1px 4px;\n  background: var(--bg);\n  border-radius: 3px;\n  font-family: var(--mono);\n  font-size: 8px;\n  letter-spacing: 0.5px;\n  color: var(--text-faint);\n  vertical-align: middle;\n}\n\n.track-header-badge {\n  font-size: 9px;\n}\n\n.pad {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 2px;\n  padding: 7px 8px;\n  min-height: 44px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-left: 3px solid var(--pad-color, var(--border));\n  border-radius: 4px;\n  text-align: left;\n  transition:\n    background 0.1s,\n    transform 0.05s;\n}\n\n.pad:hover {\n  background: var(--bg-panel-2);\n}\n\n.pad:active {\n  transform: translateY(1px);\n}\n\n.pad.selected {\n  background: var(--bg-raise);\n  border-color: #3a4050;\n  border-left-color: var(--pad-color, var(--accent));\n}\n\n.pad.hit {\n  background: color-mix(in srgb, var(--pad-color, var(--accent)) 26%, var(--bg-panel));\n}\n\n.pad-index {\n  font-family: var(--mono);\n  font-size: 8px;\n  color: var(--text-faint);\n}\n\n.pad-name {\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  max-width: 100%;\n}\n\n.pad-synth-badge {\n  font-family: var(--mono);\n  font-size: 7px;\n  letter-spacing: 0.6px;\n  color: var(--text-faint);\n  background: rgba(255, 255, 255, 0.07);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: 2px;\n  padding: 1px 3px;\n  margin-top: 2px;\n  line-height: 1;\n}\n\n.pad-meter {\n  position: absolute;\n  right: 4px;\n  top: 6px;\n  bottom: 6px;\n  width: 3px;\n  background: rgba(255, 255, 255, 0.06);\n  border-radius: 2px;\n  overflow: hidden;\n  pointer-events: none;\n}\n\n.pad-meter-fill {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: var(--pad-color, var(--accent));\n  opacity: 0.9;\n  transition: height 0.08s linear;\n  border-radius: 2px;\n}\n/* ---------- Sequencer ---------- */\n\n.sequencer {\n  min-height: 0;\n  /* Anchor for the absolutely-positioned p-lock selection toolbar. */\n  position: relative;\n  overflow: auto;\n  contain: layout style;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  padding: 8px 10px 10px;\n}\n\n/* The sequencer's single top chrome row: pattern title + FOCUS toggle live\n   in the ruler's 168px label cell, aligned with the step columns. */\n.ruler-label {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  min-width: 0;\n  padding-right: 6px;\n  /* Corner cell: the ruler lives inside the scroll container now, so the\n     label pins horizontally while the ticks scroll under it. */\n  position: sticky;\n  left: 0;\n  z-index: 11;\n  background: var(--bg-panel);\n}\n\n.ruler-label-title {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  color: var(--text-dim);\n  font-family: var(--mono);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n}\n\n.sequencer-ruler .beat-focus-toggle {\n  flex: 0 0 auto;\n  min-width: 0;\n  height: 18px;\n  padding: 0 7px;\n  font-size: 9px;\n  letter-spacing: 0.5px;\n}\n\n.beat-focus-toggle {\n  flex: 0 0 auto;\n  min-width: 92px;\n  color: var(--accent);\n  border-color: rgba(245, 158, 11, 0.35);\n}\n\n.sequencer.beat-focus {\n  position: fixed;\n  inset: 48px 0 26px;\n  z-index: 75;\n  display: flex;\n  flex-direction: column;\n  padding: 12px 16px 16px;\n  overflow: auto;\n  background: var(--bg);\n  border: 0;\n  border-radius: 0;\n  box-shadow: 0 16px 44px rgba(0, 0, 0, 0.45);\n}\n\n/* Beat focus: the ruler bar is the single sticky chrome — it inherits the\n   accent title and full-height scroll like the old focus bar did. */\n.sequencer.beat-focus .ruler-label-title {\n  color: var(--accent);\n}\n\n.sequencer.beat-focus .sequencer-scroll {\n  flex: 1 1 auto;\n  min-height: 0;\n  max-height: none !important;\n}\n\n.sequencer.beat-focus .sequencer-ruler {\n  background: var(--bg);\n}\n\n.sequencer-ruler {\n  display: grid;\n  align-items: center;\n  gap: 4px;\n  margin-bottom: 4px;\n  padding-bottom: 3px;\n  position: sticky;\n  top: 0;\n  z-index: 10;\n  background: var(--bg-panel);\n  /* Hairline anchor: the sticky bar stays visually separated from the rows\n     scrolling underneath it. */\n  border-bottom: 1px solid var(--border-soft);\n  box-shadow: 0 4px 6px -4px rgba(0, 0, 0, 0.5);\n}\n\n.ruler-tick {\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--text-faint);\n  text-align: center;\n  padding: 2px 0;\n  border-radius: 2px;\n}\n\n.ruler-tick.beat-start {\n  color: var(--text-dim);\n}\n\n.ruler-tick.current {\n  color: var(--accent);\n  background: var(--accent-soft);\n}\n\n.sequencer-row {\n  display: grid;\n  grid-template-columns: var(--steps-label, 168px) 1fr;\n  gap: 4px;\n  margin-bottom: 4px;\n}\n\n/* Row tracking: sweeping the grid highlights the pad row under the cursor. */\n.sequencer-row:hover {\n  background: rgba(255, 255, 255, 0.02);\n  border-radius: 4px;\n}\n\n.track-header-row {\n  display: grid;\n  grid-template-columns: var(--steps-label, 168px) 1fr;\n  gap: 4px;\n  margin: 4px 0 4px;\n}\n\n.track-header-row:first-of-type {\n  margin-top: 2px;\n}\n\n.track-header {\n  display: flex;\n  align-items: stretch;\n  gap: 3px;\n  padding: 2px;\n}\n\n.track-header-name {\n  flex: 1;\n  min-width: 0;\n  text-align: left;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 1.2px;\n  color: var(--text-dim);\n  padding: 4px 8px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.track-header-name:hover {\n  color: var(--text);\n}\n\n.track-header-row.selected .track-header-name {\n  color: var(--accent);\n  border-color: rgba(245, 158, 11, 0.4);\n}\n\n.track-header-spacer {\n  grid-column: 2 / -1;\n  border-top: 1px solid var(--border-soft);\n  margin-top: 12px;\n}\n\n.sequencer-row.selected .row-label {\n  background: var(--bg-raise);\n  border-radius: 4px;\n}\n\n.row-label {\n  display: flex;\n  align-items: stretch;\n  gap: 3px;\n  padding: 2px;\n}\n\n.row-pad {\n  flex: 1;\n  min-width: 0;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-left: 3px solid var(--pad-color, var(--border));\n  border-radius: 4px;\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text);\n  padding: 5px 8px;\n  text-align: left;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);\n  transition:\n    background 0.12s ease,\n    box-shadow 0.12s ease;\n}\n\n.row-pad:hover {\n  background: var(--bg-raise);\n  filter: brightness(1.1);\n}\n\n.row-pad.selected {\n  background: var(--bg-raise);\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.06),\n    0 0 10px color-mix(in srgb, var(--pad-color, var(--accent)) 28%, transparent);\n}\n\n.row-toggle {\n  width: 22px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--text-faint);\n}\n\n.row-toggle:hover {\n  color: var(--text);\n}\n\n.row-toggle.active-mute {\n  color: var(--stop);\n  border-color: rgba(248, 113, 113, 0.5);\n  background: rgba(248, 113, 113, 0.1);\n}\n\n.row-toggle.active-solo {\n  color: var(--accent);\n  border-color: rgba(245, 158, 11, 0.5);\n  background: var(--accent-soft);\n}\n\n.row-steps {\n  display: grid;\n  gap: 4px;\n}\n\n.step {\n  position: relative;\n  height: 30px;\n  background: var(--bg);\n  border: 1px solid var(--border-soft);\n  border-radius: 5px;\n  transition:\n    background 0.08s,\n    box-shadow 0.12s ease,\n    border-color 0.12s ease;\n}\n\n.step.beat-start {\n  border-left: 1px solid #333947;\n}\n\n.step:hover {\n  background: var(--bg-panel-2);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);\n}\n\n.step.active {\n  /* Kit colour per row (kicks vs snares vs hats…) with velocity as opacity —\n     the grid shows the shape of the beat, amber stays reserved for the\n     playhead and selection. Molten body: lit top edge + soft aura scaled by\n     velocity, so accents visibly burn brighter than ghosts. */\n  background: linear-gradient(\n    180deg,\n    color-mix(in srgb, var(--pad-color, var(--accent)) calc(var(--step-velocity, 0.8) * 88%), #17181c),\n    color-mix(in srgb, var(--pad-color, var(--accent)) calc(var(--step-velocity, 0.8) * 60%), #17181c)\n  );\n  border-color: color-mix(in srgb, var(--pad-color, var(--accent)) 40%, var(--border));\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.16),\n    0 0 12px color-mix(in srgb, var(--pad-color, var(--accent)) calc(var(--step-velocity, 0.8) * 32%), transparent);\n}\n\n/* Continuous playhead sweeping the grid while the transport runs. The steps\n   area starts after the 168px label column + 4px gap; within it the position\n   is linear in the pattern fraction (equal-width step columns). */\n.seq-playhead {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 2px;\n  margin-left: -1px;\n  /* Sweep the scrolled CONTENT width (--grid-steps-px from GridPlayhead),\n     not the viewport — at 256 steps they differ by ~5k px. The label offset\n     must track the same variable the grid columns use (narrow viewports\n     shrink it to 112px). */\n  left: calc(var(--steps-label, 168px) + 4px + var(--playhead-frac, 0) * var(--grid-steps-px, 100%));\n  background: var(--accent);\n  box-shadow:\n    0 0 10px rgba(245, 158, 11, 0.75),\n    0 0 3px rgba(245, 158, 11, 1);\n  border-radius: 1px;\n  pointer-events: none;\n  z-index: 5;\n}\n\n.seq-playhead[data-playing=\"false\"] {\n  display: none;\n}\n\n.step.playhead {\n  box-shadow: inset 0 0 0 1px rgba(245, 158, 11, 0.35);\n}\n\n.step.active.playhead {\n  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.4);\n}\n\n.step.playhead {\n  box-shadow:\n    inset 0 0 0 1px rgba(245, 158, 11, 0.55),\n    0 0 6px rgba(245, 158, 11, 0.35);\n}\n\n.step.active.playhead {\n  box-shadow:\n    inset 0 0 0 1px rgba(255, 255, 255, 0.5),\n    0 0 8px rgba(245, 158, 11, 0.45);\n}\n\n/* Pulsing playhead indicator for the active step */\n@keyframes step-pulse {\n  0%,\n  100% {\n    transform: scale(1);\n  }\n  50% {\n    transform: scale(1.04);\n  }\n}\n\n.step.playhead:not(.active) {\n  animation: step-pulse 0.18s ease-out;\n}\n\n/* Track header hint: highlight when a step on that track is currently playing */\n.track-header-row.playing .track-header-name {\n  border-color: rgba(74, 222, 128, 0.4);\n  color: var(--play);\n}\n\n/* ---------- Inspector ---------- */\n\n.inspector {\n  background: var(--bg-panel);\n  border-left: 1px solid var(--border);\n  padding: 14px;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.panel-title {\n  margin: 0;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 1.8px;\n  color: var(--text-dim);\n}\n\n.field {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.field-label {\n  font-size: 10px;\n  letter-spacing: 1px;\n  color: var(--text-faint);\n}\n\n.inspector select {\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 12px;\n  padding: 6px 8px;\n}\n\n.inspector select:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n/* ---------- Slider ---------- */\n\n.slider {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.slider-disabled {\n  opacity: 0.4;\n}\n\n.slider-header {\n  display: flex;\n  justify-content: space-between;\n}\n\n.slider-label {\n  font-size: 10px;\n  letter-spacing: 1.2px;\n  color: var(--text-faint);\n}\n\n.slider-value {\n  font-family: var(--mono);\n  font-size: 11px;\n  color: var(--text);\n}\n\n.slider-track {\n  position: relative;\n  height: 22px;\n  background: var(--bg);\n  border: 1px solid var(--border-soft);\n  border-radius: 3px;\n  cursor: ew-resize;\n}\n\n.slider-fill {\n  position: absolute;\n  inset: 2px auto 2px 2px;\n  background: linear-gradient(90deg, rgba(245, 158, 11, 0.25), rgba(245, 158, 11, 0.45));\n  border-radius: 2px;\n}\n\n.slider-thumb {\n  position: absolute;\n  top: 2px;\n  bottom: 2px;\n  width: 3px;\n  transform: translateX(-1px);\n  background: var(--accent);\n  border-radius: 1px;\n}\n\n.pad-toggles {\n  display: flex;\n  gap: 6px;\n}\n\n.btn.active-mute {\n  color: var(--stop);\n  border-color: rgba(248, 113, 113, 0.5);\n  background: rgba(248, 113, 113, 0.1);\n}\n\n.btn.active-solo {\n  color: var(--accent);\n  border-color: rgba(245, 158, 11, 0.5);\n  background: var(--accent-soft);\n}\n\n/* ---------- Piano roll ---------- */\n\n.pianoroll-wrap {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.pianoroll-toolbar {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 4px 6px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  flex-wrap: wrap;\n}\n\n.pr-toolbar-count {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.5px;\n  color: var(--accent);\n  min-width: 70px;\n}\n\n.pr-toolbar-group {\n  display: flex;\n  gap: 4px;\n  align-items: center;\n}\n\n.pr-velocity-lane {\n  position: relative;\n  height: 48px;\n  margin-left: 46px;\n  background: var(--bg);\n  border: 1px solid var(--border-soft);\n  border-radius: 4px;\n  overflow: hidden;\n}\n\n.pr-velocity-bg {\n  position: absolute;\n  inset: 0;\n  background: repeating-linear-gradient(\n    to right,\n    transparent 0,\n    transparent 23px,\n    rgba(255, 255, 255, 0.02) 23px,\n    rgba(255, 255, 255, 0.02) 24px\n  );\n  pointer-events: none;\n}\n\n.pr-vel-bar {\n  position: absolute;\n  bottom: 0;\n  width: 8px;\n  margin-left: -4px;\n  background: var(--accent);\n  border-radius: 2px 2px 0 0;\n  opacity: 0.7;\n  cursor: ns-resize;\n  box-shadow: 0 0 6px rgba(245, 158, 11, 0.3);\n  transition: opacity 0.12s ease;\n}\n\n.pr-vel-bar:hover {\n  opacity: 1;\n}\n\n.pr-vel-bar.selected {\n  background: #fff;\n  opacity: 0.9;\n  box-shadow: 0 0 8px rgba(245, 158, 11, 0.7);\n}\n\n.pr-marquee {\n  position: absolute;\n  border: 1px dashed var(--accent);\n  background: rgba(245, 158, 11, 0.12);\n  pointer-events: none;\n  z-index: 5;\n}\n\n.pianoroll {\n  display: flex;\n  border: 1px solid var(--border-soft);\n  border-radius: 4px;\n  overflow: hidden;\n}\n\n.pianoroll-keys {\n  flex: 0 0 46px;\n  display: flex;\n  flex-direction: column;\n  background: var(--bg);\n  border-right: 1px solid var(--border-soft);\n}\n\n.pr-key {\n  display: flex;\n  align-items: center;\n  padding: 0 4px;\n  background: linear-gradient(180deg, #2c313c, #23262e);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);\n  border: none;\n  border-bottom: 1px solid #12141a;\n  color: var(--text-faint);\n  font-family: var(--mono);\n  font-size: 8px;\n  cursor: pointer;\n  transition: filter 0.12s ease;\n}\n\n.pr-key.black {\n  background: linear-gradient(180deg, #191c22, #12141a);\n}\n\n.pr-key.c-key {\n  color: var(--text-dim);\n  background: linear-gradient(180deg, #343a47, #2a2f3a);\n}\n\n.pr-key:hover {\n  filter: brightness(1.25);\n}\n\n.pianoroll-scroll {\n  flex: 1;\n  overflow-y: auto;\n  overflow-x: hidden;\n  max-height: 180px;\n  background: var(--bg);\n}\n\n.pianoroll-grid {\n  position: relative;\n  background-image: repeating-linear-gradient(to bottom, #171a20 0px, #171a20 13px, #12141a 13px, #12141a 14px);\n  cursor: crosshair;\n}\n\n.pr-beatline {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 1px;\n  background: #2c313c;\n  pointer-events: none;\n}\n\n/* Multi-bar pattern orientation (FL-style): stronger line each 16 steps + bar number */\n.pr-barline {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 2px;\n  background: #3d4454;\n  box-shadow: 0 0 4px rgba(255, 255, 255, 0.08);\n  pointer-events: none;\n}\n\n.pr-barnum {\n  position: absolute;\n  top: 1px;\n  left: 4px;\n  font-family: var(--mono);\n  font-size: 9px;\n  font-weight: 700;\n  line-height: 1;\n  letter-spacing: 0.08em;\n  color: #98a0b3;\n  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);\n  pointer-events: none;\n}\n\n.pr-playhead {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  background: rgba(245, 158, 11, 0.09);\n  border-left: 2px solid rgba(245, 158, 11, 0.85);\n  box-shadow:\n    0 0 10px rgba(245, 158, 11, 0.4),\n    inset 0 0 14px rgba(245, 158, 11, 0.12);\n  pointer-events: none;\n}\n\n/* Sequencer gesture cheat sheet — anchored over the grid, dismissible. */\n.cheat-sheet {\n  position: absolute;\n  top: 46px;\n  right: 10px;\n  width: 360px;\n  max-height: calc(100% - 60px);\n  overflow: auto;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-left: 2px solid var(--accent);\n  border-radius: 6px;\n  padding: 10px 12px;\n  z-index: 20;\n  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);\n}\n\n.cheat-sheet-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 8px;\n}\n\n.cheat-sheet-title {\n  font-family: var(--mono);\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 2px;\n  color: var(--accent);\n}\n\n.cheat-sheet-groups {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.cheat-sheet-group {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.cheat-sheet-group-title {\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 1.5px;\n  color: var(--text-faint);\n  margin-bottom: 2px;\n}\n\n.cheat-sheet-row {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 1px 0;\n}\n\n.cheat-sheet-keys {\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--text);\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  padding: 1px 5px;\n  white-space: nowrap;\n}\n\n.cheat-sheet-what {\n  font-size: 10.5px;\n  color: var(--text-dim);\n  text-align: right;\n}\n\n.cheat-toggle.active {\n  border-color: var(--accent);\n  color: var(--accent);\n}\n\n/* Ruler loop region — rAF-positioned overlay, reads transport truth. */\n.ruler-loop-overlay {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  background: rgba(74, 222, 128, 0.14);\n  border-left: 1px solid rgba(74, 222, 128, 0.5);\n  border-right: 1px solid rgba(74, 222, 128, 0.5);\n  pointer-events: none;\n  z-index: 1;\n}\n\n.ruler-loop-overlay[data-visible=\"false\"] {\n  display: none;\n}\n\n/* Performed pad flash — applied via rAF DOM mutation, no re-render. */\n.row-pad.live-hit {\n  border-color: var(--accent);\n  box-shadow: 0 0 8px rgba(245, 158, 11, 0.45);\n  color: var(--accent);\n}\n\n.midi-readout {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.5px;\n  color: var(--accent);\n  padding: 0 2px;\n  white-space: nowrap;\n}\n\n.rec-strength {\n  width: 72px;\n  accent-color: var(--accent);\n}\n\n/* Step-entry cursor — pitch row × entry length, dashed accent box. */\n.pr-step-cursor {\n  position: absolute;\n  border: 1px dashed var(--accent);\n  background: rgba(245, 158, 11, 0.08);\n  border-radius: 3px;\n  pointer-events: none;\n  z-index: 4;\n}\n\n.pr-step-toggle.active-solo {\n  border-color: var(--accent);\n  color: var(--accent);\n}\n\n.pr-step-dur {\n  height: 26px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text-dim);\n  font-family: var(--mono);\n  font-size: 10px;\n}\n\n.pr-note {\n  position: absolute;\n  height: 10px;\n  margin-top: 2px;\n  /* Molten note body: lit top edge fading to a darker base — adapts to any\n     theme accent, velocity still scales through the inline opacity. */\n  background: linear-gradient(\n    180deg,\n    color-mix(in srgb, var(--accent) 72%, #fff) 0%,\n    var(--accent) 45%,\n    color-mix(in srgb, var(--accent) 60%, #000) 100%\n  );\n  border: 1px solid rgba(255, 255, 255, 0.22);\n  border-radius: 3px;\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.3),\n    0 1px 3px rgba(0, 0, 0, 0.45);\n  cursor: grab;\n}\n\n.pr-note.selected {\n  border-color: #fff;\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.4),\n    0 0 0 1px rgba(255, 255, 255, 0.6),\n    0 0 10px color-mix(in srgb, var(--accent) 55%, transparent);\n}\n\n.pr-note:active {\n  cursor: grabbing;\n}\n.pr-note.ghost {\n  background: var(--accent);\n  border-color: rgba(255, 255, 255, 0.15);\n  pointer-events: none;\n}\n.pr-note.ghost-track {\n  background: #7dd3fc;\n  border-color: rgba(125, 211, 252, 0.35);\n  pointer-events: none;\n}\n/* FL slide note (portamento): half-triangle badge on the left edge */\n.pr-note.slide::after {\n  content: \"▲\";\n  position: absolute;\n  left: 1px;\n  top: 50%;\n  transform: translateY(-50%);\n  font-size: 7px;\n  line-height: 1;\n  color: #fff;\n  text-shadow: 0 0 2px rgba(0, 0, 0, 0.8);\n  pointer-events: none;\n}\n\n/* ---------- Pattern bar ---------- */\n\n.pattern-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n\n.pattern-chips {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.pattern-chip {\n  height: 26px;\n  padding: 0 12px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 13px;\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text-dim);\n}\n\n.pattern-chip:hover {\n  color: var(--text);\n}\n\n.pattern-chip.active {\n  background: var(--accent-soft);\n  border-color: rgba(245, 158, 11, 0.5);\n  color: var(--accent);\n}\n\n.pattern-chip.dragging {\n  opacity: 0.4;\n}\n\n.pattern-chips {\n  position: relative;\n}\n\n.pattern-drop-indicator {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 2px;\n  background: var(--accent);\n  border-radius: 1px;\n  pointer-events: none;\n  z-index: 1;\n}\n\n.pattern-rename {\n  height: 26px;\n  padding: 0 12px;\n  background: var(--bg);\n  border: 1px solid var(--accent);\n  border-radius: 13px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 11px;\n  width: 120px;\n}\n\n.pattern-actions {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n}\n\n/* Group divider: pattern lifecycle | creative tools | clipboard | destructive.\n   A thin visual seam — the eye parses groups instead of ten equal buttons. */\n.pattern-actions .action-sep {\n  align-self: stretch;\n  width: 1px;\n  margin: 5px 3px;\n  background: var(--border, rgba(255, 255, 255, 0.12));\n}\n\n.pattern-bar > .scene-launcher {\n  /* Compact chips flow inline after the actions; flex-wrap gives them their\n     own row only when the window is genuinely too narrow. */\n  flex: 0 1 auto;\n  order: 4;\n  width: auto;\n}\n\n.pattern-length {\n  height: 24px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: var(--mono);\n  font-size: 11px;\n  padding: 0 4px;\n}\n/* ---------- Mixer ---------- */\n\n.mixer {\n  contain: layout style;\n  max-height: 170px;\n  overflow-x: auto;\n  overflow-y: hidden;\n  background: var(--bg-panel);\n  border-top: 1px solid var(--border);\n  padding: 10px 14px;\n}\n\n.mixer-strips {\n  display: flex;\n  gap: 10px;\n  height: 100%;\n}\n\n.channel-strip {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  min-width: 190px;\n  padding: 8px;\n  background: linear-gradient(180deg, var(--bg-panel-2), color-mix(in srgb, var(--bg-panel-2) 82%, #000));\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.05),\n    0 2px 10px rgba(0, 0, 0, 0.25);\n  transition:\n    box-shadow 0.14s ease,\n    border-color 0.14s ease;\n}\n\n/* Tag colour bleeds into the strip: lit border + aura + name glow. */\n.channel-strip[data-colored] {\n  border-color: color-mix(in srgb, var(--strip-color) 45%, var(--border));\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.06),\n    0 0 14px color-mix(in srgb, var(--strip-color) 22%, transparent);\n}\n.channel-strip[data-colored] .channel-name-input {\n  color: color-mix(in srgb, var(--strip-color) 55%, var(--text));\n}\n.channel-strip[data-colored] .channel-name-input:focus {\n  border-color: var(--strip-color);\n}\n\n/* Grab-worthy fader caps — the default 3px line was needle-thin to hit. */\n.channel-strip .slider-thumb {\n  width: 12px;\n  transform: translateX(-6px);\n  border-radius: 2px;\n  box-shadow:\n    inset 0 0 0 1px rgba(0, 0, 0, 0.35),\n    0 0 6px rgba(245, 158, 11, 0.25);\n}\n\n.mixer-batch-bar {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  row-gap: 6px;\n  align-items: center;\n  padding: 6px 8px;\n  margin-bottom: 8px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n}\n\n/* Macros live inline on the batch FX toolbar (right side) — no own row.\n   Narrow windows wrap the group under the batch actions via flex-wrap. */\n.mixer-performance-bar {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-left: auto;\n  min-width: 0;\n}\n\n.mixer-performance-toggle {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 0;\n  background: none;\n  border: none;\n  cursor: pointer;\n  color: var(--accent);\n  font: 700 10px var(--mono);\n  letter-spacing: 1px;\n}\n\n.mixer-performance-hint {\n  color: var(--text-faint);\n  font-size: 9px;\n}\n\n.mixer-performance-grid {\n  display: flex;\n  gap: 8px;\n  min-width: 0;\n}\n\n.mixer-macro-control {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  flex: 0 1 230px;\n  min-width: 185px;\n  padding: 3px 7px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border-soft);\n  border-radius: 4px;\n}\n\n/* Comfortable macro rails — the compact 16px default reads as a sliver\n   next to the batch buttons. */\n.mixer-performance-grid .slider-compact .slider-track {\n  height: 22px;\n}\n\n.mixer-macro-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 6px;\n}\n\n.mixer-macro-name,\n.mixer-macro-value {\n  font: 700 10px var(--mono);\n}\n\n.mixer-macro-name {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--text-dim);\n  letter-spacing: 0.8px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.mixer-macro-value {\n  color: var(--accent);\n}\n\n.mixer-macro-control .slider {\n  margin-top: 3px;\n}\n\n.mixer-macro-control .slider-header {\n  display: none;\n}\n\n.mixer-macro-targets {\n  display: block;\n  margin-top: 3px;\n  color: var(--text-faint);\n  font: 9px var(--mono);\n  white-space: nowrap;\n}\n\n.mixer-macro-targets.empty {\n  color: var(--text-faint);\n  opacity: 0.75;\n}\n.mixer-batch-label {\n  font-size: 11px;\n  font-weight: 700;\n  color: var(--text-dim);\n  letter-spacing: 0.5px;\n}\n.channel-strip.drag-over {\n  outline: 2px dashed var(--accent);\n  outline-offset: -2px;\n}\n.channel-strip.selected-strip {\n  outline: 1px solid var(--accent);\n  outline-offset: -1px;\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.06),\n    0 0 16px rgba(245, 158, 11, 0.18);\n}\n.channel-color {\n  width: 18px;\n  height: 18px;\n  border: none;\n  border-radius: 3px;\n  padding: 0;\n  margin-left: 6px;\n  cursor: pointer;\n}\n.fader-menu {\n  position: fixed;\n  z-index: 120;\n  min-width: 190px;\n  background: linear-gradient(180deg, rgba(33, 36, 43, 0.92), rgba(21, 23, 28, 0.94));\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: 10px;\n  padding: 6px;\n  box-shadow:\n    0 16px 48px rgba(0, 0, 0, 0.55),\n    0 0 0 1px rgba(0, 0, 0, 0.4),\n    inset 0 1px 0 rgba(255, 255, 255, 0.07);\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n.fader-menu .context-menu-header {\n  font-size: 10px;\n  color: var(--text-faint);\n  padding: 4px 8px;\n  letter-spacing: 0.5px;\n}\n.fader-menu button {\n  text-align: left;\n  padding: 6px 10px;\n  background: transparent;\n  border: none;\n  color: var(--text);\n  font-size: 12px;\n  border-radius: 6px;\n  cursor: pointer;\n  transition:\n    background 0.12s ease,\n    color 0.12s ease;\n}\n.fader-menu button:hover:not(:disabled) {\n  background: var(--accent-soft);\n  color: var(--accent);\n}\n.fader-menu button:disabled {\n  opacity: 0.4;\n  cursor: default;\n}\n\n.channel-name {\n  display: flex;\n  align-items: center;\n}\n\n.channel-name-input {\n  width: 100%;\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 3px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 11px;\n  font-weight: 600;\n  padding: 3px 6px;\n}\n\n.channel-name-input:hover {\n  border-color: var(--border);\n}\n\n.channel-name-input:focus {\n  outline: none;\n  border-color: var(--accent);\n  background: var(--bg);\n}\n\n.channel-name-label {\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  color: var(--text-dim);\n  padding: 3px 6px;\n}\n\n.master-strip {\n  background: transparent;\n  border-style: dashed;\n  min-width: 90px;\n}\n\n.channel-body {\n  display: flex;\n  gap: 8px;\n  align-items: stretch;\n  min-height: 76px;\n}\n\n.channel-controls {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  justify-content: center;\n}\n\n/* MASTER strip: the IN/CEIL column has a definite width and the stereo meters\n   live inside it (flex:1 here created a huge void left of the metering wall).\n   The strip keeps a floor wide enough for the wall (controls 150 + wall min\n   620) so flex-shrink can never clip it; a definite basis avoids the\n   canvases' broken max-content contribution. NOTE: do NOT flex the body\n   height here — the goniometer's ResizeObserver turns that into a growth\n   loop. The wall's height comes from a min-height clamped to the dock height\n   instead. Scoped to the master — channel strips keep their centered layout. */\n.master-strip {\n  /* 800px was a hard floor on the whole strip, so on a 1280–1440px laptop the\n     channel strips + master could not coexist without horizontal scrolling —\n     the master fader lived off-screen. The wall still needs its width, but it\n     may shrink down to the wall's usable minimum and let the dock scroll as a\n     whole instead of forcing an 800px column. Narrow viewports lower the\n     wall minimums (see the meter media query at the bottom of this file). */\n  flex: 1 1 min(720px, 100%);\n  min-width: min(580px, 100%);\n}\n\n.master-strip .channel-controls {\n  flex: 0 0 auto;\n}\n\n.master-strip .channel-controls {\n  /* Definite width + stretch: IN/CEIL sliders and the stereo meters share the\n     same 150px column (meters narrow enough to read, sliders wide enough to\n     drag). Controls hug the top; MasterStereoMeters fills the rest. */\n  width: 150px;\n  align-items: stretch;\n  justify-content: flex-start;\n  padding-top: 2px;\n  gap: 6px;\n}\n\n/* Four toggles must fit the 150px column in one row — intrinsic button\n   width (52px × 4) overflows it and M/S ends up under the metering wall. */\n.master-strip .master-toggles .btn {\n  flex: 1 1 0;\n  min-width: 0;\n  padding: 0 4px;\n  font-size: 9px;\n  letter-spacing: 0.3px;\n}\n\n.master-strip .meter {\n  height: 56px;\n  align-self: center;\n}\n\n.channel-buttons {\n  display: flex;\n  gap: 5px;\n}\n\n.channel-buttons .btn-small {\n  min-width: 30px;\n}\n\n/* ---------- Freeze controls ---------- */\n\n.freeze-controls {\n  display: flex;\n  gap: 4px;\n  margin-top: 4px;\n}\n\n.freeze-controls .btn-small {\n  font-size: 8px;\n  padding: 1px 4px;\n  min-width: auto;\n}\n\n.freeze-error,\n.sample-library-error {\n  color: var(--danger, #ef4444);\n  font-size: 0.68rem;\n  line-height: 1.25;\n}\n\n.freeze-error {\n  max-width: 14rem;\n}\n\n.meter {\n  position: relative;\n  width: 10px;\n  align-self: stretch;\n  background: var(--bg);\n  border: 1px solid var(--border-soft);\n  border-radius: 3px;\n  display: flex;\n  align-items: flex-end;\n  overflow: hidden;\n}\n\n/* LED ladder: dark rungs drawn OVER the dynamic fill (pseudo-element —\n   the fill is a child, so a parent background-image would sit behind it). */\n.meter::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background-image: repeating-linear-gradient(\n    to top,\n    transparent 0px,\n    transparent 3px,\n    rgba(0, 0, 0, 0.55) 3px,\n    rgba(0, 0, 0, 0.55) 4px\n  );\n}\n\n.meter-fill {\n  width: 100%;\n  border-radius: 1px;\n}\n\n/* Peak-hold latch: thin bright line riding the top of the fill. */\n.meter-hold {\n  position: absolute;\n  left: 0;\n  right: 0;\n  height: 2px;\n  background: #fff;\n  box-shadow: 0 0 5px rgba(255, 255, 255, 0.8);\n  pointer-events: none;\n  transition: opacity 0.2s ease;\n  z-index: 1;\n}\n\n.meter[data-clipping=\"true\"] {\n  border-color: #f87171;\n  box-shadow:\n    0 0 0 1px rgba(248, 113, 113, 0.25),\n    0 0 10px rgba(248, 113, 113, 0.45);\n}\n\n/* Legacy class hook kept working (the component sets a data attribute). */\n.meter.clipping {\n  border-color: #f87171;\n  box-shadow: 0 0 0 1px rgba(248, 113, 113, 0.2);\n}\n\n/* ---------- Effect rack ---------- */\n\n.fx-rack {\n  min-width: 0;\n  height: 100%;\n  overflow: auto;\n  background: var(--bg-panel);\n  border-top: 1px solid var(--border);\n  padding: 10px 14px;\n  container-type: inline-size;\n}\n\n.fx-rack-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 8px;\n}\n\n.fx-add-select {\n  height: 26px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 11px;\n  letter-spacing: 0.5px;\n  padding: 0 8px;\n}\n\n.fx-add-select:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.fx-empty {\n  color: var(--text-faint);\n  font-size: 11px;\n  padding: 8px 2px;\n}\n\n.fx-devices {\n  /* Accordion device view: one focused editor at a time, full rack width.\n     The old row layout squeezed four flagship editors into ~260px columns. */\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  align-items: stretch;\n}\n\n.fx-device {\n  width: 100%;\n  min-width: 0;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  padding: 8px 10px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.fx-device.bypassed {\n  opacity: 0.5;\n  border-style: dashed;\n}\n\n.fx-device-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n.fx-device-toggle {\n  flex: 0 0 20px;\n  width: 20px;\n  height: 20px;\n  padding: 0;\n  border: 1px solid transparent;\n  border-radius: 3px;\n  background: transparent;\n  color: var(--text-faint);\n  cursor: pointer;\n  font-size: 12px;\n  line-height: 18px;\n}\n\n.fx-device-toggle:hover,\n.fx-device-toggle:focus-visible {\n  border-color: var(--border);\n  color: var(--text);\n}\n\n.fx-device-toggle:focus-visible {\n  outline: 1px solid var(--accent);\n  outline-offset: 1px;\n}\n\n.fx-device-title {\n  display: flex;\n  align-items: center;\n  flex: 1;\n  min-width: 0;\n  gap: 6px;\n}\n\n.fx-device-name {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 1.2px;\n  color: var(--text-dim);\n}\n\n.fx-device-state {\n  flex: 0 0 auto;\n  color: var(--text-faint);\n  font: 9px var(--mono);\n  letter-spacing: 0.4px;\n}\n\n.fx-device.bypassed .fx-device-state {\n  color: #f59e0b;\n}\n\n.fx-device-dirty {\n  flex: 0 0 auto;\n  color: var(--accent);\n  font: 9px var(--mono);\n  font-weight: 700;\n  letter-spacing: 0.4px;\n}\n\n.fx-device-content {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-width: 0;\n}\n\n.fx-device.collapsed {\n  /* Collapsed accordion rows stay full-width slim bars — a tidy device list\n     above the focused editor. */\n  align-self: stretch;\n  min-height: 42px;\n  padding: 6px 10px;\n}\n\n.fx-device-warn {\n  display: inline-block;\n  margin-left: 6px;\n  padding: 1px 5px;\n  border-radius: 3px;\n  background: rgba(245, 158, 11, 0.14);\n  border: 1px solid rgba(245, 158, 11, 0.55);\n  color: #f59e0b;\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 0.6px;\n  cursor: help;\n}\n\n.fx-gr {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.fx-gr-track {\n  flex: 1;\n  height: 4px;\n  border-radius: 2px;\n  background: var(--bg);\n  overflow: hidden;\n}\n\n.fx-gr-fill {\n  height: 100%;\n  width: 0%;\n  background: linear-gradient(90deg, #4ade80, #f59e0b 70%, #f87171);\n}\n\n.fx-gr-label {\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--text-dim);\n  min-width: 58px;\n  text-align: right;\n}\n\n/* ---------- Modulator step grid ---------- */\n\n.mod-step-grid-wrap {\n  grid-column: 1 / -1;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.mod-step-grid {\n  width: 100%;\n  border: 1px solid var(--border-soft);\n  border-radius: 4px;\n  background: var(--bg);\n  cursor: crosshair;\n  touch-action: none;\n  overflow: hidden;\n}\n\n.mod-step-grid svg {\n  display: block;\n  width: 100%;\n  height: 100%;\n}\n\n.mod-step-grid-zero {\n  stroke: var(--border);\n  stroke-width: 0.02;\n}\n\n.mod-step-grid-bar {\n  fill: rgba(245, 158, 11, 0.75);\n}\n\n.mod-step-grid-bar.active {\n  fill: #f59e0b;\n}\n\n.mod-step-grid-tools {\n  display: flex;\n  gap: 4px;\n}\n\n/* ---------- Spectrum analyzer ---------- */\n\n.spectrum-analyzer {\n  border: 1px solid var(--border-soft);\n  border-radius: 4px;\n  background: var(--bg);\n  margin-top: 6px;\n}\n\n.fx-device-buttons {\n  display: flex;\n  gap: 4px;\n}\n\n.fx-device-buttons .btn-small {\n  min-width: 24px;\n  height: 22px;\n  font-size: 10px;\n}\n\n.fx-device-params {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 6px 10px;\n}\n\n.fx-param-select {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.fx-param-select select {\n  height: 22px;\n  background: var(--bg);\n  border: 1px solid var(--border-soft);\n  border-radius: 3px;\n  color: var(--text);\n  font-family: var(--mono);\n  font-size: 11px;\n  padding: 0 4px;\n}\n\n.fx-param-select select:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.slider-compact .slider-track {\n  height: 16px;\n}\n\n.slider-compact .slider-thumb {\n  width: 2px;\n}\n/* ---------- Arrangement ---------- */\n\n.arr-panel {\n  max-height: 360px;\n  /* A fixed 360px cap with overflow:hidden clipped the timeline bottom at\n     mid widths (760–1100px) where the ≤760px rescue below did not apply. */\n  overflow: auto;\n  background: var(--bg-panel);\n  border-top: 1px solid var(--border);\n  padding: 10px 14px;\n  display: grid;\n  grid-template-columns: minmax(246px, 290px) minmax(0, 1fr);\n  gap: 16px;\n}\n\n/* Mid widths: the scene rail + timeline stop coexisting in one row. */\n@media (max-width: 1000px) {\n  .arr-panel {\n    grid-template-columns: 1fr;\n    grid-template-rows: auto minmax(0, 1fr);\n    max-height: 420px;\n    overflow-y: auto;\n  }\n}\n\n.arr-scenes {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-height: 0;\n  overflow-y: auto;\n  padding: 8px;\n  background: rgba(255, 255, 255, 0.018);\n  border: 1px solid var(--border-soft);\n  border-radius: 8px;\n}\n\n.arr-scenes-header,\n.arr-timeline-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.arr-section-heading,\n.arr-timeline-title-group {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n  gap: 8px;\n}\n\n.arr-section-label {\n  padding: 2px 4px;\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  color: var(--text-faint);\n  font: 8px var(--mono);\n  letter-spacing: 0.8px;\n}\n\n.scene-actions,\n.arr-quick-actions {\n  display: flex;\n  gap: 5px;\n  flex-wrap: wrap;\n}\n\n.arr-scene-role {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font: 9px var(--mono);\n  color: var(--text-faint);\n}\n\n.arr-scene-role select,\n.arr-transition-editor select,\n.arr-transition-editor input {\n  min-width: 0;\n  height: 24px;\n  padding: 0 6px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  color: var(--text);\n  font: inherit;\n}\n\n.arr-scene-role select {\n  flex: 1;\n}\n\n.scene-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.scene-chip-wrap {\n  display: flex;\n  align-items: center;\n}\n\n.scene-chip {\n  height: 24px;\n  padding: 0 12px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-radius: 12px 0 0 12px;\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text-dim);\n}\n\n.scene-chip:hover {\n  color: var(--text);\n}\n\n.scene-role-badge {\n  margin-left: 5px;\n  color: var(--accent);\n  font-size: 8px;\n  font-family: var(--mono);\n}\n\n.scene-chip.selected {\n  border-color: #3a4050;\n  color: var(--text);\n}\n\n.scene-chip.active-pattern {\n  background: var(--accent-soft);\n  border-color: rgba(245, 158, 11, 0.5);\n  color: var(--accent);\n}\n\n.scene-delete {\n  height: 24px;\n  width: 20px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-left: none;\n  border-radius: 0 12px 12px 0;\n  color: var(--text-faint);\n  font-size: 11px;\n}\n\n.scene-delete:hover {\n  color: var(--stop);\n}\n\n.arr-timeline {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-width: 0;\n  min-height: 0;\n  padding: 8px;\n  background: rgba(255, 255, 255, 0.022);\n  border: 1px solid var(--border-soft);\n  border-radius: 8px;\n}\n\n.arr-timeline-actions {\n  display: flex;\n  gap: 5px;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n}\n\n.arr-lane-scroll {\n  min-height: 118px;\n  overflow-x: auto;\n  overflow-y: hidden;\n  contain: layout style;\n}\n\n/* Scene-intensity lane (VISION §11): a 0..1 editable curve strip under the\n   clip lane. Point handles are DOM spans; the curve is one SVG per lane. */\n.arr-intensity-lane {\n  position: relative;\n  height: 44px;\n  background: rgba(255, 255, 255, 0.02);\n  border-bottom: 1px solid #23262d;\n  touch-action: none;\n  user-select: none;\n}\n\n.arr-intensity-label {\n  position: absolute;\n  left: 6px;\n  top: 3px;\n  font-size: 9px;\n  letter-spacing: 0.08em;\n  color: #5b6069;\n  pointer-events: none;\n}\n\n.arr-intensity-value {\n  position: absolute;\n  left: 6px;\n  bottom: 3px;\n  font-size: 10px;\n  color: var(--accent);\n  pointer-events: none;\n}\n\n.arr-intensity-neutral {\n  position: absolute;\n  left: 0;\n  right: 0;\n  height: 1px;\n  background: #2c3037;\n  pointer-events: none;\n}\n\n.arr-intensity-clipspan {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  background: rgba(255, 255, 255, 0.025);\n  border-left: 1px solid #23262d;\n  pointer-events: none;\n}\n\n.arr-intensity-svg {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n}\n\n.arr-intensity-line {\n  fill: none;\n  stroke: var(--accent);\n  stroke-width: 1.6;\n}\n\n.arr-intensity-point {\n  position: absolute;\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  background: var(--accent);\n  border: 1px solid #0e0f12;\n  transform: translate(-50%, -50%);\n  cursor: grab;\n}\n\n.arr-intensity-point:hover {\n  background: #ffd27a;\n}\n\n.arr-status-strip {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n  gap: 4px;\n  overflow: hidden;\n}\n\n.arr-status-badge {\n  max-width: 190px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  padding: 3px 5px;\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  font: 8px var(--mono);\n  letter-spacing: 0.45px;\n}\n\n.arr-status-mode {\n  color: var(--text-dim);\n}\n\n.arr-status-quantize {\n  color: var(--accent);\n  border-color: rgba(245, 158, 11, 0.35);\n}\n\n.arr-status-queued {\n  color: var(--accent);\n  border-color: rgba(245, 158, 11, 0.65);\n  background: var(--accent-soft);\n}\n\n.arr-status-ready {\n  color: var(--text-faint);\n}\n\n.arr-role-flow {\n  display: flex;\n  align-items: center;\n  min-height: 28px;\n  gap: 3px;\n  overflow-x: auto;\n  padding: 2px 0;\n  border-bottom: 1px solid var(--border-soft);\n}\n\n.arr-role-flow-item {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  flex: 0 0 auto;\n  color: var(--scene-role-color, var(--text-dim));\n}\n\n.arr-role-flow-role {\n  padding: 3px 5px;\n  border: 1px solid color-mix(in srgb, var(--scene-role-color, var(--border)) 55%, transparent);\n  border-radius: 3px;\n  background: color-mix(in srgb, var(--scene-role-color, var(--bg-raise)) 10%, transparent);\n  font: 9px var(--mono);\n  letter-spacing: 0.7px;\n}\n\n.arr-role-flow-length {\n  color: var(--text-faint);\n  font: 8px var(--mono);\n}\n\n.arr-role-flow-arrow {\n  margin: 0 2px;\n  color: var(--text-faint);\n  font: 12px var(--sans);\n}\n\n.arr-role-flow-empty {\n  color: var(--text-faint);\n  font: 9px var(--mono);\n  letter-spacing: 0.7px;\n}\n\n.arr-lane {\n  position: relative;\n  background: var(--bg);\n  border: 1px solid var(--border-soft);\n  border-radius: 4px;\n  cursor: copy;\n}\n\n.arr-bar-grid {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 1px;\n  background: var(--border-soft);\n  pointer-events: none;\n}\n\n.arr-bar-grid.bar-strong {\n  background: #2c313c;\n}\n\n.arr-clip {\n  position: absolute;\n  top: 5px;\n  bottom: 5px;\n  background: linear-gradient(180deg, #3a4050, #2c313c);\n  border: 1px solid #465065;\n  border-radius: 4px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 8px;\n  cursor: grab;\n  user-select: none;\n  box-shadow: inset 3px 0 var(--scene-role-color, #465065);\n}\n\n.arr-clip.selected {\n  border-color: var(--accent);\n  box-shadow: 0 0 0 1px rgba(245, 158, 11, 0.4);\n}\n\n.arr-clip.current {\n  border-color: color-mix(in srgb, var(--scene-role-color, var(--accent)) 65%, white 10%);\n}\n\n.arr-clip.playing {\n  background: color-mix(in srgb, var(--scene-role-color, var(--play)) 20%, var(--bg-raise));\n  box-shadow:\n    inset 3px 0 var(--scene-role-color, var(--play)),\n    0 0 14px color-mix(in srgb, var(--scene-role-color, var(--play)) 22%, transparent);\n}\n\n.arr-clip:active {\n  cursor: grabbing;\n}\n\n.arr-clip-name {\n  font-size: 11px;\n  font-weight: 700;\n  color: var(--text);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.arr-clip-bars {\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--text-faint);\n}\n\n.arr-clip-resize {\n  position: absolute;\n  right: 0;\n  top: 0;\n  bottom: 0;\n  width: 8px;\n  cursor: ew-resize;\n}\n\n.arr-transition-mark {\n  position: absolute;\n  top: 18px;\n  z-index: 4;\n  width: 16px;\n  height: 20px;\n  padding: 0;\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  background: var(--bg-panel-2);\n  color: var(--text-faint);\n  font: 8px var(--mono);\n  cursor: pointer;\n}\n\n.arr-transition-mark:hover,\n.arr-transition-mark.selected {\n  border-color: var(--accent);\n  color: var(--accent);\n}\n\n.arr-transition-editor,\n.arr-skeleton-preview {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 6px;\n  padding: 5px 0;\n  border-top: 1px solid var(--border-soft);\n}\n\n.arr-transition-label,\n.arr-skeleton-title {\n  font: 9px var(--mono);\n  color: var(--text-dim);\n}\n\n.arr-transition-editor input[type=\"number\"] {\n  width: 48px;\n}\n\n.arr-transition-editor input:not([type=\"number\"]) {\n  width: 150px;\n}\n\n.arr-skeleton-item {\n  padding: 3px 5px;\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  color: var(--text-dim);\n  font: 9px var(--mono);\n}\n\n.arr-skeleton-empty,\n.arr-error {\n  color: var(--stop);\n  font: 10px var(--mono);\n}\n\n.arr-hint {\n  font-size: 10px;\n  color: var(--text-faint);\n}\n\n@media (max-width: 760px) {\n  .arr-panel {\n    max-height: 500px;\n    grid-template-columns: 1fr;\n    overflow-y: auto;\n  }\n\n  .arr-scenes {\n    max-height: 210px;\n  }\n\n  .arr-timeline-header {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  .arr-timeline-actions {\n    justify-content: flex-start;\n  }\n\n  .arr-status-strip {\n    max-width: 100%;\n  }\n}\n\n/* ---------- Modulation panel ---------- */\n\n.mod-panel {\n  max-height: 230px;\n  overflow: auto;\n  background: var(--bg-panel);\n  border-top: 1px solid var(--border);\n  padding: 10px 14px;\n  display: grid;\n  grid-template-columns: minmax(340px, 1.2fr) minmax(300px, 1fr) minmax(280px, 1fr);\n  gap: 16px;\n}\n\n/* The fixed 3-column grid needs ~940px; in a dock (or a 768–1024 tablet) the\n   macros/LFO column was pushed outside the slot's clipped overflow and became\n   unreachable. Collapse to auto-fit before the panel runs out of room. */\n@media (max-width: 1100px) {\n  .mod-panel {\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));\n  }\n}\n\n/* ---------- MIDI panel ---------- */\n\n.midi-panel {\n  max-height: 320px;\n  overflow: auto;\n  background: var(--bg-panel);\n  border-top: 1px solid var(--border);\n  padding: 10px 14px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.midi-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.midi-label {\n  font-size: 9px;\n  font-weight: 600;\n  letter-spacing: 0.5px;\n  color: var(--text-dim);\n  min-width: 52px;\n  text-align: right;\n}\n\n.midi-select {\n  height: 22px;\n  padding: 0 6px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 10px;\n}\n\n.midi-select-small {\n  min-width: 80px;\n}\n\n.midi-select-tiny {\n  min-width: 50px;\n}\n\n.midi-empty {\n  font-size: 10px;\n  color: var(--text-dim);\n  padding: 4px 0;\n}\n\n.midi-cc-section,\n.midi-drum-section {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.midi-cc-row,\n.midi-drum-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 10px;\n}\n\n.midi-cc-num {\n  font-weight: 600;\n  color: var(--accent);\n  min-width: 32px;\n}\n\n.midi-cc-target {\n  flex: 1;\n  color: var(--text-dim);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.midi-drum-note {\n  font-weight: 600;\n  min-width: 48px;\n  color: var(--text-dim);\n}\n\n.midi-add-row {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  margin-top: 4px;\n}\n\n.midi-drum-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n@media (max-width: 980px) {\n  .midi-creative-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* ---------- Latency calibration ---------- */\n\n.latency-overlay {\n  position: fixed;\n  inset: 0;\n  z-index: 300;\n  display: grid;\n  place-items: center;\n  padding: 18px;\n  background: rgba(5, 6, 8, 0.72);\n}\n\n.latency-card {\n  width: min(460px, 100%);\n  max-height: min(620px, calc(100vh - 36px));\n  overflow: auto;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  box-shadow: 0 14px 50px rgba(0, 0, 0, 0.45);\n}\n\n.latency-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 14px 16px;\n  border-bottom: 1px solid var(--border);\n}\n\n.latency-step {\n  display: block;\n  margin-top: 3px;\n  color: var(--text-faint);\n  font-family: var(--mono);\n  font-size: 9px;\n}\n\n.latency-body {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  padding: 16px;\n}\n\n.latency-copy,\n.latency-hint {\n  margin: 0;\n  color: var(--text-dim);\n  font-size: 11px;\n  line-height: 1.45;\n}\n\n.latency-hint {\n  color: var(--text-faint);\n  font-size: 10px;\n}\n\n.latency-actions,\n.latency-test-row {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.midi-panel-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.midi-tabs,\n.midi-tool-buttons {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  flex-wrap: wrap;\n}\n\n.midi-creativity {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.midi-creative-status {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n  color: var(--text-dim);\n  font-size: 10px;\n}\n\n.midi-creative-track {\n  color: var(--accent);\n  font-weight: 700;\n}\n\n.midi-creative-controls {\n  flex-wrap: wrap;\n}\n\n.midi-creative-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(220px, 1fr));\n  gap: 12px;\n}\n\n.midi-tool-section {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  min-width: 0;\n  padding: 8px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-radius: 5px;\n}\n\n.midi-tool-section .panel-title {\n  font-size: 10px;\n}\n\n.midi-number-row {\n  flex-wrap: wrap;\n}\n\n.midi-seed {\n  min-width: 90px;\n  flex: 1;\n  height: 22px;\n  padding: 0 6px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: var(--mono);\n  font-size: 10px;\n}\n\n.midi-seed:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.midi-creative-disabled,\n.midi-error {\n  color: var(--text-dim);\n  font-size: 10px;\n  padding: 8px 0;\n}\n\n.midi-error {\n  color: #ef4444;\n}\n\n.latency-result {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 8px;\n  padding: 10px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n}\n\n.latency-result div {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 0;\n}\n\n.latency-result span {\n  color: var(--text-faint);\n  font-family: var(--mono);\n  font-size: 8px;\n}\n\n.latency-result strong {\n  color: var(--text);\n  font-family: var(--mono);\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.latency-result p {\n  grid-column: 1 / -1;\n  margin: 2px 0 0;\n  color: var(--accent);\n  font-size: 10px;\n  line-height: 1.4;\n}\n\n.latency-result-unstable {\n  border-color: color-mix(in srgb, var(--accent) 55%, var(--border));\n}\n\n.latency-busy {\n  align-items: center;\n  justify-content: center;\n  min-height: 190px;\n  text-align: center;\n}\n\n.latency-pulse {\n  width: 34px;\n  height: 34px;\n  border: 2px solid var(--border);\n  border-top-color: var(--accent);\n  border-radius: 50%;\n  animation: latency-spin 0.8s linear infinite;\n}\n\n@keyframes latency-spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n.latency-error {\n  padding: 10px;\n  color: var(--stop);\n  background: rgba(248, 113, 113, 0.08);\n  border: 1px solid rgba(248, 113, 113, 0.3);\n  border-radius: 4px;\n  font-size: 11px;\n  line-height: 1.4;\n}\n\n.latency-offset-control {\n  display: grid;\n  grid-template-columns: 1fr auto;\n  align-items: center;\n  gap: 8px;\n  color: var(--text-dim);\n  font-family: var(--mono);\n  font-size: 10px;\n}\n\n.latency-offset-control output {\n  color: var(--accent);\n  font-size: 12px;\n}\n\n.latency-offset-control input {\n  grid-column: 1 / -1;\n  width: 100%;\n  accent-color: var(--accent);\n}\n\n@media (max-width: 520px) {\n  .latency-overlay {\n    place-items: end center;\n    padding: 8px;\n  }\n\n  .latency-card {\n    max-height: calc(100vh - 16px);\n  }\n}\n/* ---------- Drop Zone ---------- */\n\n.drop-zone {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  padding: 12px 16px;\n  border: 2px dashed var(--border);\n  border-radius: 6px;\n  background: var(--bg);\n  cursor: pointer;\n  transition:\n    border-color 0.15s,\n    background 0.15s;\n  min-height: 48px;\n}\n\n.drop-zone:hover,\n.drop-zone-active {\n  border-color: var(--accent);\n  background: var(--accent-soft);\n}\n\n.drop-zone-text {\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text);\n}\n\n.drop-zone-hint {\n  font-size: 9px;\n  color: var(--text-dim);\n  letter-spacing: 0.3px;\n}\n\n.drop-zone-error {\n  color: var(--stop);\n}\n\n.mod-section {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-width: 0;\n}\n\n.mod-lane-add {\n  display: flex;\n  gap: 5px;\n}\n\n.mod-lane-add select {\n  flex: 1;\n  min-width: 0;\n  height: 24px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 11px;\n  padding: 0 4px;\n}\n\n.mod-lane-list {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  max-height: 84px;\n  overflow-y: auto;\n}\n\n.mod-lane-row {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.mod-lane-label {\n  flex: 1;\n  min-width: 0;\n  text-align: left;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  font-size: 10px;\n  color: var(--text-dim);\n  padding: 4px 8px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.mod-lane-row.selected .mod-lane-label {\n  border-color: rgba(245, 158, 11, 0.5);\n  color: var(--accent);\n}\n\n.auto-canvas {\n  position: relative;\n  height: 90px;\n  background: var(--bg);\n  border: 1px solid var(--border-soft);\n  border-radius: 4px;\n  cursor: crosshair;\n  overflow: hidden;\n}\n\n.auto-svg {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n}\n\n.auto-point {\n  position: absolute;\n  width: 9px;\n  height: 9px;\n  margin: -4.5px 0 0 -4.5px;\n  background: var(--accent);\n  border: 1px solid #fff;\n  border-radius: 50%;\n  pointer-events: none;\n}\n\n/* Numeric point list under an automation canvas — precise entry and the\n   touch path (canvas points are 9px and right-click deletes). */\n.auto-point-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px;\n  margin-top: 6px;\n  clear: both;\n}\n\n.auto-point-row {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  padding: 1px 4px;\n  border-radius: 3px;\n  font-size: 10px;\n  color: var(--text-faint);\n}\n\n.auto-point-row.active {\n  background: var(--accent-soft);\n}\n\n.auto-point-index {\n  font-family: var(--mono);\n}\n\n.auto-point-input {\n  width: 56px;\n  height: 20px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  color: var(--text);\n  font: 10px var(--mono);\n  padding: 0 3px;\n}\n\n.auto-point-input:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.auto-point-delete {\n  min-width: 20px;\n  height: 20px;\n  padding: 0;\n  font-size: 12px;\n  line-height: 1;\n  color: var(--text-faint);\n  border-radius: 3px;\n}\n\n.auto-point-delete:hover {\n  color: var(--stop);\n}\n\n@media (pointer: coarse) {\n  .auto-point-input {\n    width: 72px;\n    height: 34px;\n    font-size: 12px;\n  }\n\n  .auto-point-delete {\n    min-width: 34px;\n    height: 34px;\n  }\n}\n\n.lfo-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  max-height: 150px;\n  overflow-y: auto;\n}\n\n.lfo-row {\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-radius: 5px;\n  padding: 6px 8px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.lfo-row-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.lfo-row-name {\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.8px;\n  color: var(--text-dim);\n}\n\n.lfo-row-controls {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 4px 8px;\n  align-items: end;\n}\n\n.macro-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 8px;\n}\n\n.macro-card {\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-radius: 5px;\n  padding: 6px 8px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.macro-name {\n  text-align: left;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 1px;\n  color: var(--text-dim);\n}\n\n.macro-name:hover {\n  color: var(--text);\n}\n\n.macro-name-input {\n  background: var(--bg);\n  border: 1px solid var(--accent);\n  border-radius: 3px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 10px;\n  padding: 2px 6px;\n  width: 100%;\n}\n\n.macro-mappings {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.macro-mapping {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.macro-mapping-label {\n  flex: 1;\n  min-width: 0;\n  font-size: 9px;\n  color: var(--text-faint);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.macro-mapping .slider {\n  width: 90px;\n}\n\n.macro-map-add {\n  display: flex;\n  gap: 4px;\n}\n\n.macro-map-add select {\n  flex: 1;\n  min-width: 0;\n  height: 22px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 10px;\n  padding: 0 3px;\n}\n\n.btn-mode {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 1px;\n  color: var(--text-dim);\n  min-width: 66px;\n}\n\n.btn-mode.active-song {\n  background: rgba(56, 189, 248, 0.12);\n  border-color: rgba(56, 189, 248, 0.5);\n  color: #38bdf8;\n}\n\n/* ---------- Export panel ---------- */\n\n.export-panel {\n  background: var(--bg-panel);\n  border-top: 1px solid var(--border);\n  padding: 12px 14px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.export-options {\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.export-options .fx-param-select {\n  min-width: 180px;\n}\n\n.export-options select {\n  height: 26px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 11px;\n  padding: 0 6px;\n}\n\n.export-policy {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px 14px;\n  padding: 7px 9px;\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  background: var(--bg-raise);\n  color: var(--text-faint);\n  font-family: var(--mono);\n  font-size: 9px;\n  line-height: 1.45;\n}\n\n.export-policy-warning {\n  color: #fbbf24;\n}\n\n.export-buttons {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.btn-export {\n  height: 30px;\n  padding: 0 16px;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 1px;\n  color: var(--accent);\n  border-color: rgba(245, 158, 11, 0.4);\n}\n\n.btn-export:hover:not(:disabled) {\n  background: var(--accent-soft);\n}\n\n.btn-export-toggle.active {\n  background: var(--accent-soft);\n  border-color: rgba(245, 158, 11, 0.5);\n  color: var(--accent);\n}\n\n.export-status {\n  font-family: var(--mono);\n  font-size: 11px;\n  color: var(--text-faint);\n}\n\n.export-busy {\n  color: var(--accent);\n}\n\n/* ── User theme system ─────────────────────────────────────────────── */\n\n.theme-panel {\n  min-width: 260px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.theme-panel-title {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 2px;\n  color: var(--text-dim);\n}\n\n.theme-presets {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.theme-preset {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--text-dim);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  background: var(--bg-panel-2);\n  padding: 4px 8px;\n  cursor: pointer;\n}\n\n.theme-preset:hover {\n  color: var(--text);\n}\n\n.theme-preset.active {\n  color: var(--text);\n  border-color: var(--accent);\n  background: var(--accent-soft);\n}\n\n.theme-preset-dot {\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  border: 1px solid rgb(255 255 255 / 0.25);\n}\n\n.theme-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.theme-row-label {\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 1px;\n  color: var(--text-faint);\n  width: 84px;\n  flex: none;\n}\n\n.theme-row-value {\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--text-dim);\n  width: 38px;\n  text-align: right;\n}\n\n.theme-row input[type=\"range\"] {\n  flex: 1;\n  accent-color: var(--accent);\n}\n\n.theme-mini-btn {\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--text-dim);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  background: var(--bg-panel-2);\n  padding: 3px 7px;\n  cursor: pointer;\n}\n\n.theme-mini-btn:hover:not(:disabled) {\n  color: var(--text);\n}\n\n.theme-mini-btn:disabled {\n  opacity: 0.4;\n  cursor: default;\n}\n\n.theme-mini-btn.on {\n  color: var(--accent);\n  border-color: var(--accent);\n  background: var(--accent-soft);\n}\n\n.theme-share {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding-top: 8px;\n  border-top: 1px solid var(--border);\n}\n\n.theme-share .theme-row {\n  flex-wrap: wrap;\n}\n\n.theme-share-status {\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--text-dim);\n}\n\n/* Compact density — tighter major containers. */\n.theme-compact .rack {\n  gap: 3px;\n}\n\n.theme-compact .pad {\n  min-height: 44px;\n}\n\n.theme-compact .sequencer {\n  padding: 5px 7px 7px;\n}\n\n.theme-compact .workspace {\n  gap: 4px;\n}\n\n.theme-compact .topbar {\n  padding-inline: 8px;\n}\n\n/* Calm motion — accessibility kill switch. */\n.theme-no-anim *,\n.theme-no-anim *::before,\n.theme-no-anim *::after {\n  transition: none !important;\n  animation: none !important;\n}\n\n/* ── Realtime resample (bounce what you hear / mic) ── */\n.export-resample {\n  margin-top: 10px;\n  padding-top: 8px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.export-resample-head {\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 1px;\n  color: var(--text-faint);\n}\n\n.export-resample-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.export-resample-row select {\n  font-family: var(--mono);\n  font-size: 10px;\n  background: var(--bg-panel-2);\n  color: var(--text);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  padding: 3px 5px;\n}\n\n.btn-rec {\n  font-family: var(--mono);\n  font-size: 11px;\n  color: #fca5a5;\n  border: 1px solid #f8717166;\n  border-radius: 4px;\n  background: rgb(248 113 113 / 0.08);\n  padding: 3px 10px;\n}\n\n.btn-rec:hover:not(:disabled) {\n  background: rgb(248 113 113 / 0.16);\n}\n\n.btn-rec-stop {\n  color: #f87171;\n  border-color: #f87171;\n}\n\n.export-resample-saving {\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--text-faint);\n}\n\n.export-resample-error {\n  font-family: var(--mono);\n  font-size: 10px;\n  color: #f87171;\n}\n\n.export-resample-hint {\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--text-faint);\n  opacity: 0.7;\n}\n\n.export-done {\n  color: var(--play);\n}\n\n.export-error {\n  color: var(--stop);\n}\n\n.return-strip {\n  border-style: dashed;\n}\n\n.group-strip {\n  border-left: 2px solid var(--accent);\n}\n\n.group-child {\n  opacity: 0.85;\n  border-left: 1px solid var(--border);\n}\n\n.return-fx-names {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 3px;\n}\n\n.return-fx-name {\n  font-family: var(--mono);\n  font-size: 8px;\n  letter-spacing: 0.5px;\n  text-transform: uppercase;\n  color: var(--text-faint);\n  background: var(--bg);\n  border-radius: 2px;\n  padding: 1px 4px;\n}\n\n/* ---------- Diagnostics ---------- */\n\n.diagnostics {\n  max-height: 160px;\n  overflow: auto;\n  background: var(--bg-panel);\n  border-top: 1px solid var(--border);\n  padding: 10px 14px;\n}\n\n.diagnostics-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));\n  gap: 2px 24px;\n}\n\n.diagnostics-row {\n  display: flex;\n  justify-content: space-between;\n  font-family: var(--mono);\n  font-size: 11px;\n  padding: 1px 0;\n}\n\n.diagnostics-key {\n  color: var(--text-faint);\n}\n\n.diagnostics-value {\n  color: var(--text-dim);\n}\n\n/* ---------- Status bar / boot ---------- */\n\n.statusbar {\n  display: flex;\n  align-items: center;\n  padding: 0 14px;\n  background: var(--bg-panel);\n  border-top: 1px solid var(--border);\n  font-size: 10px;\n  color: var(--text-faint);\n  letter-spacing: 0.4px;\n  gap: 8px;\n}\n\n/* Performance readout — pushed to the right edge; the dropout value tints\n   red the moment the scheduler had to skip a window (audio could not keep up). */\n.statusbar .perf-readout {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-left: auto;\n}\n\n.statusbar .perf-readout-item {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.statusbar .perf-readout-value {\n  color: var(--text);\n  font-variant-numeric: tabular-nums;\n}\n\n.statusbar .perf-readout-value[data-hot=\"true\"] {\n  color: #f87171;\n}\n\n.statusbar kbd {\n  font-family: var(--mono);\n  font-size: 9px;\n  padding: 0 4px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 2px;\n  color: var(--text-dim);\n}\n\n/* ---------- Undo History Panel ---------- */\n\n.undo-history-panel {\n  position: fixed;\n  top: 36px;\n  right: 14px;\n  width: 260px;\n  max-height: 340px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);\n  z-index: 100;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n}\n\n.undo-history-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 8px 12px;\n  border-bottom: 1px solid var(--border);\n}\n\n.undo-history-title {\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.5px;\n  color: var(--text-dim);\n}\n\n.undo-history-count {\n  font-size: 9px;\n  color: var(--text-faint);\n}\n\n.undo-history-empty {\n  padding: 12px;\n  font-size: 11px;\n  color: var(--text-faint);\n  text-align: center;\n}\n\n.undo-history-list {\n  overflow-y: auto;\n  flex: 1;\n  padding: 4px 0;\n}\n\n.undo-history-entry {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 4px 12px;\n  font-size: 11px;\n  color: var(--text-dim);\n}\n\n.undo-history-entry.current {\n  color: var(--text);\n  background: var(--accent-soft);\n}\n\n.undo-history-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--border);\n  flex-shrink: 0;\n}\n\n.undo-history-entry.current .undo-history-dot {\n  background: var(--accent);\n}\n\n.undo-history-label {\n  flex: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.undo-history-time {\n  font-size: 9px;\n  color: var(--text-faint);\n  font-family: var(--mono);\n  flex-shrink: 0;\n}\n\n.boot {\n  height: 100%;\n  display: grid;\n  place-items: center;\n  font-family: var(--mono);\n  color: var(--text-dim);\n  letter-spacing: 1px;\n}\n\n.boot-error {\n  color: var(--stop);\n}\n\n.crash-screen {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 100vh;\n  gap: 12px;\n  font-family: var(--mono);\n  color: var(--text);\n  background: var(--bg);\n  padding: 32px;\n  text-align: center;\n}\n\n.crash-screen h1 {\n  color: var(--stop);\n  font-size: 18px;\n  letter-spacing: 1px;\n}\n\n.crash-detail {\n  font-size: 11px;\n  color: var(--text-dim);\n  max-width: 600px;\n  word-break: break-word;\n}\n\n.panel-error {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 16px;\n  background: color-mix(in srgb, var(--stop) 8%, var(--bg));\n  border: 1px solid var(--stop);\n  border-radius: 6px;\n  font-family: var(--mono);\n  font-size: 11px;\n}\n\n.panel-error-title {\n  color: var(--stop);\n  font-weight: 600;\n  text-transform: uppercase;\n}\n\n.panel-error-detail {\n  color: var(--text-dim);\n  flex: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* ---------- Command toast ---------- */\n\n.command-toast {\n  position: fixed;\n  left: 16px;\n  bottom: 36px;\n  max-width: 360px;\n  padding: 6px 10px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-left: 2px solid var(--accent);\n  border-radius: 3px;\n  font-family: var(--mono);\n  font-size: 11px;\n  color: var(--text);\n  letter-spacing: 0.4px;\n  pointer-events: none;\n  opacity: 0;\n  transform: translateY(4px);\n  transition:\n    opacity 0.18s ease-out,\n    transform 0.18s ease-out;\n  z-index: 30;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);\n}\n\n.command-toast.visible {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n/* Song-mode guard chip (TopBar) — floats under the transport cluster so the\n   topbar layout does not jump while the warning is up. Amber left border to\n   read as a caution, not an error. */\n.mode-hint {\n  position: absolute;\n  top: calc(100% + 6px);\n  left: 0;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 5px 9px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-left: 2px solid var(--accent);\n  border-radius: 3px;\n  font-family: var(--mono);\n  font-size: 10.5px;\n  color: var(--text);\n  letter-spacing: 0.4px;\n  white-space: nowrap;\n  z-index: 90;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);\n}\n\n.mode-hint-action {\n  padding: 2px 7px;\n  background: transparent;\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.4px;\n  color: var(--accent);\n  cursor: pointer;\n}\n\n.mode-hint-action:hover {\n  border-color: var(--accent);\n  background: var(--accent-soft);\n}\n/* ---------- Help overlay ---------- */\n\n.help-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgba(8, 9, 12, 0.6);\n  display: grid;\n  place-items: center;\n  z-index: 50;\n  backdrop-filter: blur(2px);\n  -webkit-backdrop-filter: blur(2px);\n}\n\n.help-card {\n  width: min(720px, 92vw);\n  max-height: 80vh;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  padding: 16px 18px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);\n  overflow: hidden;\n}\n\n.help-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.help-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 12px 18px;\n  overflow-y: auto;\n  padding-right: 4px;\n}\n\n.help-group {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  min-width: 0;\n}\n\n.help-group-title {\n  margin: 0 0 2px;\n  font-size: 9px;\n  letter-spacing: 1.6px;\n  color: var(--accent);\n  font-weight: 700;\n}\n\n.help-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.help-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 3px 6px;\n  border-radius: 3px;\n  font-size: 11px;\n}\n\n.help-row:hover {\n  background: var(--bg-panel-2);\n}\n\n.help-label {\n  color: var(--text);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.help-kbd {\n  font-family: var(--mono);\n  font-size: 10px;\n  padding: 1px 6px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 2px;\n  color: var(--text-dim);\n  white-space: nowrap;\n}\n\n.help-footer {\n  display: flex;\n  justify-content: flex-end;\n  font-size: 10px;\n  color: var(--text-faint);\n  border-top: 1px solid var(--border-soft);\n  padding-top: 6px;\n}\n\n.help-footer kbd {\n  font-family: var(--mono);\n  font-size: 9px;\n  padding: 0 4px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 2px;\n  color: var(--text-dim);\n  margin: 0 2px;\n}\n\n::-webkit-scrollbar {\n  width: 10px;\n  height: 10px;\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--bg-raise);\n  border-radius: 5px;\n}\n\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n/* ---------- Groove controls in pattern bar ---------- */\n\n.pattern-groove {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 2px 8px;\n  border: 1px solid var(--border-soft);\n  border-radius: 5px;\n  background: var(--bg-panel);\n}\n\n/* Horizontal single-line groove controls — keeps the pattern row at chip\n   height instead of stacking label over value. */\n.pattern-groove .drag-number {\n  flex-direction: row;\n  align-items: baseline;\n  gap: 5px;\n  padding: 2px 8px;\n}\n\n/* ---------- Scene launch strip ---------- */\n\n.scene-launcher {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.scene-launcher-list {\n  min-width: 0;\n  display: flex;\n  gap: 6px;\n}\n\n.scene-launcher-panel .scene-launcher-list {\n  max-height: 205px;\n  overflow-y: auto;\n  flex-direction: column;\n  padding: 2px;\n}\n\n.scene-launcher-bar .scene-launcher-list {\n  overflow-x: auto;\n  padding: 2px 0;\n}\n\n.role-intro {\n  --scene-role-color: #60a5fa;\n}\n\n.role-build {\n  --scene-role-color: #fbbf24;\n}\n\n.role-drop {\n  --scene-role-color: #fb7185;\n}\n\n.role-break {\n  --scene-role-color: #a78bfa;\n}\n\n.role-outro {\n  --scene-role-color: #94a3b8;\n}\n\n.role-fill {\n  --scene-role-color: #34d399;\n}\n\n.role-custom {\n  --scene-role-color: #c4b5fd;\n}\n\n.scene-launch-card {\n  position: relative;\n  min-width: 0;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto auto;\n  align-items: stretch;\n  gap: 6px;\n  padding: 5px;\n  background: var(--glass-scene);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);\n  transition:\n    background 0.14s,\n    border-color 0.14s,\n    box-shadow 0.14s,\n    opacity 0.14s;\n}\n\n/* Touch reorder grip — HTML5 drag-and-drop never fires on touch, so the card\n   gets an explicit pointer handle (desktop hides it; native DnD is fine). */\n.scene-drag-grip {\n  position: absolute;\n  left: 1px;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 16px;\n  height: 26px;\n  padding: 0;\n  display: none;\n  place-items: center;\n  color: var(--text-faint);\n  font-size: 11px;\n  border-radius: 4px;\n  touch-action: none;\n  z-index: 2;\n}\n\n.scene-drag-grip:hover {\n  color: var(--text);\n  background: rgba(255, 255, 255, 0.06);\n}\n\n@media (pointer: coarse) {\n  .scene-drag-grip {\n    display: grid;\n    width: 30px;\n    height: 44px;\n  }\n\n  .scene-launch-card {\n    padding-left: 30px;\n  }\n}\n\n.scene-launcher-bar .scene-launch-card {\n  flex: 0 0 auto;\n  width: auto;\n  grid-template-columns: minmax(0, 1fr) auto auto;\n  align-items: center;\n  gap: 6px;\n  padding: 1px 4px;\n}\n\n/* Single-line scene chips in the bar: the meta (pattern/length/use) lives in\n   the card tooltip, so the strip shares the pattern row instead of hanging\n   below it as a near-empty second row. */\n.scene-launcher-bar .scene-select-control {\n  gap: 0;\n}\n\n.scene-launcher-bar .scene-select-meta {\n  display: none;\n}\n\n.scene-launcher-bar .scene-state-badges {\n  align-items: center;\n  padding-top: 0;\n}\n\n.scene-launcher-bar .scene-action {\n  min-width: 20px;\n  height: 20px;\n  padding: 0 4px;\n}\n\n.scene-launcher-panel .scene-launch-card {\n  width: 100%;\n}\n\n.scene-launch-card:hover {\n  background: var(--glass-scene-strong);\n  border-color: #3b4250;\n}\n\n.scene-launch-card.selected {\n  border-color: rgba(245, 158, 11, 0.55);\n  box-shadow:\n    0 0 0 1px rgba(245, 158, 11, 0.14),\n    inset 0 1px 0 rgba(255, 255, 255, 0.055);\n}\n\n.scene-launch-card.current {\n  border-color: rgba(74, 222, 128, 0.4);\n}\n\n.scene-launch-card.playing {\n  background: rgba(74, 222, 128, 0.1);\n  border-color: rgba(74, 222, 128, 0.7);\n  box-shadow:\n    0 0 0 1px rgba(74, 222, 128, 0.12),\n    0 0 18px rgba(74, 222, 128, 0.08);\n}\n\n.scene-launch-card.queued {\n  border-style: dashed;\n  border-color: rgba(245, 158, 11, 0.7);\n}\n\n.scene-launch-card.dragging {\n  opacity: 0.45;\n}\n\n.scene-select-control {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  gap: 3px;\n  padding: 1px 4px;\n  text-align: left;\n  color: var(--text-dim);\n}\n\n.scene-select-control:hover,\n.scene-launch-card.selected .scene-select-control {\n  color: var(--text);\n}\n\n.scene-select-main,\n.scene-select-meta {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 5px;\n}\n\n.scene-select-name {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.35px;\n}\n\n.scene-select-meta {\n  color: var(--text-faint);\n  font: 8px var(--mono);\n  white-space: nowrap;\n  overflow: hidden;\n}\n\n.scene-select-meta span {\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.arr-clip-copy {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.arr-clip-role {\n  flex: 0 0 auto;\n  color: var(--scene-role-color, var(--text-faint));\n  font: 8px var(--mono);\n  letter-spacing: 0.55px;\n}\n\n.scene-select-meta .scene-shared,\n.scene-shared-note {\n  color: var(--accent);\n}\n\n.scene-role-badge,\n.scene-loop-badge {\n  flex: 0 0 auto;\n  color: var(--scene-role-color, var(--accent));\n  font: 8px var(--mono);\n  letter-spacing: 0.45px;\n}\n\n.scene-loop-badge {\n  color: var(--play);\n}\n\n.scene-state-badges {\n  display: flex;\n  align-items: flex-start;\n  justify-content: flex-end;\n  gap: 3px;\n  padding-top: 2px;\n}\n\n.scene-state-badge {\n  padding: 2px 4px;\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  font: 8px var(--mono);\n  letter-spacing: 0.55px;\n  white-space: nowrap;\n}\n\n.scene-state-badge.playing {\n  color: var(--play);\n  border-color: rgba(74, 222, 128, 0.45);\n}\n\n.scene-state-badge.current {\n  color: var(--text-dim);\n}\n\n.scene-state-badge.queued {\n  color: var(--accent);\n  border-color: rgba(245, 158, 11, 0.45);\n}\n\n.scene-launch-actions {\n  display: flex;\n  align-items: center;\n  gap: 3px;\n}\n\n.scene-action {\n  min-width: 28px;\n  height: 26px;\n  padding: 0 6px;\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  background: rgba(0, 0, 0, 0.12);\n  color: var(--text-faint);\n  font: 9px var(--mono);\n  letter-spacing: 0.35px;\n}\n\n.scene-action:hover {\n  color: var(--text);\n  border-color: #4a5262;\n}\n\n.scene-action-launch:hover,\n.scene-launch-card.playing .scene-action-launch {\n  color: var(--play);\n  border-color: rgba(74, 222, 128, 0.55);\n}\n\n.scene-action-edit:hover {\n  color: var(--accent);\n  border-color: rgba(245, 158, 11, 0.5);\n}\n\n.scene-action-delete:hover {\n  color: var(--stop);\n  border-color: rgba(248, 113, 113, 0.5);\n}\n\n.scene-edit-input {\n  min-width: 0;\n  width: 100%;\n  height: 26px;\n  padding: 0 5px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--accent);\n  border-radius: 3px;\n  color: var(--text);\n  font: 11px var(--sans);\n}\n\n.scene-launcher-footer {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n}\n\n.scene-duplicate-pattern {\n  flex: 0 0 auto;\n  color: var(--accent);\n  border-color: rgba(245, 158, 11, 0.35);\n}\n\n.scene-shared-note {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font: 8px var(--mono);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .scene-launch-card,\n  .scene-action {\n    transition: none;\n  }\n}\n\n.scene-strip {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  flex-wrap: wrap;\n}\n\n.scene-launch {\n  height: 24px;\n  padding: 0 10px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  font-size: 10px;\n  font-weight: 600;\n  letter-spacing: 0.5px;\n  color: var(--text-dim);\n  transition:\n    background 0.12s,\n    color 0.12s,\n    border-color 0.12s;\n}\n\n.scene-launch:hover {\n  color: var(--text);\n  border-color: #343945;\n}\n\n.scene-launch.active {\n  background: rgba(74, 222, 128, 0.12);\n  border-color: rgba(74, 222, 128, 0.45);\n  color: var(--play);\n}\n\n.scene-launch.queued {\n  background: var(--accent-soft);\n  border-color: rgba(245, 158, 11, 0.5);\n  color: var(--accent);\n  animation: queued-pulse 0.6s ease-in-out infinite alternate;\n}\n\n@keyframes queued-pulse {\n  from {\n    opacity: 0.65;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n/* ---------- Step editor (probability / ratchet / microtiming) ---------- */\n\n.step-editor {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 8px 12px;\n  margin-bottom: 6px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-left: 3px solid var(--accent);\n  border-radius: 5px;\n}\n\n.step-editor-title {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 1px;\n  color: var(--accent);\n  white-space: nowrap;\n}\n\n.step-editor-field {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  min-width: 150px;\n}\n\n.step-editor-field select {\n  height: 24px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 11px;\n  padding: 0 6px;\n}\n\n.step-editor-close {\n  margin-left: auto;\n  color: var(--text-faint);\n  font-size: 16px;\n  line-height: 1;\n  padding: 0 4px;\n}\n\n.step-editor-close:hover {\n  color: var(--text);\n}\n\n/* ---------- Step selection & performance markers ---------- */\n\n.step.in-selection {\n  outline: 1px solid var(--accent);\n  outline-offset: -1px;\n}\n\n.step.has-probability {\n  border-style: dashed;\n  border-width: 1px;\n  border-color: rgba(245, 158, 11, 0.55);\n}\n\n.step.micro-early::before {\n  content: \"\";\n  position: absolute;\n  left: 1px;\n  top: 20%;\n  bottom: 20%;\n  width: 2px;\n  background: rgba(125, 211, 252, 0.8);\n  border-radius: 1px;\n}\n\n.step.micro-late::before {\n  content: \"\";\n  position: absolute;\n  right: 1px;\n  top: 20%;\n  bottom: 20%;\n  width: 2px;\n  background: rgba(125, 211, 252, 0.8);\n  border-radius: 1px;\n}\n\n.step-amount-track {\n  position: absolute;\n  left: 2px;\n  right: 2px;\n  bottom: 2px;\n  height: 4px;\n  background: rgba(0, 0, 0, 0.35);\n  border-radius: 2px;\n  /* overflow must stay visible: the coarse-pointer hit pad below is an\n     ::before with a negative inset (a 4px bar is far too thin to grab). */\n  cursor: ew-resize;\n  border: 1px solid rgba(255, 255, 255, 0.08);\n}\n.step-amount-fill {\n  height: 100%;\n  border-radius: 1px;\n  background: linear-gradient(90deg, rgba(255, 255, 255, 0.2), var(--accent));\n  transition: width 0.06s;\n}\n.step:not(.active) .step-amount-track {\n  opacity: 0.45;\n}\n.step.has-amount .step-amount-track {\n  box-shadow: 0 0 4px rgba(245, 158, 11, 0.35);\n}\n.step-amount-track:hover {\n  opacity: 1;\n}\n\n.step-badge {\n  position: absolute;\n  right: 1px;\n  top: 0;\n  font-family: var(--mono);\n  font-size: 8px;\n  color: var(--accent);\n  pointer-events: none;\n}\n\n.step.has-locks {\n  box-shadow: inset 0 -2px 0 rgba(96, 165, 250, 0.9);\n}\n\n.step-lock-dot {\n  position: absolute;\n  left: 2px;\n  bottom: 0;\n  font-size: 6px;\n  color: var(--accent);\n  pointer-events: none;\n  line-height: 1;\n}\n\n.step-editor-locks {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 200px;\n  padding-left: 10px;\n  border-left: 1px solid var(--border);\n}\n\n.step-editor-lock-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.btn-lock-clear {\n  min-width: 22px;\n  height: 22px;\n  padding: 0;\n  font-size: 10px;\n  line-height: 1;\n}\n\n.step-selection-toolbar {\n  /* Overlay, not in-flow: an in-flow bar shifts the whole step grid the\n     moment a selection starts, which invalidates the pointer-drag's\n     elementFromPoint hit-testing mid-gesture (multi-select collapsed to the\n     anchor step) and made the browser's contextmenu miss the right-clicked\n     step entirely. */\n  position: absolute;\n  top: 8px;\n  left: 10px;\n  right: 10px;\n  z-index: 30;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 8px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-left: 3px solid #60a5fa;\n  border-radius: 5px;\n  box-shadow: 0 4px 14px rgb(0 0 0 / 0.35);\n}\n\n.step-selection-label {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 1px;\n  color: var(--accent);\n  margin-right: 4px;\n  white-space: nowrap;\n}\n\n/* ---------- Arrangement ruler (song-mode seek) ---------- */\n\n.arr-ruler {\n  position: relative;\n  height: 18px;\n  margin-bottom: 2px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border-soft);\n  border-radius: 3px;\n  cursor: ew-resize;\n}\n\n.arr-ruler-mark {\n  position: absolute;\n  top: 2px;\n  font-family: var(--mono);\n  font-size: 8px;\n  color: var(--text-faint);\n  padding-left: 3px;\n  border-left: 1px solid var(--border);\n  height: 12px;\n  pointer-events: none;\n}\n\n.arr-playhead {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 2px;\n  margin-left: -0.5px;\n  background: var(--play);\n  box-shadow:\n    0 0 8px rgba(74, 222, 128, 0.8),\n    0 0 2px rgba(74, 222, 128, 1);\n  pointer-events: none;\n  will-change: transform;\n}\n\n.arr-playhead-lane {\n  z-index: 5;\n}\n\n/* ---------- Arrangement markers ---------- */\n\n.arr-marker {\n  position: absolute;\n  top: -2px;\n  width: 12px;\n  height: 12px;\n  border-radius: 2px;\n  background: var(--text-dim);\n  pointer-events: auto;\n  z-index: 10;\n  cursor: pointer;\n}\n\n.arr-marker:hover {\n  background: var(--text);\n}\n\n.arr-marker-drop {\n  background: #f59e0b;\n  border-radius: 50%;\n}\n\n.arr-marker-buildup {\n  background: #f97316;\n}\n\n.arr-marker-riser {\n  background: #8b5cf6;\n}\n\n.arr-marker-impact {\n  background: #f87171;\n  border-radius: 50%;\n}\n\n.arr-marker-cue {\n  background: #38bdf8;\n}\n\n.arr-marker-custom {\n  background: var(--text-faint);\n}\n\n/* ---------- Arrangement seconds display ---------- */\n\n.arr-ruler-mark {\n  position: absolute;\n  top: 2px;\n  font-family: var(--mono);\n  font-size: 8px;\n  color: var(--text-faint);\n  padding-left: 3px;\n  border-left: 1px solid var(--border);\n  height: 12px;\n  pointer-events: none;\n}\n/* ---------- Project browser ---------- */\n\n.project-browser {\n  height: 100%;\n  display: grid;\n  grid-template-rows: 48px minmax(0, 1fr);\n  overflow: hidden;\n}\n\n.pb-header {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 0 14px;\n  background: var(--bg-panel);\n  border-bottom: 1px solid var(--border);\n}\n\n.pb-tagline {\n  font-size: 11px;\n  color: var(--text-faint);\n  letter-spacing: 1px;\n}\n\n.pb-body {\n  overflow-y: auto;\n  padding: 20px 24px 40px;\n  display: flex;\n  flex-direction: column;\n  gap: 26px;\n  max-width: 960px;\n  width: 100%;\n  margin: 0 auto;\n}\n\n.pb-continue-card {\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 4px;\n  padding: 16px 18px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-left: 3px solid var(--accent);\n  border-radius: 6px;\n  text-align: left;\n  transition:\n    background 0.12s,\n    border-color 0.12s;\n}\n\n.pb-continue-card:hover:not(:disabled) {\n  background: var(--bg-raise);\n  border-color: #343945;\n}\n\n.pb-continue-label {\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 2px;\n  color: var(--accent);\n}\n\n.pb-continue-name {\n  font-size: 18px;\n  font-weight: 600;\n  color: var(--text);\n}\n\n.pb-continue-meta {\n  font-size: 11px;\n  color: var(--text-dim);\n}\n\n.pb-title {\n  font-family: var(--mono);\n  font-size: 11px;\n  letter-spacing: 2px;\n  color: var(--text-dim);\n  margin: 0 0 10px;\n}\n\n.pb-first-run {\n  margin: 0 0 12px;\n  font-size: 12px;\n  color: var(--accent);\n}\n\n.pb-templates {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n  gap: 12px;\n}\n\n.pb-template {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 6px;\n  padding: 14px 16px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  text-align: left;\n  transition:\n    background 0.12s,\n    border-color 0.12s,\n    transform 0.12s;\n}\n\n.pb-template:hover:not(:disabled) {\n  background: var(--bg-raise);\n  border-color: #343945;\n  transform: translateY(-1px);\n}\n\n.pb-template-start {\n  border-color: rgba(245, 158, 11, 0.5);\n}\n\n.pb-template-top {\n  width: 100%;\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n}\n\n.pb-template-name {\n  font-size: 14px;\n  font-weight: 700;\n  letter-spacing: 1px;\n  color: var(--text);\n}\n\n.pb-template-bpm {\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--text-faint);\n}\n\n.pb-template-desc {\n  font-size: 11px;\n  line-height: 1.5;\n  color: var(--text-dim);\n}\n\n.pb-template-tags {\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 0.5px;\n  color: var(--text-faint);\n}\n\n.pb-template-start-hint {\n  position: absolute;\n  top: -8px;\n  right: 10px;\n  padding: 2px 8px;\n  background: var(--accent);\n  color: #141008;\n  font-family: var(--mono);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 1px;\n  border-radius: 3px;\n}\n\n.pb-list {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.pb-row {\n  display: grid;\n  grid-template-columns: minmax(180px, 1.4fr) minmax(160px, 1fr) auto;\n  align-items: center;\n  gap: 14px;\n  padding: 9px 12px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 5px;\n}\n\n.pb-row-name {\n  text-align: left;\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--text);\n  padding: 2px 0;\n}\n\n.pb-row-name:hover:not(:disabled) {\n  color: var(--accent);\n}\n\n.pb-rename-input {\n  background: var(--bg);\n  border: 1px solid var(--accent);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 13px;\n  padding: 4px 8px;\n  width: 100%;\n}\n\n.pb-rename-input:focus {\n  outline: none;\n}\n\n.pb-row-meta {\n  font-size: 11px;\n  color: var(--text-dim);\n}\n\n/* Project written by a newer app version — visible but not openable. */\n.pb-row-newer .pb-row-name-static {\n  cursor: default;\n  color: var(--text-dim);\n}\n\n.pb-badge-newer {\n  border: 1px solid var(--accent);\n  border-radius: 3px;\n  color: var(--accent);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  padding: 1px 4px;\n  vertical-align: 1px;\n}\n\n.pb-row-actions {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.pb-empty {\n  margin: 0;\n  font-size: 12px;\n  color: var(--text-faint);\n}\n\n.pb-import-error {\n  margin-left: 8px;\n  font-size: 11px;\n  color: var(--stop);\n}\n\n/* ---------- Projects button in top bar ---------- */\n\n.btn-projects {\n  font-size: 10px;\n  letter-spacing: 1px;\n}\n\n/* ---------- Save status (clickable error) ---------- */\n\n.save-error {\n  cursor: pointer;\n  text-decoration: underline;\n}\n\n/* ---------- Preset browser ---------- */\n\n.preset-browser {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 10px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 5px;\n  margin-bottom: 10px;\n}\n\n.inspector-control-mode {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  margin: 0 0 8px;\n  padding: 5px 6px;\n  border: 1px solid var(--border-soft);\n  border-radius: 4px;\n  background: var(--bg-raise);\n}\n\n.inspector-control-mode-label {\n  margin-right: auto;\n  color: var(--text-faint);\n  font: 9px var(--mono);\n  letter-spacing: 0.1em;\n}\n\n.inspector-control-hint {\n  margin: -2px 0 2px;\n  color: var(--text-faint);\n  font: 9px var(--mono);\n}\n\n.preset-current {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.preset-current-label {\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 1.5px;\n  color: var(--text-faint);\n}\n\n.preset-current-name {\n  flex: 1;\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--text);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.preset-save {\n  display: flex;\n  gap: 6px;\n}\n\n.preset-save-input {\n  flex: 1;\n  background: var(--bg);\n  border: 1px solid var(--accent);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 12px;\n  padding: 4px 8px;\n}\n\n.preset-save-input:focus {\n  outline: none;\n}\n\n.preset-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n}\n\n.preset-chip {\n  padding: 3px 8px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 1px;\n  color: var(--text-dim);\n}\n\n.preset-chip.active {\n  background: var(--accent-soft);\n  border-color: rgba(245, 158, 11, 0.45);\n  color: var(--accent);\n}\n\n.preset-toolbar {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.preset-toolbar .preset-search {\n  flex: 1;\n  min-width: 0;\n  width: auto;\n}\n\n.preset-filter-toggle.active {\n  color: var(--accent);\n  border-color: rgba(245, 158, 11, 0.45);\n}\n\n.preset-search {\n  width: 100%;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 12px;\n  padding: 5px 8px;\n}\n\n.preset-search:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.preset-list {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  max-height: 200px;\n  overflow-y: auto;\n}\n\n.preset-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 6px 8px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border-soft);\n  border-radius: 4px;\n}\n\n.preset-row:hover {\n  border-color: #343945;\n}\n\n.preset-row.active {\n  border-color: rgba(245, 158, 11, 0.5);\n  background: var(--accent-soft);\n}\n\n.preset-name {\n  flex: 1;\n  min-width: 0;\n  padding: 0;\n  background: none;\n  border: 0;\n  text-align: left;\n  font-size: 12px;\n  color: var(--text);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.preset-name:hover {\n  color: var(--accent);\n}\n\n.preset-preview {\n  flex: none;\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  background: var(--bg);\n  color: var(--text-dim);\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 0.7px;\n  line-height: 1;\n  padding: 4px 5px;\n}\n\n.preset-preview:hover,\n.preset-preview.active {\n  border-color: var(--accent);\n  color: var(--accent);\n}\n\n.preset-preview:focus-visible,\n.preset-name:focus-visible {\n  outline: 1px solid var(--accent);\n  outline-offset: 1px;\n}\n\n.preset-tags {\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--text-faint);\n  white-space: nowrap;\n}\n\n.preset-delete {\n  color: var(--text-faint);\n  font-size: 14px;\n  line-height: 1;\n  padding: 0 2px;\n}\n\n.preset-delete:hover {\n  color: var(--stop);\n}\n\n.preset-empty {\n  font-size: 11px;\n  color: var(--text-faint);\n  padding: 6px 0;\n}\n\n/* ---------- Onboarding hint ---------- */\n\n.onboarding {\n  position: fixed;\n  left: 50%;\n  bottom: 40px;\n  transform: translateX(-50%);\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  max-width: 520px;\n  padding: 9px 14px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-left: 3px solid var(--accent);\n  border-radius: 5px;\n  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);\n  z-index: 60;\n}\n\n.onboarding-step {\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--accent);\n  letter-spacing: 1px;\n}\n\n/* ---------- Install prompt ---------- */\n\n.install-prompt {\n  position: fixed;\n  right: 14px;\n  bottom: 40px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 9px 12px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-left: 3px solid var(--accent);\n  border-radius: 5px;\n  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);\n  z-index: 60;\n}\n\n.install-prompt-icon {\n  color: var(--accent);\n  font-size: 16px;\n}\n\n.install-prompt-text {\n  display: flex;\n  flex-direction: column;\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text);\n  line-height: 1.3;\n}\n\n.install-prompt-text small {\n  font-size: 9px;\n  font-weight: 400;\n  color: var(--text-dim);\n}\n\n.install-prompt-close {\n  color: var(--text-faint);\n  font-size: 14px;\n  cursor: pointer;\n  background: none;\n  border: none;\n  padding: 2px 4px;\n}\n\n.install-prompt-close:hover {\n  color: var(--text);\n}\n\n.onboarding-text {\n  flex: 1;\n  font-size: 12px;\n  color: var(--text);\n  line-height: 1.4;\n}\n\n.onboarding-skip {\n  color: var(--text-faint);\n  font-size: 16px;\n  line-height: 1;\n  padding: 0 2px;\n}\n\n.onboarding-skip:hover {\n  color: var(--text);\n}\n\n/* ---------- Sample browser ---------- */\n\n.inspector-subtitle {\n  margin: 8px 0 0;\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  color: var(--text-faint);\n}\n\n/* Wavetable/granular canvas preview under the sample browser */\n.wt-preview {\n  display: block;\n  width: 100%;\n  height: 64px;\n  margin-top: 6px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 5px;\n}\n\n.sample-browser {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 8px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border);\n  border-radius: 5px;\n}\n\n.sampler-map-preview {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 8px;\n  border: 1px solid var(--accent);\n  border-radius: 4px;\n  background: color-mix(in srgb, var(--accent) 8%, var(--bg-panel-2));\n}\n\n.sampler-map-preview-heading {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n  color: var(--accent);\n  font: 10px var(--mono);\n  letter-spacing: 0.08em;\n}\n\n.sampler-map-preview-heading span,\n.sampler-map-preview p {\n  color: var(--text-faint);\n  font: 9px var(--mono);\n  letter-spacing: normal;\n}\n\n.sampler-map-preview p {\n  margin: 0;\n  line-height: 1.4;\n}\n\n.sampler-map-preview-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 5px;\n}\n\n.sample-list {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  max-height: 240px;\n  overflow-y: auto;\n}\n\n.sample-group-label {\n  font-family: var(--mono);\n  font-size: 8px;\n  letter-spacing: 1.5px;\n  color: var(--text-faint);\n  padding: 5px 4px 2px;\n  margin-top: 2px;\n  border-top: 1px solid var(--border-soft);\n}\n\n.sample-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 3px 4px;\n  border-radius: 3px;\n}\n\n.sample-row:hover {\n  background: var(--bg-raise);\n}\n\n.sample-row.active {\n  background: var(--accent-soft);\n}\n\n.sample-preview {\n  width: 22px;\n  height: 20px;\n  display: grid;\n  place-items: center;\n  font-size: 9px;\n  color: var(--accent);\n  background: var(--bg-raise);\n  border: 1px solid var(--border-soft);\n  border-radius: 3px;\n  flex: none;\n}\n\n.sample-preview-none {\n  visibility: hidden;\n}\n\n.sample-name {\n  flex: 1;\n  text-align: left;\n  font-size: 11px;\n  color: var(--text);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* Detected-tempo chip on imported loops (feeds \"Fit to project BPM\"). */\n.sample-bpm {\n  flex: none;\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--accent);\n  border: 1px solid var(--accent) 55;\n  border-radius: 3px;\n  padding: 1px 3px;\n  line-height: 1.2;\n}\n\n.sample-name-none {\n  color: var(--text-faint);\n  font-style: italic;\n}\n\n.sample-fav {\n  color: var(--text-faint);\n  font-size: 12px;\n  line-height: 1;\n  padding: 0 2px;\n  flex: none;\n}\n\n.sample-fav:hover,\n.sample-fav.active {\n  color: #fb7185;\n}\n\n.sample-delete {\n  color: var(--text-faint);\n  font-size: 12px;\n  cursor: pointer;\n  background: none;\n  border: none;\n  padding: 2px 4px;\n}\n\n.sample-delete:hover {\n  color: var(--stop);\n}\n\n/* ---------- Preset favorites ---------- */\n\n.preset-fav {\n  color: var(--text-faint);\n  font-size: 12px;\n  line-height: 1;\n  padding: 0 2px;\n  flex: none;\n}\n\n.preset-fav:hover,\n.preset-fav.active {\n  color: #fb7185;\n}\n/* ---------- Master meter (stereo + RMS + correlation + headroom) ---------- */\n\n.master-strip {\n  border-left: 1px solid var(--accent);\n}\n\n.master-toggles {\n  display: flex;\n  gap: 4px;\n  padding: 2px 0 4px;\n}\n\n.master-toggles .btn {\n  flex: 1;\n  font-size: 10px;\n  letter-spacing: 0.5px;\n}\n\n/* Master metering wall: spectrum+loudness | goniometer+verdict. The stereo\n   indicators (L/R, correlation, headroom) moved into the MASTER channel strip\n   (MasterStereoMeters) — the strip had dead space under its controls and the\n   wall gives their 132px column back to the spectrum.\n   Explicit areas — the old 4-column auto-placement squeezed the spectrum\n   into a 72px cell and left a dead zone next to the fixed-size goniometer. */\n.master-meter {\n  display: grid;\n  grid-template-columns: minmax(300px, 1fr) minmax(260px, 330px);\n  /* Fixed warnings row, reserved even when empty — the wall never jumps\n     when mix-check messages appear or clear. */\n  grid-template-rows: minmax(0, 1fr) 20px;\n  grid-template-areas:\n    \"center right\"\n    \"warnings warnings\";\n  gap: 10px;\n  padding: 8px;\n  contain: layout style;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  margin-top: 6px;\n  /* DEFINITE height from the dock var — the zones shrink/grow to fit, the\n     goniometer tracks its cell via ResizeObserver. A content-driven or flex\n     height here feeds the RO into a layout loop and overflows short docks.\n     139px = measured dock overhead (batch bar 61 + margins + padding +\n     strip name row); the wall fills the dock down to the bottom padding. */\n  height: clamp(110px, calc(var(--dock-height, 300px) - 139px), 671px);\n  overflow: hidden;\n  position: relative;\n  flex: 1;\n  min-width: 620px;\n}\n\n/* Mid-width docks (1280–1440 laptops, split view): the wall may shrink to\n   keep the MASTER fader on screen. The spectrum column keeps its 300px\n   floor; the goniometer/verdict column gives way first. */\n@media (max-width: 1500px) {\n  .master-meter {\n    grid-template-columns: minmax(240px, 1fr) minmax(200px, 280px);\n    min-width: 480px;\n  }\n}\n\n.master-dynamics-meters {\n  display: flex;\n  gap: 6px;\n  flex: 1;\n  min-height: 0;\n}\n\n/* Equal fixed width for L/R meters — their bars must not follow the peak\n   readout text (−∞ is narrower than −12.0 and made the bars breathe). */\n.master-dynamics-meters .master-channel {\n  flex: 1 1 0;\n  min-width: 0;\n}\n\n.master-stereo-meters {\n  /* Strip-column citizen: fills the dead space under the IN/CEIL controls. */\n  flex: 1 1 auto;\n  min-height: 0;\n  align-self: stretch;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.master-stereo-meters .master-correlation,\n.master-stereo-meters .master-headroom {\n  gap: 2px;\n}\n\n/* CORR + HEAD side by side under the L/R bars. */\n.master-stereo-secondary {\n  display: flex;\n  gap: 6px;\n  align-items: stretch;\n}\n\n.master-stereo-secondary .master-correlation,\n.master-stereo-secondary .master-headroom {\n  flex: 1 1 0;\n  min-width: 0;\n}\n\n/* Compact secondary meters beside the L/R bars. */\n.master-stereo-meters .master-correlation-bar,\n.master-stereo-meters .master-headroom-strip {\n  flex: 0 0 auto;\n  min-height: 36px;\n  height: 36px;\n}\n\n.master-zone-center {\n  grid-area: center;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-width: 0;\n  min-height: 0;\n}\n\n.master-zone-center > .spectrum-analyzer,\n.master-zone-center > .loudness-history {\n  width: 100%;\n}\n\n.master-zone-center > .spectrum-analyzer {\n  flex: 1;\n  min-height: 0;\n}\n\n.master-zone-right {\n  grid-area: right;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-height: 0;\n  /* Size container so tight docks can drop the goniometer (the verdict\n     panel keeps priority) instead of shrinking it to a pixel. */\n  container-type: size;\n}\n\n.master-zone-right .goniometer-wrap {\n  flex: 1;\n  min-height: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* Must stay AFTER the wrap rule above — same specificity, later wins. */\n@container (max-height: 195px) {\n  .master-zone-right .goniometer-wrap {\n    display: none;\n  }\n}\n\n.master-zone-warnings {\n  grid-area: warnings;\n  max-width: none;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n}\n\n.master-verdict {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  padding: 8px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border-soft);\n  border-radius: 5px;\n}\n\n.master-verdict-headline {\n  font: 700 13px/1.15 var(--mono, ui-monospace, monospace);\n  letter-spacing: 1px;\n  color: var(--text-dim);\n}\n\n.master-verdict[data-level=\"ok\"] .master-verdict-headline {\n  color: #4ade80;\n}\n\n.master-verdict[data-level=\"warn\"] .master-verdict-headline {\n  color: #f59e0b;\n}\n\n.master-verdict[data-level=\"bad\"] .master-verdict-headline {\n  color: #f87171;\n}\n\n/* Two reserved hint slots — one or two hints occupy the same space, so the\n   goniometer above never resizes when advice appears or clears. */\n.master-verdict-hints {\n  min-height: 26px;\n}\n\n.master-verdict-hint {\n  display: block;\n  font-size: 9.5px;\n  line-height: 1.3;\n  color: var(--muted, #8992a5);\n}\n\n.master-verdict-target {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin-top: auto;\n  padding-top: 4px;\n}\n\n.master-verdict-target-label {\n  font-size: 9px;\n  letter-spacing: 1px;\n  color: var(--text-faint);\n}\n\n.master-verdict-target select {\n  font-size: 10px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  color: var(--text);\n  padding: 2px 4px;\n}\n\n.master-verdict-delta {\n  font-family: var(--mono, ui-monospace, monospace);\n  font-size: 10px;\n  font-weight: 600;\n  color: var(--text);\n  margin-left: auto;\n}\n\n.master-verdict-actions {\n  display: flex;\n  gap: 5px;\n}\n\n.master-verdict-actions .btn {\n  flex: 1;\n  font-size: 9px;\n}\n\n/* Limiter gain-reduction lane drawn from the top of each channel bar. */\n.master-channel-gr {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  background: rgba(248, 113, 113, 0.4);\n  border-bottom: 1px solid rgba(248, 113, 113, 0.6);\n  will-change: height;\n}\n\n.goniometer-wrap {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  height: 100%;\n  min-width: 0;\n  min-height: 0;\n}\n\n.goniometer {\n  border: 1px solid var(--border-soft);\n  background: var(--bg-panel);\n  border-radius: 4px;\n}\n\n.loudness-history {\n  border: 1px solid var(--border-soft);\n  background: var(--bg-panel);\n  border-radius: 4px;\n}\n\n.slice-dialog-hits-controls {\n  display: flex;\n  gap: 12px;\n  align-items: center;\n  flex-wrap: wrap;\n  margin: 6px 0 2px;\n  font-size: 10px;\n  color: var(--text-dim);\n}\n\n.slice-dialog-hits-controls .slice-hits-sensitivity {\n  display: flex;\n  gap: 6px;\n  align-items: center;\n}\n\n.slice-hits-status {\n  color: var(--text-faint);\n  font-family: var(--mono);\n}\n\n.master-channel {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  align-items: stretch;\n  min-height: 100%;\n}\n\n.master-channel-label {\n  font-family: var(--mono);\n  font-size: 8px;\n  color: var(--text-faint);\n  letter-spacing: 1px;\n}\n\n.master-channel-bar {\n  position: relative;\n  flex: 1;\n  background: var(--bg-panel);\n  border-radius: 2px;\n  overflow: hidden;\n  min-height: 40px;\n  border: 1px solid var(--border-soft);\n}\n\n.master-channel-rms {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(125, 211, 252, 0.45);\n  will-change: height;\n}\n\n.master-channel-peak {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: linear-gradient(180deg, #4ade80 0%, #4ade80 70%, #fbbf24 85%, #f87171 100%);\n  opacity: 0.85;\n  transition: height 0.04s linear;\n  will-change: height;\n}\n\n.master-channel-hold {\n  position: absolute;\n  left: 0;\n  right: 0;\n  height: 1px;\n  background: #fffbe6;\n  opacity: 0.9;\n  transition: bottom 0.18s ease-out;\n}\n\n.master-channel-tick {\n  position: absolute;\n  left: 0;\n  right: 0;\n  height: 1px;\n  background: rgba(255, 255, 255, 0.18);\n}\n\n.master-channel-tick-warn {\n  background: rgba(248, 113, 113, 0.55);\n}\n\n.master-channel-tick-dim {\n  background: rgba(255, 255, 255, 0.08);\n}\n\n.master-channel-peak-readout {\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--text-dim);\n  text-align: right;\n}\n\n.master-correlation,\n.master-headroom {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  align-items: stretch;\n}\n\n.master-correlation-bar {\n  position: relative;\n  flex: 1;\n  background: var(--bg-panel);\n  border-radius: 2px;\n  border: 1px solid var(--border-soft);\n  min-height: 90px;\n  overflow: hidden;\n}\n\n.master-correlation-track {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    90deg,\n    rgba(248, 113, 113, 0.18) 0%,\n    rgba(125, 211, 252, 0.18) 50%,\n    rgba(74, 222, 128, 0.18) 100%\n  );\n}\n\n.master-correlation-center {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  left: 50%;\n  width: 1px;\n  background: rgba(255, 255, 255, 0.25);\n}\n\n.master-correlation-fill {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  left: 0;\n  transition: width 0.05s linear;\n}\n\n.master-correlation-label {\n  font-family: var(--mono);\n  font-size: 8px;\n  letter-spacing: 1px;\n  text-align: center;\n}\n\n.master-headroom-strip {\n  position: relative;\n  flex: 1;\n  background: var(--bg-panel);\n  border-radius: 2px;\n  border: 1px solid var(--border-soft);\n  min-height: 90px;\n  overflow: hidden;\n}\n\n.master-headroom-bar {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  opacity: 0.35;\n  transition: height 0.1s linear;\n}\n\n.master-headroom-ceiling {\n  position: absolute;\n  left: 0;\n  right: 0;\n  height: 2px;\n  background: var(--accent);\n  opacity: 0.9;\n  transition: bottom 0.1s ease-out;\n}\n\n.master-headroom-readout {\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--text-dim);\n  text-align: right;\n}\n\n.master-clip-warning {\n  position: absolute;\n  top: -4px;\n  right: -4px;\n  background: #f87171;\n  color: #161616;\n  font-family: var(--mono);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 1px;\n  padding: 2px 6px;\n  border-radius: 3px;\n  box-shadow: 0 0 0 2px var(--bg-panel);\n  animation: master-clip-pulse 0.4s ease-in-out infinite alternate;\n}\n\n@keyframes master-clip-pulse {\n  from {\n    opacity: 0.7;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n/* ---------- Export master summary ---------- */\n\n.export-summary {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 8px;\n  padding: 10px 12px;\n  margin-top: 10px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  font-family: var(--mono);\n  font-size: 11px;\n}\n\n.export-summary-row {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.export-summary-label {\n  color: var(--text-faint);\n  letter-spacing: 1px;\n  font-size: 9px;\n}\n\n.export-summary-value {\n  color: var(--text);\n}\n\n.export-summary-clipped {\n  color: var(--stop);\n  font-weight: 700;\n}\n\n/* Mono-loss guardian + gain verdict boxes inside the export summary. */\n.export-summary-guard {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  grid-column: 1 / -1;\n  padding: 6px 8px;\n  border: 1px solid var(--accent);\n  border-radius: 4px;\n}\n\n.export-summary-guard[data-level=\"bad\"] {\n  border-color: #f87171;\n}\n\n/* ---------- Scene panel (ModPanel) ---------- */\n\n.scene-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.scene-panel .mod-section {\n  padding-top: 8px;\n  border-top: 1px solid var(--border-soft);\n}\n\n/* ---------- Scorepack export button ---------- */\n\n.btn-export-scorepack {\n  background: linear-gradient(135deg, rgba(245, 158, 11, 0.12), rgba(234, 88, 12, 0.12));\n  border-color: rgba(245, 158, 11, 0.4);\n}\n\n.btn-export-scorepack:hover {\n  background: linear-gradient(135deg, rgba(245, 158, 11, 0.25), rgba(234, 88, 12, 0.25));\n  border-color: rgba(245, 158, 11, 0.6);\n  color: var(--accent);\n}\n\n/* ---------- Diagnostics tabs ---------- */\n\n.diag-tabs {\n  display: flex;\n  gap: 4px;\n  margin-bottom: 10px;\n}\n\n.diag-tabs .btn {\n  font-size: 9px;\n  letter-spacing: 0.5px;\n  padding: 4px 8px;\n}\n\n.diag-subsection {\n  display: flex;\n  gap: 6px;\n  padding-top: 8px;\n  border-top: 1px solid var(--border-soft);\n  margin-top: 8px;\n}\n\n.diag-issues {\n  padding-top: 10px;\n  border-top: 1px solid var(--border-soft);\n  margin-top: 8px;\n}\n\n.diag-issue-title {\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--stop);\n  letter-spacing: 1px;\n  margin-bottom: 6px;\n}\n\n.diag-issue {\n  font-size: 10px;\n  color: var(--text-dim);\n  line-height: 1.4;\n  margin-bottom: 3px;\n}\n\n/* ---------- Piano roll scale highlighting ---------- */\n\n.pr-key.out-scale {\n  opacity: 0.55;\n}\n\n.pr-key.root {\n  border-left: 3px solid var(--accent);\n}\n\n.pr-scale-deg {\n  font-family: var(--mono);\n  font-size: 8px;\n  color: var(--text-faint);\n  margin-left: 2px;\n  position: absolute;\n  right: 1px;\n  top: 2px;\n}\n\n.pr-scale-row {\n  position: absolute;\n  left: 0;\n  right: 0;\n  background: rgba(74, 222, 128, 0.05);\n  pointer-events: none;\n  z-index: 0;\n}\n\n.pr-scale-row.root {\n  background: rgba(245, 158, 11, 0.08);\n}\n\n.pr-note.out-of-scale {\n  opacity: 0.3;\n  filter: saturate(0.5);\n}\n\n/* --- Spectrogram section (collapsible) in the master wall's centre zone.\n   Collapsed it is just an 18px strip so the default wall layout is\n   unchanged; expanded the body takes a fixed slice and the spectrum curve\n   above shrinks (flex: 1) to make room. */\n.spectrogram {\n  flex: 0 0 auto;\n  display: flex;\n  flex-direction: column;\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  overflow: hidden;\n  background: #060409;\n}\n\n.spectrogram-head {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 2px 6px;\n  min-height: 18px;\n}\n\n.spectrogram-collapse {\n  background: none;\n  border: none;\n  color: var(--text-faint);\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 0.08em;\n  cursor: pointer;\n  padding: 2px 0;\n}\n\n.spectrogram-collapse:hover {\n  color: var(--text);\n}\n\n.spectrogram-ctl {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--text-faint);\n}\n\n.spectrogram-ctl select {\n  font-family: var(--mono);\n  font-size: 9px;\n  background: var(--bg);\n  color: var(--text);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  padding: 0 2px;\n}\n\n.spectrogram-ctl-btn {\n  background: none;\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  color: var(--text-faint);\n  font-family: var(--mono);\n  font-size: 9px;\n  padding: 1px 6px;\n  cursor: pointer;\n}\n\n.spectrogram-ctl-btn:hover {\n  color: var(--text);\n}\n\n.spectrogram-ctl-btn[data-active=\"true\"] {\n  color: var(--accent);\n  border-color: var(--accent);\n}\n\n.spectrogram-body {\n  position: relative;\n  width: 100%;\n}\n\n.spectrogram-canvas,\n.spectrogram-overlay {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n/* ---------- Scale panel popover ---------- */\n\n.scale-popover {\n  position: absolute;\n  top: 48px;\n  right: 0;\n  z-index: 50;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-top: none;\n  border-radius: 0 0 6px 6px;\n  padding: 10px 12px;\n  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);\n}\n\n.scale-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-width: 260px;\n}\n\n.scale-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.scale-label {\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 1px;\n  color: var(--text-faint);\n  width: 40px;\n  flex-shrink: 0;\n}\n\n.scale-select {\n  flex: 1;\n  height: 26px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 12px;\n  padding: 0 8px;\n}\n\n.scale-select:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n/* ── Generate Dialog ─────────────────────────────────── */\n\n.generate-dialog-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 200;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgba(0, 0, 0, 0.45);\n}\n\n.generate-dialog {\n  width: 320px;\n  max-height: 80vh;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n.generate-dialog-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 10px 14px;\n  border-bottom: 1px solid var(--border);\n}\n\n.generate-dialog-title {\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  color: var(--text-dim);\n}\n\n.generate-dialog-body {\n  padding: 14px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  overflow-y: auto;\n}\n\n.generate-field {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.generate-label {\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 1px;\n  color: var(--text-faint);\n}\n\n.generate-select {\n  height: 28px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: inherit;\n  font-size: 12px;\n  padding: 0 8px;\n}\n\n.generate-select:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.generate-seed-row {\n  display: flex;\n  gap: 6px;\n}\n\n.generate-seed-input {\n  flex: 1;\n  height: 28px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  font-family: var(--mono);\n  font-size: 12px;\n  padding: 0 8px;\n}\n\n.generate-seed-input:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.generate-divider {\n  height: 1px;\n  background: var(--border);\n  margin: 4px 0;\n}\n\n.generate-advanced-title {\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  color: var(--text-faint);\n  margin-bottom: 2px;\n}\n\n.generate-mode-row {\n  display: flex;\n  gap: 4px;\n}\n\n.generate-mode-row .btn {\n  min-width: 60px;\n}\n\n.generate-slider-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.generate-slider {\n  flex: 1;\n  height: 4px;\n  -webkit-appearance: none;\n  appearance: none;\n  background: var(--border);\n  border-radius: 2px;\n  outline: none;\n}\n\n.generate-slider::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  background: var(--accent);\n  cursor: pointer;\n}\n\n.generate-slider::-moz-range-thumb {\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  background: var(--accent);\n  cursor: pointer;\n  border: none;\n}\n\n.generate-value {\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--text-dim);\n  min-width: 32px;\n  text-align: right;\n}\n\n.generate-dialog-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  padding: 10px 14px;\n  border-top: 1px solid var(--border);\n}\n\n.btn-primary {\n  background: var(--accent-soft);\n  border-color: rgba(245, 158, 11, 0.45);\n  color: var(--accent);\n}\n\n.btn-primary:hover {\n  background: rgba(245, 158, 11, 0.22);\n  color: var(--accent);\n}\n\n/* ── Pattern Preview Grid ────────────────────────────── */\n\n.preview-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 1px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  padding: 4px;\n  overflow-x: auto;\n}\n\n.preview-ruler {\n  display: flex;\n  gap: 1px;\n  padding-left: 36px;\n  margin-bottom: 2px;\n}\n\n.preview-step-num {\n  width: 16px;\n  text-align: center;\n  font-family: var(--mono);\n  font-size: 7px;\n  color: var(--text-faint);\n  line-height: 10px;\n}\n\n.preview-step-num.beat {\n  color: var(--text-dim);\n  font-weight: 700;\n}\n\n.preview-row {\n  display: flex;\n  align-items: center;\n  gap: 1px;\n  height: 12px;\n}\n\n.preview-pad-label {\n  width: 34px;\n  font-family: var(--mono);\n  font-size: 7px;\n  color: var(--text-faint);\n  text-align: right;\n  padding-right: 4px;\n  flex-shrink: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  line-height: 12px;\n}\n\n.preview-cell {\n  width: 16px;\n  height: 10px;\n  background: var(--bg-raise);\n  border-radius: 1px;\n  transition: background 0.1s;\n}\n\n.preview-cell.beat {\n  border-left: 1px solid var(--border);\n}\n\n.preview-cell.active {\n  background: var(--accent);\n}\n\n/* ── Collab (jam session) panel ─────────────────────────────────────────── */\n\n.collab-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  min-width: 300px;\n  max-width: 360px;\n}\n\n.collab-title {\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  font-size: 12px;\n  color: var(--text);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.collab-hint {\n  font-size: 11px;\n  color: var(--text-dim, #8a8f98);\n  line-height: 1.5;\n  margin: 0;\n}\n\n.collab-field {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  font-size: 10px;\n  letter-spacing: 0.1em;\n  color: var(--text-dim, #8a8f98);\n}\n\n.collab-field input {\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  padding: 6px 8px;\n  font-size: 12px;\n  font-family: inherit;\n}\n\n.collab-status {\n  font-size: 10px;\n  padding: 2px 6px;\n  border-radius: 3px;\n  letter-spacing: 0.08em;\n}\n\n.collab-status-ok {\n  background: var(--accent-soft);\n  color: var(--accent);\n}\n\n.collab-status-wait {\n  background: rgba(148, 163, 184, 0.15);\n  color: #94a3b8;\n}\n\n.collab-status-bad {\n  background: rgba(239, 68, 68, 0.15);\n  color: #ef4444;\n}\n\n.collab-room {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.collab-room-code {\n  font-family: ui-monospace, \"Cascadia Code\", monospace;\n  font-size: 18px;\n  font-weight: 700;\n  letter-spacing: 0.2em;\n  color: var(--accent);\n}\n\n.collab-people {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  align-items: center;\n}\n\n.collab-chip {\n  font-size: 11px;\n  padding: 3px 8px;\n  border: 1px solid;\n  border-left-width: 3px;\n  border-radius: 3px;\n  color: var(--text);\n  background: var(--bg-raise);\n}\n\n/* ── Embed player (/embed) ──────────────────────────────────────────────── */\n\n.embed-root {\n  position: fixed;\n  inset: 0;\n  display: flex;\n  flex-direction: column;\n  background: var(--bg);\n  color: var(--text);\n  font-family: ui-sans-serif, system-ui, sans-serif;\n  overflow: hidden;\n}\n\n.embed-main {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 14px 16px 6px;\n  flex: 1;\n  min-height: 0;\n}\n\n.embed-play {\n  width: 52px;\n  height: 52px;\n  min-width: 52px;\n  border-radius: 50%;\n  border: 1px solid var(--border);\n  background: var(--accent);\n  color: #0e0f12;\n  font-size: 20px;\n  cursor: pointer;\n  display: grid;\n  place-items: center;\n  line-height: 1;\n}\n\n.embed-play:disabled {\n  background: var(--bg-raise);\n  color: var(--text-dim, #8a8f98);\n  cursor: wait;\n}\n\n.embed-wave {\n  position: relative;\n  flex: 1;\n  height: 64px;\n  cursor: pointer;\n  border-radius: 6px;\n  overflow: hidden;\n}\n\n.embed-canvas {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n.embed-progress {\n  position: absolute;\n  left: 0;\n  top: 0;\n  bottom: 0;\n  background: linear-gradient(90deg, rgba(245, 158, 11, 0.32), rgba(245, 158, 11, 0.18));\n  border-right: 2px solid var(--accent);\n  pointer-events: none;\n}\n\n.embed-time {\n  font-family: ui-monospace, \"Cascadia Code\", monospace;\n  font-size: 12px;\n  color: var(--text-dim, #8a8f98);\n  min-width: 92px;\n  text-align: right;\n}\n\n.embed-footer {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 6px 16px 14px;\n  flex-wrap: wrap;\n}\n\n.embed-meta {\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n}\n\n.embed-status {\n  font-size: 11px;\n  color: var(--text-dim, #8a8f98);\n}\n\n.embed-status[data-phase=\"error\"] {\n  color: #ef4444;\n}\n\n.embed-actions {\n  margin-left: auto;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.embed-cta {\n  background: var(--accent);\n  color: #0e0f12;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  padding: 8px 14px;\n  border-radius: 5px;\n  text-decoration: none;\n  white-space: nowrap;\n}\n\n.embed-cta:hover {\n  filter: brightness(1.1);\n}\n\n/* B2 secondary CTA — the regenerate path next to the primary OPEN IN KYX. */\n.embed-cta-ghost {\n  background: transparent;\n  color: var(--accent);\n  border: 1px solid rgba(245, 158, 11, 0.55);\n}\n\n.embed-brand {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  color: var(--text-dim, #8a8f98);\n}\n\n.embed-brand-mark {\n  background: var(--accent);\n  color: #0e0f12;\n  border-radius: 3px;\n  padding: 2px 4px;\n  font-size: 10px;\n}\n\n/* ── Slice Lab (chop beats) ─────────────────────────────────────────────── */\n\n.slice-lab {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  padding: 10px 12px;\n  background: var(--bg-panel-2);\n  margin-bottom: 10px;\n}\n\n.slice-lab-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.slice-drop {\n  min-height: 54px;\n}\n\n.slice-wave {\n  height: 84px;\n  border-radius: 5px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  overflow: hidden;\n  cursor: pointer;\n}\n\n.slice-canvas {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n.slice-info {\n  font-size: 11px;\n  color: var(--text-dim, #8a8f98);\n  line-height: 1.5;\n}\n\n.slice-modes {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.slice-lab-toggle {\n  margin-bottom: 8px;\n}\n\n/* ── Sample-to-beat modal ──────────────────────────────────────────────── */\n\n.slice-dialog-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 220;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 24px;\n  background: rgba(0, 0, 0, 0.58);\n}\n\n.slice-dialog {\n  width: min(1080px, 100%);\n  max-height: min(820px, 92vh);\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  box-shadow: 0 18px 60px rgba(0, 0, 0, 0.55);\n}\n\n.slice-dialog-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 14px 18px;\n  border-bottom: 1px solid var(--border);\n}\n\n.slice-dialog-header h2 {\n  margin: 2px 0 0;\n  font-size: 18px;\n  letter-spacing: 1px;\n}\n\n.slice-dialog-kicker {\n  color: var(--accent);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n}\n\n.slice-dialog-body {\n  min-height: 0;\n  display: grid;\n  grid-template-columns: minmax(240px, 290px) minmax(0, 1fr);\n}\n\n.slice-dialog-browser {\n  min-height: 0;\n  overflow-y: auto;\n  padding: 14px;\n  border-right: 1px solid var(--border);\n}\n\n.slice-dialog-editor {\n  min-width: 0;\n  overflow-y: auto;\n  padding: 18px;\n}\n\n.slice-dialog-source-meta,\n.slice-dialog-selection-head,\n.slice-dialog-actions {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.slice-dialog-source-meta {\n  justify-content: space-between;\n  margin-bottom: 12px;\n  color: var(--text-dim);\n  font-size: 11px;\n}\n\n.slice-dialog-source-meta strong {\n  color: var(--text);\n  font-size: 14px;\n}\n\n.slice-dialog-canvas {\n  width: 100%;\n  height: 190px;\n  display: block;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  cursor: crosshair;\n  touch-action: none;\n}\n\n.slice-dialog-mode-row,\n.slice-dialog-controls {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.slice-dialog-mode-row {\n  margin: 12px 0 8px;\n}\n\n.slice-dialog-zoom-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  align-items: center;\n  margin: 8px 0 12px;\n  padding: 6px 8px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border-soft);\n  border-radius: 6px;\n}\n\n.slice-zoom-hint {\n  font-family: var(--mono);\n  font-size: 9px;\n  color: var(--text-faint);\n  margin-left: 4px;\n}\n\n.slice-dialog-selection {\n  padding: 12px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  background: var(--bg-panel-2);\n}\n\n.slice-dialog-selection-head {\n  justify-content: space-between;\n  margin-bottom: 12px;\n  color: var(--text-dim);\n  font-size: 11px;\n}\n\n.slice-dialog-selection-head strong {\n  color: var(--accent);\n}\n\n.slice-dialog-controls {\n  align-items: end;\n}\n\n.slice-number {\n  min-width: 100px;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.slice-number span {\n  color: var(--text-dim);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 1px;\n}\n\n.slice-number input {\n  width: 100%;\n  box-sizing: border-box;\n  padding: 6px 7px;\n  color: var(--text);\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  font: inherit;\n  font-size: 11px;\n}\n\n.slice-number input:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.slice-check {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 28px;\n  color: var(--text-dim);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.8px;\n}\n\n.slice-dialog-actions {\n  flex-wrap: wrap;\n  margin-top: 14px;\n}\n\n.slice-dialog-spacer {\n  flex: 1;\n}\n\n.slice-dialog-status,\n.slice-dialog-empty {\n  margin-top: 10px;\n  color: var(--text-dim);\n  font-size: 11px;\n}\n\n.slice-dialog-status {\n  color: var(--accent);\n}\n\n.pad-slice-controls {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin: 12px 0;\n  padding: 10px;\n  border: 1px solid var(--border);\n  border-radius: 5px;\n  background: var(--bg-panel-2);\n}\n\n@media (max-width: 760px) {\n  .slice-dialog-backdrop {\n    align-items: stretch;\n    padding: 8px;\n  }\n\n  .slice-dialog {\n    max-height: 100%;\n  }\n\n  .slice-dialog-body {\n    grid-template-columns: 1fr;\n    overflow-y: auto;\n  }\n\n  .slice-dialog-browser {\n    max-height: 230px;\n    border-right: 0;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .slice-dialog-editor {\n    overflow: visible;\n    padding: 12px;\n  }\n\n  .slice-dialog-source-meta {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .slice-dialog-canvas {\n    height: 140px;\n  }\n\n  .slice-dialog-spacer {\n    display: none;\n  }\n}\n\n/* ── Assist panel (iterate on your pattern) ─────────────────────────────── */\n\n.assist-panel {\n  min-width: 340px;\n  max-width: 400px;\n}\n\n.assist-seed {\n  display: flex;\n  gap: 8px;\n  align-items: flex-end;\n}\n\n.assist-seed .collab-field {\n  flex: 1;\n}\n\n.assist-preview {\n  border: 1px solid var(--border);\n  padding: 8px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.assist-preview-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  color: var(--text-dim, #8a8f98);\n  font-size: 10px;\n  letter-spacing: 0.08em;\n}\n\n.assist-preview-header select {\n  background: var(--bg-raise);\n  color: var(--text);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  padding: 3px 5px;\n  font: inherit;\n}\n\n.assist-engine {\n  margin-left: auto;\n  margin-right: 8px;\n  color: var(--text-faint, #626873);\n  font-size: 9px;\n  letter-spacing: 0.04em;\n}\n\n.assist-preview-meta {\n  color: var(--text-dim, #8a8f98);\n  font-size: 10px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.assist-preview-grid {\n  display: grid;\n  grid-template-columns: repeat(16, minmax(8px, 1fr));\n  gap: 2px;\n}\n\n.assist-preview-cell {\n  height: 12px;\n  background: var(--bg-raise);\n  border-radius: 2px;\n}\n\n.assist-preview-cell.beat {\n  box-shadow: inset 1px 0 0 var(--border);\n}\n\n.assist-preview-cell.active {\n  background: var(--accent);\n}\n\n.assist-ops {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.assist-op {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  border-top: 1px solid var(--border);\n  padding-top: 10px;\n}\n\n.assist-op-row {\n  display: flex;\n  gap: 8px;\n}\n\n.assist-op-row .collab-field {\n  flex: 1;\n}\n\n/* ── Freesound section (CC0 imports) ────────────────────────────────────── */\n\n.freesound-section {\n  margin-bottom: 6px;\n}\n\n.freesound-toggle {\n  width: 100%;\n}\n\n.freesound-body {\n  margin-top: 6px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.freesound-search {\n  display: flex;\n  gap: 6px;\n}\n\n.freesound-search input {\n  flex: 1;\n  min-width: 0;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  padding: 6px 8px;\n  font-size: 12px;\n  font-family: inherit;\n}\n.freesound-error {\n  font-size: 11px;\n  color: #ef4444;\n  line-height: 1.4;\n}\n\n.freesound-results {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  max-height: 200px;\n  overflow-y: auto;\n}\n\n.freesound-name {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 12px;\n  text-align: left;\n}\n\n.freesound-name em {\n  color: var(--text-dim, #8a8f98);\n  font-style: normal;\n  font-size: 10px;\n}\n\n.freesound-token a {\n  color: var(--accent);\n}\n\n/* ── Touch / tablet support ─────────────────────────────────────────────── */\n\n/* Kill the double-tap zoom delay everywhere; individual drag surfaces opt out below. */\nhtml {\n  touch-action: manipulation;\n}\n\n.audio-unlock {\n  position: fixed;\n  bottom: 18px;\n  left: 50%;\n  transform: translateX(-50%);\n  z-index: 200;\n  background: var(--accent);\n  color: #0e0f12;\n  border: none;\n  border-radius: 8px;\n  padding: 14px 22px;\n  font-size: 14px;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);\n  cursor: pointer;\n}\n\n@media (pointer: coarse) {\n  /* 44px-class hit targets for the primary touch surfaces. */\n  .btn {\n    min-height: 42px;\n    min-width: 42px;\n  }\n\n  .btn-small {\n    min-height: 36px;\n    min-width: 36px;\n  }\n\n  /* History buttons hard-set a 28×26 box (specificity beats .btn) — without\n     this they stay untappable at the phone-class target size. */\n  .btn-history {\n    min-width: 44px;\n    width: 44px;\n    height: 44px;\n  }\n\n  .row-pad,\n  .row-toggle {\n    min-height: 42px;\n  }\n\n  .sample-row,\n  .preset-chip {\n    min-height: 40px;\n  }\n\n  .preset-chip {\n    padding: 6px 12px;\n  }\n\n  .sequencer-ruler .ruler-tick {\n    font-size: 13px;\n  }\n\n  .preset-search,\n  .collab-field input,\n  .freesound-search input {\n    min-height: 42px;\n  }\n\n  /* Audio-clip fade/gain handles are 7-12px mouse targets. clip-path clips\n     any ::before pad, so grow the handles themselves for fingers. */\n  .arr-audio-clip-handle-fade {\n    width: 22px;\n    height: 22px;\n  }\n\n  .arr-audio-clip-handle-fade.left {\n    left: 4px;\n  }\n\n  .arr-audio-clip-handle-fade.right {\n    right: 4px;\n  }\n\n  .arr-audio-clip-handle-gain {\n    width: 44px;\n    height: 14px;\n  }\n\n  /* The p-lock amount bar is a 4px strip; the finger needs a wider grab. */\n  .step-amount-track::before {\n    content: \"\";\n    position: absolute;\n    inset: -8px 0;\n  }\n}\n\n/* Drag surfaces: the browser must not steal touches for scrolling —\n   velocity drags and number scrubs are the interaction. */\n.step,\n.drag-number,\n.slider-track {\n  touch-action: none;\n  user-select: none;\n  -webkit-user-select: none;\n  -webkit-touch-callout: none;\n}\n\n.fx-preset-select,\n.fx-sidechain-picker select,\n.channel-bus-select select {\n  min-height: 28px;\n  background: var(--panel-strong, #171b24);\n  color: inherit;\n  border: 1px solid var(--line, #343b4a);\n  border-radius: 4px;\n  padding: 3px 6px;\n}\n\n.eq-response-curve {\n  height: 62px;\n  margin: 5px 0 8px;\n  position: relative;\n  background: linear-gradient(to bottom, transparent 49%, rgba(255, 255, 255, 0.16) 50%, transparent 51%);\n  border: 1px solid var(--line, #343b4a);\n}\n\n.eq-response-curve svg {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n.eq-response-line {\n  fill: none;\n  stroke: #56d6b1;\n  stroke-width: 2;\n  vector-effect: non-scaling-stroke;\n}\n.eq-response-zero {\n  fill: none;\n  stroke: rgba(255, 255, 255, 0.22);\n  stroke-width: 1;\n  vector-effect: non-scaling-stroke;\n}\n.eq-response-curve span {\n  position: absolute;\n  right: 5px;\n  bottom: 3px;\n  font-size: 9px;\n  color: var(--muted, #8992a5);\n}\n\n.fx-sidechain-picker {\n  display: flex;\n  gap: 8px;\n  align-items: end;\n  flex-wrap: wrap;\n  margin: 8px 0;\n}\n.fx-sidechain-picker .fx-param-select {\n  min-width: 180px;\n}\n.fx-sidechain-status {\n  color: var(--muted, #8992a5);\n  font-size: 11px;\n  padding-bottom: 6px;\n}\n.channel-bus-select {\n  display: grid;\n  gap: 3px;\n  min-width: 100px;\n}\n\n.master-loudness-readout {\n  display: grid;\n  /* 1fr tracks (not auto): value text changes (-INF ↔ numbers) must not\n     shift column widths. */\n  grid-template-columns: repeat(2, minmax(95px, 1fr));\n  gap: 3px 8px;\n  align-content: center;\n  font:\n    10px/1.2 ui-monospace,\n    SFMono-Regular,\n    Consolas,\n    monospace;\n  font-variant-numeric: tabular-nums;\n  color: var(--muted, #8992a5);\n}\n.master-loudness-readout > span {\n  min-width: 95px;\n  white-space: nowrap;\n}\n.master-loudness-readout .btn {\n  grid-column: 1 / -1;\n  justify-self: start;\n  font-size: 9px;\n}\n.master-mix-check {\n  display: grid;\n  gap: 2px;\n  align-content: center;\n  color: #f59e0b;\n  font-size: 10px;\n  max-width: 190px;\n  /* One reserved line inside the fixed warnings row — overflow clips\n     instead of pushing the wall around. */\n  white-space: nowrap;\n  overflow: hidden;\n}\n\n.context-menu {\n  position: fixed;\n  background: linear-gradient(180deg, rgba(33, 36, 43, 0.92), rgba(21, 23, 28, 0.94));\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: 10px;\n  padding: 6px;\n  min-width: 190px;\n  z-index: 300;\n  box-shadow:\n    0 16px 48px rgba(0, 0, 0, 0.55),\n    0 0 0 1px rgba(0, 0, 0, 0.4),\n    inset 0 1px 0 rgba(255, 255, 255, 0.07);\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.context-menu-header {\n  font-size: 10px;\n  color: var(--text-faint);\n  padding: 4px 8px;\n  border-bottom: 1px solid var(--border-soft);\n  margin-bottom: 4px;\n  letter-spacing: 0.5px;\n}\n\n.context-menu button {\n  text-align: left;\n  padding: 6px 10px;\n  background: transparent;\n  border: none;\n  color: var(--text);\n  font-size: 12px;\n  border-radius: 6px;\n  cursor: pointer;\n  transition:\n    background 120ms ease,\n    color 120ms ease;\n}\n\n.context-menu button:hover:not(:disabled) {\n  background: var(--accent-soft);\n  color: var(--accent);\n}\n\n.context-menu button:disabled {\n  opacity: 0.4;\n  cursor: default;\n}\n\n.context-menu hr {\n  border: none;\n  height: 1px;\n  background: var(--border-soft);\n  margin: 4px 0;\n}\n\n.arr-ruler {\n  position: relative;\n}\n\n.arr-lane {\n  position: relative;\n}\n\n.arr-time-range {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  background: rgba(245, 158, 11, 0.12);\n  border-left: 1px solid rgba(245, 158, 11, 0.6);\n  border-right: 1px solid rgba(245, 158, 11, 0.6);\n  pointer-events: none;\n  z-index: 2;\n}\n\n.arr-time-range-lane {\n  background: rgba(245, 158, 11, 0.08);\n}\n.arr-audio-clip {\n  position: absolute;\n  top: 4px;\n  height: 48px;\n  background: linear-gradient(180deg, rgba(99, 102, 241, 0.18), rgba(99, 102, 241, 0.08));\n  border: 1px solid rgba(99, 102, 241, 0.5);\n  border-radius: 8px;\n  overflow: hidden;\n  display: flex;\n  align-items: stretch;\n  cursor: grab;\n  z-index: 3;\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.06),\n    0 2px 8px rgba(0, 0, 0, 0.35);\n  transition:\n    border-color 120ms ease,\n    box-shadow 120ms ease,\n    filter 120ms ease;\n}\n.arr-audio-clip:hover {\n  filter: brightness(1.12);\n}\n.arr-audio-clip.selected {\n  border-color: var(--accent);\n  box-shadow:\n    inset 0 1px 0 rgba(255, 255, 255, 0.08),\n    0 0 0 1px var(--accent),\n    0 0 16px rgba(245, 158, 11, 0.25);\n}\n.arr-audio-clip.selected {\n  border-color: var(--accent);\n  box-shadow: 0 0 0 1px var(--accent);\n}\n.arr-audio-clip.current {\n  border-color: rgba(245, 158, 11, 0.6);\n}\n.arr-audio-clip .audio-waveform {\n  flex: 1;\n  display: block;\n}\n.arr-audio-clip .audio-waveform-empty {\n  font-size: 10px;\n  color: var(--muted);\n  padding: 6px;\n}\n.arr-audio-clip-label {\n  position: absolute;\n  top: 2px;\n  left: 4px;\n  font-size: 10px;\n  color: var(--text);\n  background: rgba(0, 0, 0, 0.45);\n  padding: 0 4px;\n  border-radius: 2px;\n  pointer-events: none;\n}\n.arr-audio-clip-handle {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 8px;\n  background: rgba(255, 255, 255, 0.08);\n  cursor: ew-resize;\n}\n.arr-audio-clip-handle.left {\n  left: 0;\n  border-right: 1px dashed rgba(255, 255, 255, 0.25);\n}\n.arr-audio-clip-handle.right {\n  right: 0;\n  border-left: 1px dashed rgba(255, 255, 255, 0.25);\n}\n.arr-audio-clip-fades {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  pointer-events: none;\n  display: flex;\n  justify-content: space-between;\n}\n.arr-audio-fade {\n  background: linear-gradient(90deg, rgba(245, 158, 11, 0.35), transparent);\n  height: 100%;\n}\n.arr-audio-fade.out {\n  background: linear-gradient(270deg, rgba(245, 158, 11, 0.35), transparent);\n}\n.arr-audio-clip-handle-fade {\n  position: absolute;\n  top: 0;\n  width: 12px;\n  height: 12px;\n  background: rgba(245, 158, 11, 0.92);\n  cursor: ew-resize;\n  z-index: 4;\n  border: 1px solid rgba(255, 255, 255, 0.25);\n}\n.arr-audio-clip-handle-fade.left {\n  left: 8px;\n  clip-path: polygon(0 0, 100% 0, 0 100%);\n  border-radius: 0 0 2px 0;\n}\n.arr-audio-clip-handle-fade.right {\n  right: 8px;\n  clip-path: polygon(100% 0, 100% 100%, 0 0);\n  border-radius: 0 0 0 2px;\n}\n.arr-audio-clip-handle-gain {\n  position: absolute;\n  top: 0;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 28px;\n  height: 7px;\n  background: rgba(99, 102, 241, 0.95);\n  border: 1px solid rgba(255, 255, 255, 0.3);\n  border-top: none;\n  border-radius: 0 0 3px 3px;\n  cursor: ns-resize;\n  z-index: 4;\n}\n.arr-audio-clip-handle-gain::after {\n  content: \"\";\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  transform: translate(-50%, -50%);\n  width: 14px;\n  height: 2px;\n  background: rgba(255, 255, 255, 0.85);\n  border-radius: 1px;\n}\n.arr-audio-clip-handle-fade:hover,\n.arr-audio-clip-handle-gain:hover {\n  filter: brightness(1.15);\n}\n\n/* ── Warp pins (FL/Slicex-style, draggable on the waveform) ── */\n.warp-pins-overlay {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  z-index: 2;\n}\n.warp-pin {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  width: 0;\n  pointer-events: none;\n}\n.warp-pin-line {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  left: -1px;\n  width: 2px;\n  background: rgba(245, 158, 11, 0.7);\n  box-shadow: 0 0 6px rgba(245, 158, 11, 0.55);\n  pointer-events: none;\n}\n.warp-pin-handle {\n  position: absolute;\n  top: 1px;\n  left: -6px;\n  width: 12px;\n  height: 12px;\n  padding: 0;\n  background: rgba(245, 158, 11, 0.95);\n  border: 1px solid rgba(255, 255, 255, 0.5);\n  box-shadow:\n    0 0 8px rgba(245, 158, 11, 0.8),\n    0 0 2px rgba(255, 255, 255, 0.6);\n  transform: rotate(45deg);\n  border-radius: 2px;\n  cursor: ew-resize;\n  pointer-events: auto;\n  transition:\n    filter 120ms ease,\n    box-shadow 120ms ease;\n}\n.warp-pin-handle:hover {\n  filter: brightness(1.25);\n  box-shadow:\n    0 0 12px rgba(245, 158, 11, 1),\n    0 0 3px rgba(255, 255, 255, 0.8);\n}\n.warp-pin.dragging .warp-pin-line {\n  background: #fbbf24;\n  width: 3px;\n  box-shadow: 0 0 10px rgba(251, 191, 36, 0.9);\n}\n.warp-pin.dragging .warp-pin-handle {\n  filter: brightness(1.3);\n  box-shadow:\n    0 0 14px rgba(251, 191, 36, 1),\n    0 0 4px rgba(255, 255, 255, 0.9);\n}\n.warp-pin.disabled .warp-pin-line {\n  background: rgba(245, 158, 11, 0.3);\n}\n.warp-pin.disabled .warp-pin-handle {\n  background: rgba(245, 158, 11, 0.4);\n  cursor: not-allowed;\n}\n\n/* ── Dice Tray ─────────────────────────────────────────────────────── */\n.dice-tray {\n  padding: 12px 16px;\n  background: var(--bg-panel);\n  border-top: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.dice-tray-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.dice-tray-title {\n  font-family: var(--mono);\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  color: var(--text);\n}\n.dice-tray-hint {\n  font-size: 11px;\n  color: var(--text-faint);\n}\n.dice-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n.dice-intent-sliders {\n  gap: 12px;\n  padding: 6px 0;\n  border-top: 1px solid var(--border-soft);\n  border-bottom: 1px solid var(--border-soft);\n}\n.dice-slider {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  font-size: 10px;\n  color: var(--text-dim);\n  min-width: 90px;\n}\n.dice-slider span {\n  font-family: var(--mono);\n  font-size: 9px;\n}\n.dice-slider input[type=\"range\"] {\n  width: 90px;\n}\n.dice-field {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  font-size: 11px;\n  color: var(--text-dim);\n}\n.dice-field span {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.06em;\n}\n.dice-field select,\n.dice-field input {\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  color: var(--text);\n  border-radius: 4px;\n  padding: 4px 8px;\n  font-size: 12px;\n}\n.dice-seed-field {\n  flex-direction: row;\n  align-items: center;\n}\n.dice-seed-field input {\n  width: 90px;\n}\n.dice-big {\n  font-size: 14px;\n  font-weight: 700;\n  padding: 10px 18px;\n  border-radius: 6px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  color: var(--text);\n  cursor: pointer;\n}\n.dice-big:hover {\n  border-color: var(--accent);\n}\n.dice-big.dice-active {\n  background: var(--accent-soft);\n  border-color: var(--accent);\n  color: var(--accent);\n}\n.dice-jitter {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  margin-left: 8px;\n}\n.dice-jitter label {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 11px;\n  color: var(--text-dim);\n}\n.dice-jitter input[type=\"range\"] {\n  width: 100px;\n}\n.dice-jitter-hint {\n  font-size: 10px;\n  color: var(--text-faint);\n}\n.dice-mode-switch {\n  display: flex;\n  gap: 4px;\n}\n.dice-locks {\n  gap: 6px;\n}\n.dice-locks-label {\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--text-faint);\n  letter-spacing: 0.06em;\n}\n.dice-lock {\n  font-size: 11px;\n  padding: 3px 8px;\n}\n.dice-history {\n  gap: 8px;\n}\n.dice-history-label {\n  font-family: var(--mono);\n  font-size: 10px;\n  color: var(--text-faint);\n}\n.dice-history-strip {\n  display: flex;\n  gap: 2px;\n  flex: 1;\n  overflow-x: auto;\n  padding: 2px 0;\n  scrollbar-width: thin;\n}\n.dice-history-dot {\n  width: 22px;\n  height: 22px;\n  border-radius: 50%;\n  border: 1px solid var(--border);\n  background: var(--bg-raise);\n  color: var(--text-dim);\n  font-size: 10px;\n  cursor: pointer;\n  flex-shrink: 0;\n}\n.dice-history-dot.active {\n  border-color: var(--accent);\n  color: var(--accent);\n  background: var(--accent-soft);\n}\n.dice-history-dot.fav {\n  color: var(--accent);\n}\n.dice-seed-display {\n  font-family: var(--mono);\n  font-size: 11px;\n  color: var(--text-dim);\n  background: var(--bg-raise);\n  padding: 2px 6px;\n  border-radius: 4px;\n  border: 1px solid var(--border);\n}\n.dice-preview {\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  padding: 8px;\n  background: var(--bg-panel-2);\n}\n.dice-preview-header {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-family: var(--mono);\n  font-size: 11px;\n  color: var(--text-dim);\n  margin-bottom: 6px;\n}\n.dice-preview-meta {\n  flex: 1;\n  font-size: 10px;\n  color: var(--text-faint);\n}\n.dice-preview-empty {\n  font-size: 11px;\n  color: var(--text-faint);\n  padding: 8px;\n}\n/* MELODIC dice target — mini note strip (pitch = height, time = width). */\n.dice-melodic-preview {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.dice-melodic-meta {\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 0.6px;\n  color: var(--text-dim);\n}\n\n.dice-melodic-grid {\n  position: relative;\n  height: 52px;\n  background: var(--bg-panel-2);\n  border: 1px solid var(--border-soft);\n  border-radius: 3px;\n  overflow: hidden;\n}\n\n.dice-melodic-note {\n  position: absolute;\n  height: 4px;\n  background: var(--accent);\n  border-radius: 2px;\n  opacity: 0.9;\n}\n\n.dice-preview-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n.dice-preview-ruler {\n  display: flex;\n  gap: 2px;\n  margin-left: 36px;\n}\n.dice-preview-step {\n  width: 18px;\n  font-size: 9px;\n  text-align: center;\n  color: var(--text-faint);\n}\n.dice-preview-step.beat {\n  color: var(--text-dim);\n  font-weight: 700;\n}\n.dice-preview-row {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n}\n.dice-preview-pad {\n  width: 36px;\n  font-size: 9px;\n  color: var(--text-dim);\n  text-align: right;\n  padding-right: 4px;\n  font-family: var(--mono);\n}\n.dice-preview-cell {\n  width: 18px;\n  height: 14px;\n  border-radius: 2px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border-soft);\n}\n.dice-preview-cell.beat {\n  border-color: var(--border);\n}\n.dice-preview-cell.active {\n  background: var(--accent);\n  border-color: var(--accent);\n}\n.dice-footer-hint {\n  font-size: 10px;\n  color: var(--text-faint);\n  font-family: var(--mono);\n}\n.dice-footer-hint kbd {\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 2px;\n  padding: 0 4px;\n  font-size: 10px;\n  margin: 0 1px;\n}\n/* ---------- Floating Instrument Plugin (native, not VST) ---------- */\n.floating-plugin {\n  position: absolute;\n  z-index: 120;\n  min-width: 380px;\n  max-width: 560px;\n  background: var(--bg-panel);\n  border: 1px solid #2f3542;\n  border-radius: 8px;\n  box-shadow:\n    0 16px 40px rgba(0, 0, 0, 0.55),\n    0 0 0 1px rgba(245, 158, 11, 0.18);\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  max-height: 78vh;\n}\n\n.floating-plugin-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 8px 10px;\n  background: linear-gradient(180deg, var(--bg-raise), var(--bg-panel-2));\n  border-bottom: 1px solid var(--border);\n  cursor: grab;\n  user-select: none;\n}\n\n.floating-plugin-header:active {\n  cursor: grabbing;\n}\n\n.floating-plugin-title {\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 1.4px;\n  color: var(--accent);\n  font-family: var(--mono);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.floating-plugin-actions {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.floating-plugin-mode {\n  display: flex;\n  gap: 4px;\n}\n\n.floating-plugin-body {\n  padding: 12px;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  background: var(--bg-panel);\n}\n\n.floating-plugin-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 10px 12px;\n}\n\n.floating-plugin-stack {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.floating-plugin-pad-switch {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 6px 8px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border-soft);\n  border-radius: 4px;\n}\n\n.floating-plugin-badge {\n  font-family: var(--mono);\n  font-size: 8px;\n  letter-spacing: 0.8px;\n  padding: 2px 6px;\n  border-radius: 3px;\n  background: var(--bg);\n  border: 1px solid var(--border-soft);\n  color: var(--text-faint);\n}\n\n.floating-plugin-badge.is-synth {\n  color: var(--accent);\n  border-color: rgba(245, 158, 11, 0.35);\n  background: var(--accent-soft);\n}\n\n.floating-plugin-select select {\n  height: 24px;\n}\n\n.floating-plugin-empty {\n  font-size: 11px;\n  color: var(--text-faint);\n  padding: 12px 4px;\n  text-align: center;\n}\n\n/* Docked instrument editor: the dock owns its height and the editor presents\n   compact, paged controls without nested scrolling. */\n.instrument-plugin-panel {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  height: 100%;\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  background: var(--bg-panel);\n  container-type: inline-size;\n}\n\n.instrument-plugin-header {\n  display: flex;\n  flex: none;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 8px;\n  padding: 7px 12px;\n  background: linear-gradient(180deg, var(--bg-raise), var(--bg-panel-2));\n  border-bottom: 1px solid var(--border);\n}\n\n.instrument-plugin-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-left: auto;\n}\n\n.instrument-plugin-header .floating-plugin-title {\n  flex: 1 1 180px;\n  min-width: 0;\n}\n\n.instrument-plugin-body {\n  flex: 1 1 auto;\n  min-width: 0;\n  min-height: 0;\n  overflow: auto;\n  padding: 10px 12px;\n  background: var(--bg-panel);\n  overscroll-behavior: contain;\n}\n\n.instrument-plugin-panel .floating-plugin-grid {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n/* ── FXEQ panel (EQ-paint editor) ───────────────────────────────────────── */\n\n.fxeq-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  padding: 8px 10px;\n  background: var(--bg-panel-2);\n  margin-bottom: 8px;\n}\n\n.fxeq-degraded {\n  font-size: 11px;\n  color: #f59e0b;\n  background: var(--accent-soft);\n  border-radius: 4px;\n  padding: 5px 8px;\n}\n\n.fxeq-preset-row {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n}\n\n.fxeq-preset-select {\n  flex: 1;\n  min-width: 0;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  color: var(--text);\n  padding: 6px 8px;\n  font-size: 12px;\n  font-family: inherit;\n}\n\n.fxeq-band-chips {\n  display: flex;\n  gap: 4px;\n}\n\n.fxeq-canvas-wrap {\n  height: 110px;\n  border-radius: 5px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  overflow: hidden;\n  /* Split-handle drags are horizontal gestures — keep vertical scrolling. */\n  touch-action: pan-y;\n  cursor: crosshair;\n}\n\n.fxeq-canvas {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n.fxeq-module {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  border-top: 1px solid var(--border);\n  padding-top: 6px;\n}\n\n.fxeq-module-off {\n  opacity: 0.55;\n}\n\n.fxeq-module-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n.fxeq-module-tag {\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  color: #0e0f12;\n  border-radius: 3px;\n  padding: 2px 6px;\n}\n\n/* ── Ultina panel ───────────────────────────────────────────────────────── */\n\n.ultina-panel {\n  max-height: 480px;\n  overflow-y: auto;\n}\n\n/* FX editors share the rack's scroll area so low or split docks never create\n   nested scrollbars inside the selected device. */\n.fx-rack .ultina-panel,\n.fx-rack .ozvena-panel {\n  max-height: none;\n  overflow: visible;\n}\n\n.ultina-mod-on:not(.active) {\n  border-color: var(--accent);\n}\n\n.ultina-tag {\n  background: var(--accent);\n}\n\n.ultina-module-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n.ultina-enum-row {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.ultina-enum-row .collab-field {\n  flex: 1;\n  min-width: 120px;\n}\n\n.ultina-bool-row {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.ultina-eq {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.ultina-eq-curve {\n  width: 100%;\n  height: 88px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 5px;\n}\n\n.ultina-eq-blob {\n  fill: var(--accent);\n}\n\n/* ── Ultina MIX ASSIST ──────────────────────────────────────────────────── */\n\n.ultina-assist {\n  border: 1px solid var(--accent);\n  border-radius: 6px;\n  padding: 8px 10px;\n  background: var(--accent-soft);\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.ultina-assist-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.ultina-assist-title {\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.1em;\n  color: var(--accent);\n}\n\n.ultina-assist-opts {\n  display: flex;\n  gap: 8px;\n}\n\n.ultina-assist-opts .collab-field {\n  flex: 1;\n}\n\n.ultina-assist-summary {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  font-size: 11px;\n  line-height: 1.5;\n  color: var(--text);\n}\n\n.ultina-assist-note {\n  color: var(--text-dim, #8a8f98);\n  font-size: 10px;\n  margin-top: 4px;\n}\n\n/* ── Ultina PRO tools (delta / A-B / gain match) ────────────────────────── */\n\n.ultina-pro {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  border: 1px dashed var(--border);\n  border-radius: 6px;\n  padding: 8px 10px;\n}\n\n.ultina-pro-group {\n  display: flex;\n  gap: 6px;\n  align-items: center;\n  flex-wrap: wrap;\n}\n\n.ultina-pro-label {\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.1em;\n  color: var(--text-dim, #8a8f98);\n}\n\n.ultina-pro-lufs {\n  flex: 1;\n  min-width: 140px;\n}\n\n.ultina-gain-match-meta {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-top: 3px;\n  font: 9px var(--mono);\n}\n\n.ultina-gain-match-status {\n  color: var(--text-faint);\n  letter-spacing: 0.3px;\n}\n\n.ultina-gain-match-status[data-active=\"true\"] {\n  color: #4ade80;\n}\n\n.ultina-gain-match-note {\n  color: var(--text-faint);\n  text-align: right;\n}\n\n.ultina-ab-status {\n  color: var(--text-faint);\n  font: 9px var(--mono);\n  letter-spacing: 0.35px;\n  white-space: nowrap;\n}\n\n/* ── Shared flagship A/B compare controls ───────────────────────────────── */\n\n.effect-ab {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n  margin: 8px 0 2px;\n  padding-top: 7px;\n  border-top: 1px solid var(--border);\n}\n\n.effect-ab-label {\n  color: var(--text-dim, #8a8f98);\n  font: 700 9px var(--mono);\n  letter-spacing: 0.1em;\n}\n\n.effect-ab-status {\n  color: var(--text-faint);\n  font: 9px var(--mono);\n  letter-spacing: 0.35px;\n  white-space: nowrap;\n}\n\n/* ── Ultina LIVE meters ─────────────────────────────────────────────────── */\n\n.ultina-live {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.ultina-live-canvas {\n  width: 100%;\n  height: 96px;\n  border-radius: 5px;\n  border: 1px solid var(--border);\n  display: block;\n}\n\n.ultina-live-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.ultina-lufs {\n  font-family: ui-monospace, \"Cascadia Code\", monospace;\n  font-size: 16px;\n  font-weight: 700;\n  color: var(--accent);\n  min-width: 90px;\n}\n\n.ultina-truepeak {\n  font-family: ui-monospace, \"Cascadia Code\", monospace;\n  font-size: 11px;\n  color: var(--text-dim, #8a8f98);\n}\n\n.ultina-meter {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  flex: 1;\n  min-width: 110px;\n}\n\n.ultina-meter-label {\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  color: var(--text-dim, #8a8f98);\n}\n\n.ultina-meter-track {\n  flex: 1;\n  height: 6px;\n  background: var(--bg-raise);\n  border-radius: 3px;\n  overflow: hidden;\n}\n\n.ultina-meter-fill {\n  height: 100%;\n  width: 0%;\n  transition: width 0.08s linear;\n}\n\n.ultina-meter-text {\n  font-size: 10px;\n  color: var(--text-dim, #8a8f98);\n  min-width: 52px;\n}\n\n/* ── FXEQ band scalars (solo/mute/gain) ─────────────────────────────────── */\n\n.fxeq-peaks-wrap {\n  height: 14px;\n  margin-top: 4px;\n  border-radius: 4px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  overflow: hidden;\n}\n\n.fxeq-peaks-canvas {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n.fxeq-band-scalars {\n  display: flex;\n  gap: 6px;\n  align-items: flex-start;\n}\n\n/* Numeric crossover fallback under the band map (touch/precision). The\n   split lines on the canvas are 8px mouse targets — this row is the exact\n   entry path that never requires pixel-hunting. */\n.fxeq-split-editor {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  align-items: center;\n}\n\n.fxeq-split-field {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  font-size: 10px;\n  color: var(--text-faint);\n}\n\n.fxeq-split-input {\n  width: 62px;\n  height: 22px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  color: var(--text);\n  font: 11px var(--mono);\n  text-align: right;\n  padding: 0 4px;\n}\n\n.fxeq-split-input:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.fxeq-split-unit {\n  font-family: var(--mono);\n}\n\n@media (pointer: coarse) {\n  .fxeq-split-input {\n    height: 40px;\n    width: 76px;\n    font-size: 13px;\n  }\n\n  .fxeq-split-field {\n    font-size: 12px;\n  }\n}\n\n.fxeq-band-gain {\n  flex: 1;\n  min-width: 160px;\n}\n\n/* ── FXEQ A/B morph row, GR readout, band dyn EQ ────────────────────────── */\n\n.fxeq-morph-row {\n  display: flex;\n  gap: 6px;\n  align-items: center;\n  flex-wrap: wrap;\n  margin-top: 4px;\n}\n\n.fxeq-morph-row > .effect-ab {\n  margin: 0;\n  padding: 0;\n  border-top: 0;\n}\n\n.fxeq-morph-slider {\n  flex: 1;\n  min-width: 70px;\n  accent-color: #f59e0b;\n}\n\n.fxeq-peaks-wrap {\n  position: relative;\n}\n\n.fxeq-gr {\n  position: absolute;\n  right: 6px;\n  top: 1px;\n  font:\n    700 9px ui-monospace,\n    \"Cascadia Code\",\n    monospace;\n  color: #ef4444;\n  pointer-events: none;\n}\n\n.fxeq-band-dyn {\n  display: flex;\n  gap: 6px;\n  align-items: flex-start;\n  flex-wrap: wrap;\n}\n\n.fxeq-band-dyn > .slider {\n  flex: 1;\n  min-width: 110px;\n}\n\n.ultina-ref {\n  border-color: #22d3ee;\n}\n\n/* ── Ozvena panel (XY blend pad) ────────────────────────────────────────── */\n\n.ozvena-panel {\n  max-height: 560px;\n  overflow-y: auto;\n}\n\n.ozvena-weights {\n  display: flex;\n  gap: 10px;\n  font-family: ui-monospace, \"Cascadia Code\", monospace;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n/* Numeric blend-pad coordinates — the pad itself is a drag-only canvas, so\n   exact placement (and touch precision) lives in these two fields. */\n.ozvena-pad-numeric {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.ozvena-pad-field {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  font-size: 10px;\n  color: var(--text-faint);\n}\n\n.ozvena-pad-input {\n  width: 52px;\n  height: 20px;\n  background: var(--bg);\n  border: 1px solid var(--border);\n  border-radius: 3px;\n  color: var(--text);\n  font: 11px var(--mono);\n  text-align: right;\n  padding: 0 4px;\n}\n\n.ozvena-pad-input:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n@media (pointer: coarse) {\n  .ozvena-pad-input {\n    width: 68px;\n    height: 36px;\n    font-size: 13px;\n  }\n}\n\n.ozvena-pad {\n  width: 100%;\n  height: 220px;\n  border-radius: 5px;\n  border: 1px solid var(--border);\n  background: var(--bg);\n  cursor: crosshair;\n  display: block;\n}\n\n.ozvena-pad:focus-visible {\n  outline: 2px solid var(--accent, #7c9cff);\n  outline-offset: 1px;\n}\n\n.ozvena-engines {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.ozvena-engine {\n  border-top: 1px solid var(--border);\n  padding-top: 6px;\n}\n\n/* ── Landing page ─────────────────────────────────────────────────────────\n   Self-contained scroll container: the app shell sets body { overflow:hidden },\n   so the landing must own vertical scrolling or the page below the fold\n   (footer, closing CTA) is unreachable. All landing buttons use dedicated\n   .landing-btn classes — the studio's .btn forces height:30px, which shreds\n   any label with real padding. */\n\n.landing {\n  height: 100vh;\n  height: 100dvh;\n  overflow-y: auto;\n  overflow-x: hidden;\n  background: var(--bg);\n  color: var(--text);\n  font-family: var(--sans);\n  user-select: text;\n}\n\n.landing-shell {\n  max-width: 1120px;\n  margin: 0 auto;\n  padding: 0 28px;\n}\n\n/* Buttons */\n\n.landing-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  height: 40px;\n  padding: 0 18px;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  font-family: inherit;\n  font-size: 14px;\n  font-weight: 600;\n  letter-spacing: 0.01em;\n  text-decoration: none;\n  white-space: nowrap;\n  cursor: pointer;\n  transition:\n    background 0.15s,\n    border-color 0.15s,\n    color 0.15s,\n    box-shadow 0.15s,\n    transform 0.15s;\n}\n\n.landing-btn:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 2px;\n}\n\n.landing-btn-primary {\n  background: var(--accent);\n  color: #171106;\n  box-shadow: 0 8px 28px rgba(245, 158, 11, 0.18);\n}\n\n.landing-btn-primary:hover {\n  background: #fbb13c;\n  transform: translateY(-1px);\n  box-shadow: 0 10px 32px rgba(245, 158, 11, 0.24);\n}\n\n.landing-btn-primary:active {\n  transform: translateY(0);\n}\n\n.landing-btn-ghost {\n  border-color: var(--border);\n  color: var(--text);\n  background: transparent;\n}\n\n.landing-btn-ghost:hover {\n  border-color: #3a4050;\n  background: var(--bg-panel);\n}\n\n.landing-btn-sm {\n  height: 34px;\n  padding: 0 14px;\n  font-size: 13px;\n}\n\n.landing-btn-lg {\n  height: 48px;\n  padding: 0 26px;\n  font-size: 15px;\n  border-radius: 9px;\n}\n\n/* Nav */\n\n.landing-nav {\n  position: sticky;\n  top: 0;\n  z-index: 40;\n  background: rgba(14, 15, 18, 0.82);\n  backdrop-filter: blur(4px);\n  -webkit-backdrop-filter: blur(4px);\n  border-bottom: 1px solid var(--border-soft);\n}\n\n.landing-nav-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  height: 64px;\n}\n\n.landing-nav-actions {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.landing-brand {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  font-size: 14px;\n  font-weight: 700;\n  letter-spacing: 0.22em;\n}\n\n.landing-brand .embed-brand-mark {\n  background: var(--accent);\n  color: #0e0f12;\n  border-radius: 4px;\n  padding: 4px 6px;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0;\n}\n\n/* Hero */\n\n.landing-hero {\n  position: relative;\n  padding: 92px 0 104px;\n}\n\n.landing-hero::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: radial-gradient(640px 340px at 76% 28%, rgba(245, 158, 11, 0.09), transparent 70%);\n}\n\n.landing-hero-inner {\n  position: relative;\n  display: grid;\n  grid-template-columns: 1.05fr 0.95fr;\n  gap: 56px;\n  align-items: center;\n}\n\n.landing-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 22px;\n  padding: 6px 13px;\n  border: 1px solid rgba(245, 158, 11, 0.32);\n  border-radius: 999px;\n  background: rgba(245, 158, 11, 0.07);\n  color: var(--accent);\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: 0.03em;\n}\n\n.landing-badge-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--accent);\n}\n\n.landing-hero h1 {\n  margin: 0 0 18px;\n  font-size: clamp(38px, 5.2vw, 60px);\n  font-weight: 800;\n  line-height: 1.04;\n  letter-spacing: -0.025em;\n}\n\n.landing-sub {\n  max-width: 46ch;\n  margin: 0 0 30px;\n  font-size: 17px;\n  line-height: 1.65;\n  color: var(--text-dim);\n}\n\n.landing-hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 12px;\n}\n\n.landing-hint {\n  display: block;\n  margin-top: 16px;\n  font-size: 12.5px;\n  color: var(--text-faint);\n}\n\n/* Hero player (real embed renderer) */\n\n.landing-hero-player .embed-root {\n  position: static;\n  height: 250px;\n  border: 1px solid #2c313c;\n  border-radius: 14px;\n  background: var(--bg-panel);\n  box-shadow:\n    0 24px 70px rgba(0, 0, 0, 0.55),\n    inset 0 1px 0 rgba(255, 255, 255, 0.04);\n}\n\n.landing-hero-player .embed-main {\n  padding: 16px 18px 6px;\n}\n\n.landing-hero-player .embed-footer {\n  padding: 6px 18px 14px;\n}\n\n/* Sections */\n\n.landing-section {\n  padding: 40px 0 56px;\n}\n\n.landing-section-tight {\n  padding-top: 24px;\n}\n\n.landing-section-head {\n  max-width: 560px;\n  margin: 0 auto 36px;\n  text-align: center;\n}\n\n.landing-eyebrow {\n  margin: 0 0 10px;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--accent);\n}\n\n.landing-section-head h2 {\n  margin: 0;\n  font-size: clamp(24px, 3vw, 32px);\n  font-weight: 700;\n  letter-spacing: -0.015em;\n}\n\n/* Cards */\n\n.landing-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 16px;\n}\n\n.landing-grid-3 {\n  grid-template-columns: repeat(3, 1fr);\n}\n\n.landing-card {\n  padding: 22px;\n  text-align: left;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  transition:\n    border-color 0.15s,\n    transform 0.15s;\n}\n\n.landing-card:hover {\n  border-color: #343b48;\n  transform: translateY(-2px);\n}\n.landing-card-icon {\n  display: inline-grid;\n  place-items: center;\n  width: 38px;\n  height: 38px;\n  border: 1px solid rgba(245, 158, 11, 0.22);\n  border-radius: 9px;\n  background: var(--accent-soft);\n  color: var(--accent);\n}\n\n.landing-card h3 {\n  margin: 14px 0 6px;\n  font-size: 14.5px;\n  font-weight: 600;\n  letter-spacing: 0.01em;\n}\n\n.landing-card p {\n  margin: 0;\n  font-size: 13.5px;\n  line-height: 1.65;\n  color: var(--text-dim);\n}\n\n.landing-step-n {\n  display: inline-grid;\n  place-items: center;\n  width: 32px;\n  height: 32px;\n  border: 1px solid rgba(245, 158, 11, 0.25);\n  border-radius: 8px;\n  background: var(--accent-soft);\n  color: var(--accent);\n  font-size: 14px;\n  font-weight: 700;\n}\n\n/* Closing CTA band */\n\n.landing-cta-band {\n  padding: 32px 0 88px;\n}\n\n.landing-cta-panel {\n  padding: 56px 32px;\n  text-align: center;\n  border: 1px solid var(--border);\n  border-radius: 16px;\n  background: radial-gradient(420px 220px at 50% 0%, rgba(245, 158, 11, 0.08), transparent 70%), var(--bg-panel);\n}\n\n.landing-cta-panel h2 {\n  margin: 0 0 10px;\n  font-size: clamp(22px, 3vw, 30px);\n  font-weight: 700;\n  letter-spacing: -0.015em;\n}\n\n.landing-cta-panel p {\n  margin: 0 0 28px;\n  font-size: 15px;\n  color: var(--text-dim);\n}\n\n/* Footer */\n\n.landing-footer {\n  border-top: 1px solid var(--border-soft);\n}\n\n.landing-footer-inner {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  flex-wrap: wrap;\n  padding-top: 26px;\n  padding-bottom: 26px;\n  font-size: 12.5px;\n  color: var(--text-faint);\n}\n\n@media (max-width: 960px) {\n  .landing-hero {\n    padding: 56px 0 72px;\n  }\n\n  .landing-hero-inner {\n    grid-template-columns: 1fr;\n    gap: 40px;\n  }\n\n  .landing-grid,\n  .landing-grid-3 {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (max-width: 640px) {\n  .landing-shell {\n    padding: 0 20px;\n  }\n\n  .landing-nav-actions .landing-btn-ghost {\n    display: none;\n  }\n\n  .landing-grid,\n  .landing-grid-3 {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* ── Onboarding tour ────────────────────────────────────────────────────── */\n\n.tour-card {\n  position: fixed;\n  bottom: 24px;\n  left: 50%;\n  transform: translateX(-50%);\n  z-index: 220;\n  width: min(460px, calc(100vw - 32px));\n  background: var(--bg-panel);\n  border: 1px solid var(--accent);\n  border-radius: 10px;\n  padding: 14px 16px;\n  box-shadow: 0 12px 48px rgba(0, 0, 0, 0.55);\n}\n\n.tour-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 8px;\n}\n\n.tour-brand {\n  background: var(--accent);\n  color: #0e0f12;\n  border-radius: 3px;\n  padding: 2px 5px;\n  font-size: 11px;\n  font-weight: 800;\n}\n\n.tour-title {\n  font-size: 14px;\n  font-weight: 800;\n  letter-spacing: 0.06em;\n  margin: 0 0 6px;\n}\n\n.tour-body {\n  font-size: 13px;\n  color: var(--text-dim, #b6bac2);\n  line-height: 1.55;\n  margin: 0 0 10px;\n}\n\n.tour-foot {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.tour-hint {\n  flex: 1;\n  font-size: 11px;\n  color: var(--text-dim, #8a8f98);\n}\n\n.tour-dots {\n  display: flex;\n  gap: 5px;\n}\n\n.tour-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--bg-raise);\n}\n\n.tour-dot.done {\n  background: var(--text-dim, #8a8f98);\n}\n\n.tour-dot.active {\n  background: var(--accent);\n}\n\n/* ---------- Beat Gallery (/gallery) ---------- */\n\n.gallery-root {\n  height: 100%;\n  overflow-y: auto;\n  background: var(--bg);\n  padding: 0 clamp(16px, 4vw, 56px) 48px;\n  user-select: text;\n}\n\n.gallery-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 28px 0 18px;\n  flex-wrap: wrap;\n}\n\n.gallery-brand {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n.gallery-brand-mark,\n.embed-brand-mark {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 40px;\n  height: 40px;\n  border-radius: 10px;\n  background: var(--accent);\n  color: #14100a;\n  font-family: var(--mono);\n  font-weight: 700;\n  font-size: 15px;\n}\n\n.gallery-brand h1 {\n  margin: 0;\n  font-size: 22px;\n  letter-spacing: 0.12em;\n}\n\n.gallery-brand p {\n  margin: 3px 0 0;\n  color: var(--text-dim);\n  font-size: 13px;\n  max-width: 520px;\n}\n\n.gallery-nav {\n  display: flex;\n  gap: 8px;\n}\n\n.gallery-publish {\n  margin-bottom: 18px;\n}\n\n.gallery-publish-toggle {\n  width: 100%;\n  padding: 14px;\n  border: 1px dashed var(--border);\n  border-radius: 10px;\n  color: var(--text-dim);\n  font-family: var(--mono);\n  font-size: 12px;\n  letter-spacing: 0.1em;\n  transition:\n    border-color 0.15s,\n    color 0.15s;\n}\n\n.gallery-publish-toggle:hover {\n  border-color: var(--accent);\n  color: var(--accent);\n}\n\n.gallery-publish-form {\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: var(--bg-panel);\n  padding: 14px;\n}\n\n.gallery-publish-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-family: var(--mono);\n  font-size: 11px;\n  letter-spacing: 0.14em;\n  color: var(--text-dim);\n  margin-bottom: 10px;\n}\n\n.gallery-publish-close {\n  color: var(--text-dim);\n  padding: 2px 6px;\n}\n\n.gallery-publish-close:hover {\n  color: var(--text);\n}\n\n.gallery-publish-row {\n  display: grid;\n  grid-template-columns: 2fr 1fr 1fr;\n  gap: 8px;\n  margin-bottom: 8px;\n}\n\n.gallery-publish-form input,\n.gallery-publish-form textarea {\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  color: var(--text);\n  font-family: var(--sans);\n  font-size: 13px;\n  padding: 9px 10px;\n  resize: vertical;\n}\n\n.gallery-publish-form input:focus,\n.gallery-publish-form textarea:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.gallery-publish-form textarea {\n  width: 100%;\n  font-family: var(--mono);\n  font-size: 11px;\n}\n\n.gallery-publish-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  margin-top: 10px;\n}\n\n.gallery-publish-status {\n  margin-top: 10px;\n  font-size: 12px;\n  color: var(--accent);\n}\n\n.gallery-filelabel {\n  display: inline-flex;\n  align-items: center;\n}\n\n.gallery-toolbar {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 10px;\n}\n\n.gallery-search {\n  flex: 1;\n  max-width: 420px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  color: var(--text);\n  padding: 10px 12px;\n  font-size: 13px;\n}\n\n.gallery-search:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.gallery-tagrow {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-bottom: 18px;\n}\n\n.gallery-tag {\n  padding: 3px 9px;\n  border-radius: 999px;\n  border: 1px solid var(--border);\n  background: var(--bg-panel);\n  color: var(--text-dim);\n  font-size: 11px;\n  font-family: var(--mono);\n}\n\n.gallery-tag:hover {\n  border-color: var(--accent);\n  color: var(--accent);\n}\n\n.gallery-tag-active {\n  border-color: var(--accent);\n  color: var(--accent);\n  background: var(--accent-soft);\n}\n\n.gallery-tag-count {\n  color: var(--text-faint);\n}\n\n/* B3 genre chips — structured intent genres, visually distinct from the\n   free-form #tags (amber outline instead of plain border). */\n.gallery-genrerow {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-bottom: 10px;\n}\n\n.gallery-genre {\n  padding: 3px 11px;\n  border-radius: 999px;\n  border: 1px solid rgba(245, 158, 11, 0.45);\n  background: transparent;\n  color: var(--accent);\n  font-size: 11px;\n  font-family: var(--mono);\n  letter-spacing: 0.04em;\n  cursor: pointer;\n}\n\n.gallery-genre:hover {\n  filter: brightness(1.15);\n}\n\n.gallery-genre-active {\n  background: var(--accent-soft);\n  box-shadow: 0 0 0 1px rgba(245, 158, 11, 0.45);\n}\n\n/* B1 regen button — shares the fork button chrome, amber accent marks it\n   as the intent-engine path. */\n.gallery-regen {\n  color: var(--accent);\n}\n\n.gallery-state {\n  padding: 40px 0;\n  text-align: center;\n  color: var(--text-dim);\n}\n\n.gallery-state-error code {\n  background: var(--bg-raise);\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n.gallery-hint {\n  font-size: 12px;\n  color: var(--text-faint);\n}\n\n.gallery-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));\n  gap: 14px;\n}\n\n.gallery-card {\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: var(--bg-panel);\n  padding: 14px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.gallery-card-head {\n  display: flex;\n  gap: 12px;\n  align-items: center;\n}\n\n.gallery-play {\n  flex: none;\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background: var(--accent-soft);\n  border: 1px solid var(--accent);\n  color: var(--accent);\n  font-size: 14px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.gallery-play:hover {\n  background: var(--accent);\n  color: #14100a;\n}\n\n.gallery-card-titlebox {\n  min-width: 0;\n}\n\n.gallery-card-title {\n  margin: 0;\n  font-size: 14px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.gallery-card-meta {\n  font-size: 11px;\n  color: var(--text-dim);\n  font-family: var(--mono);\n}\n\n.gallery-card-tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.gallery-embed .embed-root {\n  height: 200px;\n}\n\n.gallery-card-actions {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  align-items: center;\n  gap: 6px 8px;\n  margin-top: auto;\n}\n\n.gallery-open {\n  text-decoration: none;\n  display: inline-flex;\n  align-items: center;\n}\n\n.gallery-copylink {\n  color: var(--text-dim);\n  font-size: 11px;\n  font-family: var(--mono);\n  letter-spacing: 0.06em;\n}\n\n.gallery-copylink:hover {\n  color: var(--accent);\n}\n\n.gallery-report-toggle {\n  margin-left: auto;\n}\n\n.gallery-report {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px;\n  padding: 9px;\n  border: 1px solid var(--border-soft);\n  border-radius: 6px;\n  background: var(--bg);\n  color: var(--text-dim);\n  font-size: 10px;\n}\n\n.gallery-report label {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.gallery-report select {\n  min-width: 190px;\n  max-width: 100%;\n}\n\n.gallery-report small {\n  flex-basis: 100%;\n  color: var(--text-faint);\n  line-height: 1.35;\n}\n\n.gallery-report [role=\"status\"] {\n  color: var(--accent);\n  font-family: var(--mono);\n  letter-spacing: 0.04em;\n}\n\n.gallery-footer {\n  margin-top: 36px;\n  padding-top: 16px;\n  border-top: 1px solid var(--border-soft);\n  color: var(--text-faint);\n  font-size: 11px;\n  text-align: center;\n}\n\n@media (max-width: 640px) {\n  .gallery-publish-row {\n    grid-template-columns: 1fr;\n  }\n\n  .gallery-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* ---------- Collab presence cursors ---------- */\n\n.remote-cursor-dot {\n  position: absolute;\n  top: 2px;\n  right: 2px;\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  border: 1px solid rgba(255, 255, 255, 0.85);\n  box-shadow: 0 0 6px currentColor;\n  pointer-events: none;\n  z-index: 3;\n}\n\n.pr-remote-cursor {\n  position: absolute;\n  width: 9px;\n  height: 9px;\n  margin-top: 2px;\n  border-radius: 50%;\n  border: 1px solid rgba(255, 255, 255, 0.85);\n  box-shadow: 0 0 8px currentColor;\n  pointer-events: none;\n  z-index: 4;\n  transition:\n    left 0.12s ease-out,\n    top 0.12s ease-out;\n}\n\n/* ---------- Mobile layout V2: bottom sheets + fullscreen piano roll ---------- */\n\n/* Desktop dock: a real flex column so --dock-height + split apply.\n   Panels keep their intrinsic height up to the dock height; overflow scrolls. */\n.bottom-panels {\n  display: flex;\n  flex-direction: column;\n  height: var(--dock-height, 300px);\n  min-height: 0;\n  overflow: hidden;\n}\n.bottom-panels.sheet-collapsed {\n  height: auto;\n  overflow: visible;\n}\n.bottom-panels.sheet-collapsed .dock-slot,\n.bottom-panels.sheet-collapsed .dock-resize-handle {\n  display: none;\n}\n.bottom-panels.dock-split {\n  flex-direction: row;\n  align-items: stretch;\n  column-gap: 6px;\n}\n.dock-slot {\n  contain: layout style;\n  container-name: bottom-dock-slot;\n  container-type: inline-size;\n  flex: 1 1 0;\n  min-width: 0;\n  min-height: 0;\n  overflow-y: auto;\n  overflow-x: hidden;\n  display: flex;\n  flex-direction: column;\n}\n.dock-slot > * {\n  flex: 1 0 auto;\n  max-height: none;\n}\n\n/* Split panels must adapt to the width of their own slot, not the browser\n   viewport. Viewport media queries miss this case on wide monitors. */\n@container bottom-dock-slot (max-width: 1100px) {\n  .mod-panel {\n    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));\n  }\n}\n\n@container bottom-dock-slot (max-width: 780px) {\n  .arr-panel {\n    grid-template-columns: 1fr;\n    grid-template-rows: auto minmax(0, 1fr);\n    max-height: 420px;\n    overflow-y: auto;\n  }\n}\n\n@container bottom-dock-slot (max-width: 980px) {\n  .midi-creative-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n.bottom-panels .dock-resize-handle {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 7px;\n  flex: none;\n  cursor: row-resize;\n  background: transparent;\n  border: 0;\n  padding: 0;\n  touch-action: none;\n}\n.bottom-panels .dock-resize-handle span {\n  width: 42px;\n  height: 3px;\n  border-radius: 2px;\n  background: var(--border);\n  transition: background 0.15s;\n}\n.bottom-panels .dock-resize-handle:hover span,\n.bottom-panels .dock-resize-handle:focus-visible span {\n  background: var(--accent);\n}\n.sheet-handle {\n  display: none;\n}\n\n@media (max-width: 760px) {\n  /* Narrow phones: the row label shrinks so the step grid keeps usable width.\n     Sequencer.tsx reads the same number for its windowing geometry. */\n  :root {\n    --steps-label: 112px;\n  }\n\n  /* Bottom panels become a fixed, swipe-away-able sheet above the statusbar. */\n  .bottom-panels {\n    display: block;\n    position: fixed;\n    left: 0;\n    right: 0;\n    bottom: 26px; /* above the statusbar row */\n    z-index: 70;\n    max-height: 55vh;\n    overflow-y: auto;\n    background: var(--bg-panel);\n    border-top: 1px solid var(--border);\n    border-radius: 14px 14px 0 0;\n    box-shadow: 0 -12px 32px rgba(0, 0, 0, 0.45);\n    overscroll-behavior: contain;\n    padding-bottom: env(safe-area-inset-bottom, 0px);\n  }\n\n  .sheet-handle {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    height: 22px;\n    touch-action: none;\n    position: sticky;\n    top: 0;\n    background: var(--bg-panel);\n    z-index: 2;\n  }\n\n  .sheet-handle-bar {\n    width: 44px;\n    height: 4px;\n    border-radius: 999px;\n    background: var(--text-faint);\n  }\n\n  /* Collapsed: only the grab handle stays. */\n  .bottom-panels.sheet-collapsed > :not(.sheet-handle) {\n    display: none;\n  }\n\n  .statusbar {\n    padding-bottom: env(safe-area-inset-bottom, 0px);\n  }\n\n  .workspace {\n    /* The fixed sheet no longer occupies a grid row — stack the inspector\n       under the editor instead of squeezing a 280px side column. */\n    grid-template-columns: 1fr;\n    grid-template-rows: minmax(0, 1fr) auto;\n  }\n\n  .workspace .inspector {\n    max-height: 30vh;\n    overflow-y: auto;\n    border-top: 1px solid var(--border);\n    border-left: none;\n  }\n}\n\n/* Fullscreen piano roll — the editor takes the whole screen (tablets/phones).\n   Activated by state; the toggle button is only shown on narrow/touch screens. */\n.pianoroll-wrap.pr-fullscreen {\n  position: fixed;\n  inset: 0;\n  z-index: 80;\n  background: var(--bg);\n  padding: 8px 8px calc(8px + env(safe-area-inset-bottom, 0px));\n  overflow: auto;\n}\n\n.pr-fullscreen-toggle {\n  display: none; /* desktop shows it only when the roll would be cramped */\n}\n\n/* The roll is capped at 180px tall (≈12 of 61 semitones), so the fullscreen\n   toggle must be reachable on SHORT viewports too, not just narrow/touch:\n   a 1440×720 laptop with a docked mixer needs it exactly as much as a\n   phone does. */\n@media (max-width: 1100px), (max-height: 820px), (pointer: coarse) {\n  .pr-fullscreen-toggle {\n    display: inline-flex;\n  }\n}\n\n.pattern-midi-status {\n  padding: 4px 10px;\n  font-size: 11px;\n  font-family: var(--mono);\n  color: var(--accent);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n/* ---------- Gallery flywheel: stats, fork, remix chip ---------- */\n\n.gallery-card-stats {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n}\n\n.gallery-stat {\n  font-size: 11px;\n  font-family: var(--mono);\n  color: var(--text-dim);\n  background: var(--bg-raise);\n  border-radius: 999px;\n  padding: 2px 9px;\n}\n\n.gallery-you-badge {\n  margin-left: 8px;\n  font-size: 9px;\n  font-family: var(--mono);\n  letter-spacing: 0.1em;\n  color: var(--accent);\n  border: 1px solid var(--accent);\n  border-radius: 4px;\n  padding: 1px 5px;\n  vertical-align: middle;\n}\n\n.gallery-fork {\n  color: var(--accent);\n  font-size: 11px;\n  font-family: var(--mono);\n  letter-spacing: 0.06em;\n  padding: 4px 6px;\n  border-radius: 4px;\n}\n\n.gallery-fork:hover {\n  background: var(--accent-soft);\n}\n\n.gallery-remix-chip {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 8px;\n  padding: 7px 10px;\n  border: 1px solid var(--accent);\n  border-radius: 6px;\n  background: var(--accent-soft);\n  font-size: 12px;\n}\n\n.gallery-remix-chip button {\n  margin-left: auto;\n  color: var(--text-dim);\n  padding: 0 4px;\n}\n\n.gallery-remix-chip button:hover {\n  color: var(--text);\n}\n\n/* ---------- Timeline recording (arm + REC) ---------- */\n\n.arr-arm-select {\n  min-height: 28px;\n  max-width: 160px;\n  background: var(--bg-raise);\n  color: var(--text);\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  font-size: 11px;\n  padding: 3px 6px;\n}\n\n.arr-arm-select:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.arr-rec-saving,\n.arr-rec-error {\n  font-size: 11px;\n  font-family: var(--mono);\n}\n\n.arr-rec-error {\n  color: var(--stop);\n  max-width: 260px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.arr-rec-saving {\n  color: var(--text-dim);\n}\n\n.arr-recording-recovery {\n  display: grid;\n  gap: 6px;\n  margin: 6px 8px;\n  padding: 8px;\n  border: 1px solid var(--border);\n  border-left: 2px solid var(--accent);\n  background: var(--bg-panel);\n  font: 10px var(--mono);\n}\n\n.arr-recording-recovery > strong {\n  color: var(--accent);\n  letter-spacing: 0.08em;\n}\n\n.arr-recording-recovery-row {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.arr-recording-recovery-row > span {\n  flex: 1 1 220px;\n  min-width: 0;\n  color: var(--text-dim);\n}\n/* ---------- Project snapshots (history panel) ---------- */\n\n.snapshots-section {\n  margin-top: 10px;\n  padding-top: 8px;\n  border-top: 1px solid var(--border-soft);\n}\n\n.snapshots-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 8px 6px;\n}\n\n.snapshots-title {\n  font-size: 10px;\n  font-family: var(--mono);\n  letter-spacing: 0.14em;\n  color: var(--text-dim);\n}\n\n.snapshots-entry {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 3px 8px;\n  font-size: 11px;\n}\n\n.snapshots-entry:hover {\n  background: var(--bg-raise);\n}\n\n.snapshots-label {\n  flex: 1;\n  min-width: 0;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.snapshots-time {\n  color: var(--text-faint);\n  font-family: var(--mono);\n  font-size: 10px;\n  white-space: nowrap;\n}\n\n.snapshots-restore {\n  color: var(--accent);\n  font-size: 10px;\n  font-family: var(--mono);\n  letter-spacing: 0.06em;\n  padding: 2px 4px;\n}\n\n.snapshots-restore:hover {\n  background: var(--accent-soft);\n}\n\n.snapshots-delete {\n  color: var(--text-faint);\n  padding: 0 3px;\n}\n\n.snapshots-delete:hover {\n  color: var(--stop);\n}\n\n/* ── Wavetable panel (Phase 3 editing layer) ── */\n.wt-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 6px 4px 2px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n  margin-bottom: 6px;\n}\n\n.wt-canvas {\n  width: 100%;\n  height: auto;\n  background: rgba(10, 14, 22, 0.6);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: 4px;\n}\n\n.wt-caption {\n  display: flex;\n  justify-content: space-between;\n  font-size: 9px;\n  letter-spacing: 0.08em;\n  color: rgba(255, 255, 255, 0.45);\n  text-transform: uppercase;\n}\n\n.wt-mod-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.wt-mod-label {\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  color: rgba(255, 255, 255, 0.6);\n  width: 34px;\n}\n\n.wt-mod-select {\n  background: rgba(10, 14, 22, 0.6);\n  color: rgba(255, 255, 255, 0.85);\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  border-radius: 3px;\n  font-size: 10px;\n  padding: 1px 3px;\n}\n\n.wt-mod-arrow {\n  color: rgba(255, 255, 255, 0.35);\n  font-size: 10px;\n}\n\n.wt-mod-amt {\n  flex: 1;\n  min-width: 0;\n}\n\n/* ── Envelope editor ── */\n.env-editor {\n  padding: 4px 4px 0;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n  margin-bottom: 6px;\n}\n\n.env-svg {\n  width: 100%;\n  height: auto;\n  background: rgba(10, 14, 22, 0.6);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: 4px;\n  touch-action: none;\n}\n\n.env-curve {\n  fill: none;\n  stroke: rgba(120, 220, 180, 0.95);\n  stroke-width: 1.6;\n}\n\n.env-sus {\n  stroke: rgba(120, 220, 180, 0.55);\n  stroke-width: 1.5;\n  stroke-dasharray: 4 3;\n}\n\n.env-sus-hit {\n  stroke: transparent;\n  stroke-width: 12;\n  cursor: ns-resize;\n}\n\n.env-axis {\n  stroke: rgba(255, 255, 255, 0.18);\n}\n\n.env-handle {\n  fill: #7cdcb4;\n  stroke: rgba(0, 0, 0, 0.55);\n  cursor: ew-resize;\n}\n\n.env-handle.is-active {\n  fill: #ffffff;\n}\n\n.env-badge {\n  font-size: 8px;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  fill: rgba(255, 255, 255, 0.55);\n  cursor: pointer;\n}\n\n.env-badge:hover {\n  fill: #7cdcb4;\n}\n\n/* ── Randomize buttons ── */\n.floating-plugin-random {\n  display: flex;\n  gap: 3px;\n  margin-right: 4px;\n}\n\n/* ---------- Help overlay V2: search, alt bindings, gestures ---------- */\n\n.help-header .help-search {\n  flex: 1;\n  min-width: 140px;\n  background: var(--bg-raise);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  color: var(--text);\n  font-size: 12px;\n  padding: 7px 10px;\n}\n\n.help-header .help-search:focus {\n  outline: none;\n  border-color: var(--accent);\n}\n\n.help-bindings {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n}\n\n.help-binding {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.help-or {\n  font-size: 9px;\n  color: var(--text-faint);\n  font-family: var(--mono);\n}\n\n.help-kbd-alt {\n  opacity: 0.72;\n}\n\n.help-gestures {\n  margin-top: 12px;\n  padding-top: 8px;\n  border-top: 1px solid var(--border-soft);\n}\n\n.help-gestures .help-group-title {\n  margin-top: 4px;\n}\n\n.help-gesture-detail {\n  color: var(--text-dim);\n}\n/* ---------- Command palette (Ctrl+K) ---------- */\n\n.palette-overlay {\n  position: fixed;\n  inset: 0;\n  z-index: 120;\n  background: rgba(8, 9, 12, 0.6);\n  backdrop-filter: blur(2px);\n  display: flex;\n  justify-content: center;\n  align-items: flex-start;\n  padding: 10vh 16px 0;\n}\n\n.palette-card {\n  width: min(560px, 94vw);\n  max-height: 62vh;\n  display: flex;\n  flex-direction: column;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.55);\n  overflow: hidden;\n}\n\n.palette-input {\n  background: transparent;\n  border: none;\n  border-bottom: 1px solid var(--border);\n  color: var(--text);\n  font-size: 14px;\n  padding: 14px 16px;\n}\n\n.palette-input:focus {\n  outline: none;\n}\n\n.palette-list {\n  margin: 0;\n  padding: 6px;\n  list-style: none;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n}\n\n.palette-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  padding: 8px 10px;\n  border-radius: 6px;\n  text-align: left;\n  color: var(--text);\n  font-size: 12px;\n}\n\n.palette-item.selected {\n  background: var(--accent-soft);\n}\n\n.palette-item.selected .palette-title {\n  color: var(--accent);\n}\n\n.palette-title {\n  flex: 1;\n  min-width: 0;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.palette-kbd {\n  flex: none;\n}\n\n.palette-group {\n  flex: none;\n  font-size: 9px;\n  font-family: var(--mono);\n  letter-spacing: 0.1em;\n  color: var(--text-faint);\n}\n\n.palette-empty {\n  padding: 16px;\n  text-align: center;\n  color: var(--text-dim);\n  font-size: 12px;\n}\n\n.palette-footer {\n  padding: 8px 14px;\n  border-top: 1px solid var(--border-soft);\n  color: var(--text-faint);\n  font-size: 10px;\n}\n\n/* SW update banner (PWA \"prompt\" mode) — src/sw-update.ts */\n.pf-update-banner {\n  position: fixed;\n  right: 16px;\n  bottom: 16px;\n  z-index: 10000;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 12px;\n  background: var(--panel, #1c1f27);\n  color: var(--text, #eee);\n  border: 1px solid var(--accent, #f59e0b);\n  border-radius: 8px;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);\n  font-family: inherit;\n  font-size: 12px;\n}\n\n/* Arrangement zoom + clip marquee + delete toast */\n.arr-zoom-group {\n  display: inline-flex;\n  gap: 2px;\n}\n\n.arr-marquee {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  background: rgba(245, 158, 11, 0.12);\n  border: 1px solid rgba(245, 158, 11, 0.55);\n  pointer-events: none;\n  z-index: 4;\n}\n\n.arr-delete-toast {\n  position: fixed;\n  right: 16px;\n  bottom: 44px;\n  z-index: 60;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 6px 10px;\n  background: #1a1d23;\n  border: 1px solid #2c3037;\n  border-radius: 6px;\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);\n  font-size: 12px;\n}\n\n/* Scene Mode wall-clock authoring (SCENE SECS) */\n.arr-clip-secs {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 10px;\n  color: #71717a;\n}\n\n.arr-clip-secs input {\n  width: 62px;\n  background: #101216;\n  border: 1px solid #2c3037;\n  border-radius: 4px;\n  color: #f4f4f5;\n  font-size: 11px;\n  padding: 3px 5px;\n}\n\n.scene-loop-info {\n  font-size: 10px;\n  letter-spacing: 0.06em;\n  color: #71717a;\n  padding: 2px 0;\n}\n\n/* Mod matrix shared UI (Inspector advanced + floating plugin) — mirrors the\n   WavetablePanel selectRow look via the wt-mod-* classes above. */\n.mod-matrix {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 8px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  margin-top: 8px;\n}\n\n.mod-matrix .wt-mod-row .slider-wrap {\n  flex: 1;\n  min-width: 0;\n}\n\n/* MPE discoverability strip (MidiPanel): badge + per-note pressure/timbre bars */\n.mpe-indicator {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  margin-left: auto;\n}\n\n.mpe-badge {\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  padding: 1px 5px;\n  border-radius: 3px;\n  border: 1px solid rgba(255, 255, 255, 0.18);\n  color: rgba(255, 255, 255, 0.4);\n}\n\n.mpe-badge.active {\n  color: var(--accent);\n  border-color: var(--accent);\n}\n\n.mpe-hint {\n  font-size: 9px;\n  color: rgba(255, 255, 255, 0.35);\n}\n\n.mpe-note {\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n}\n\n.mpe-note-name {\n  font-size: 9px;\n  color: rgba(255, 255, 255, 0.75);\n}\n\n.mpe-bar {\n  display: inline-block;\n  width: 18px;\n  height: 4px;\n  border-radius: 2px;\n  background: rgba(255, 255, 255, 0.12);\n  overflow: hidden;\n}\n\n.mpe-bar-fill {\n  display: block;\n  height: 100%;\n  border-radius: 2px;\n}\n\n.mpe-bar-fill.mpe-pressure {\n  background: var(--accent);\n}\n\n.mpe-bar-fill.mpe-timbre {\n  background: rgba(96, 165, 250, 0.9);\n}\n\n/* SIMILAR similarity chip in the preset browser */\n.preset-sim {\n  font-size: 9px;\n  font-weight: 700;\n  color: var(--accent);\n  white-space: nowrap;\n}\n\n/* Instant Jam: gallery card button + collab panel badge */\n.gallery-jam {\n  color: var(--accent);\n}\n\n.collab-jam-badge {\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  padding: 1px 5px;\n  border-radius: 3px;\n  border: 1px solid var(--accent);\n  color: var(--accent);\n}\n\n/* TAP TO JAM gate — full-screen autoplay-policy moment for jam joiners */\n.jam-gate {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: radial-gradient(1200px 600px at 50% 40%, rgba(245, 158, 11, 0.14), transparent 70%), rgba(6, 8, 12, 0.94);\n  cursor: pointer;\n  user-select: none;\n}\n\n.jam-gate-inner {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 10px;\n  text-align: center;\n  padding: 32px;\n}\n\n.jam-gate-badge {\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.14em;\n  color: var(--accent);\n  border: 1px solid var(--accent);\n  border-radius: 999px;\n  padding: 3px 12px;\n  animation: jam-gate-pulse 1.6s ease-in-out infinite;\n}\n\n@keyframes jam-gate-pulse {\n  0%,\n  100% {\n    opacity: 0.55;\n  }\n  50% {\n    opacity: 1;\n  }\n}\n\n.jam-gate-title {\n  font-size: 44px;\n  font-weight: 800;\n  letter-spacing: 0.06em;\n  color: #fff;\n}\n\n.jam-gate-sub {\n  font-size: 12px;\n  color: rgba(255, 255, 255, 0.55);\n  max-width: 420px;\n}\n\n/* PUBLISH THIS JAM — the loop closer in the collab panel */\n.collab-publish {\n  color: var(--accent);\n}\n\n/* AI bandmate section in the collab panel */\n.collab-bandmate {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 8px;\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  border-radius: 6px;\n  margin-top: 6px;\n}\n\n.collab-bandmate-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n\n.collab-bandmate-title {\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n}\n\n.collab-bandmate-on {\n  color: var(--accent);\n  margin-left: 4px;\n}\n\n.collab-bandmate-off {\n  color: rgba(255, 255, 255, 0.35);\n  margin-left: 4px;\n}\n\n.collab-bandmate-scene {\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  color: rgba(96, 165, 250, 0.9);\n}\n\n/* ARRANGE by words — intent section in the assist panel */\n.assist-arrange {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 10px;\n  border: 1px solid rgba(96, 165, 250, 0.35);\n  border-radius: 8px;\n  margin-bottom: 10px;\n}\n\n/* KYX logo → landing (project browser header): DAW-standard home affordance */\na.brand {\n  text-decoration: none;\n  cursor: pointer;\n  transition: opacity 0.15s ease;\n}\n\na.brand:hover {\n  opacity: 0.8;\n}\n\na.brand:hover .brand-mark {\n  box-shadow: 0 0 12px rgba(245, 158, 11, 0.45);\n}\n\n/* INTENT dock panel (VISION §10) */\n.intent-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 12px;\n  height: 100%;\n  overflow-y: auto;\n  contain: layout style;\n}\n.intent-header {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n}\n.intent-title {\n  font-size: 12px;\n  font-weight: bold;\n  letter-spacing: 0.08em;\n  color: var(--accent);\n}\n.intent-subtitle {\n  font-size: 10px;\n  color: var(--muted);\n}\n.intent-textarea {\n  width: 100%;\n  min-height: 60px;\n  background: var(--bg-panel);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  color: var(--text);\n  font:\n    13px/1.4 system-ui,\n    sans-serif;\n  padding: 8px;\n  resize: vertical;\n}\n.intent-textarea:focus {\n  outline: 1px solid var(--accent);\n}\n.intent-detected {\n  font-size: 10px;\n  color: var(--accent);\n  letter-spacing: 0.04em;\n}\n.intent-error {\n  font-size: 11px;\n  color: #f87171;\n}\n.intent-status {\n  font-size: 11px;\n  color: #4ade80;\n}\n/* A3 share moment — revealed right after USE. Compact row that fits the\n   380px dock without crowding the generate actions below it. */\n.intent-share {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  padding: 8px;\n  border: 1px solid rgba(245, 158, 11, 0.28);\n  border-radius: 8px;\n  background: rgba(245, 158, 11, 0.05);\n}\n.intent-share-label {\n  font-size: 10.5px;\n  font-weight: bold;\n  letter-spacing: 0.06em;\n  color: var(--accent);\n}\n.intent-share-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n.intent-share-actions .btn,\n.intent-share-actions .btn-export {\n  padding: 4px 9px;\n  font-size: 10px;\n  letter-spacing: 0.05em;\n}\n.intent-generate-btn {\n  align-self: flex-start;\n  font-weight: bold;\n  letter-spacing: 0.06em;\n}\n\n/* Device editors reflow against their actual dock slot. This also applies\n   when FX and instrument panels share the dock in split view. */\n