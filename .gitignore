node_modules/

# Generated: contract + mission fragment reassembly (npm run prompts:build)
prompts/_built/
__pycache__/
*.pyc
dist/
*.local
.DS_Store
# Local scratch artifacts (test outputs, audit log drafts). Tracked
# files in `scratch/` are explicitly `git add -f` if you want them committed.
scratch/

# Full-suite vitest capture (local only).
tests-full.log

# Playwright E2E artifacts (auto-generated by `npx playwright test --list`
# and test runs). The repo keeps the suite under tests/e2e/ — only the
# runtime outputs are ignored.
playwright-report/
test-results/
.playwright-cli/

# Electron desktop packaging outputs (buildResources icon, installers,
# unpacked app). `release-fresh/` is a leftover staging dir from an
# interrupted run — safe to delete once no process holds it.
release/
release-fresh/
build/

# Symbolic prior training dataset — regenerated deterministically by `npm run prior:train`
scripts/data/symbolic-prior-dataset.json

# TypeScript incremental build cache (239 KB generated). When
# `tsconfig.json` has `incremental: true`, the build cache absorbs partial
# runs and can mask regressions introduced during experimental config
# changes — see GOAL 04 follow-up #1 in AGENT_WORK_LOG.md. CI should always
# run `npx tsc --noEmit -p tsconfig.json --incremental false` so the cache
# cannot silently hide real typecheck errors.
tsconfig.tsbuildinfo*
*.bak
*.tsbuildinfo
.kilo/

# Semantic embedding model (T1 krok 2) — one-time fetch via npm run semantic:fetch
public/models/semantic/

# Golden review pack (human listening) — local-only, not served
golden-review/
listening/
v1v3-listening/

# Local browser profiling artifacts. Browser profiles can contain cookies,
# IndexedDB projects, local preferences and cache data; never commit them.
tmp-spectro-profile/
tmp-spectro-shots/
tmp-spectro-*.mjs

# Audio classification model (T4) — one-time fetch via npm run audio:fetch
public/models/audio/

# transient audit/coverage artifacts
coverage/
_tc*.log
_final*.log
_aet*.log
_test_run.log
public/models/audio/pca-projection.json
groove-listening/

# ORT diet (Phase 5 pack wave): only the plain simd-threaded variant is fetched
# at runtime (ranker/prior workers); the asyncify/jsep/jspi variants stay local-only.
public/models/ort/ort-wasm-simd-threaded.asyncify.*
public/models/ort/ort-wasm-simd-threaded.jsep.*
public/models/ort/ort-wasm-simd-threaded.jspi.*

# CLAP probe native build artifacts (ADR 0016)
native/clap-probe/build/

# ASIO SDK headers are NOT redistributable (Steinberg license) — fetched per machine
native/asio-host/asio-sdk/
native/asio-host/build/

# PCM host native build artifacts (ADR 0018)
native/pcm-host/build/

# CLAP audio hosting build artifacts
native/clap-host/build/

# contest deploy build output (user-generated dist snapshot)
dist-contest/

# augmented training dataset (251 MB, generated by scripts/generate-augmented-data.mts)
scripts/data/augmented-drum-dataset.json

# Agent-session noise: ad-hoc fix scripts and run logs from coding-agent
# sessions (kilo/zcode) never belong in the repo. Real fixes land as source
# changes; real logs land in scratch/.
.zcode/
.kilo*.log
.preview*.log
.preview*.err

# Local listening-lab lanes (per-wave generated audio) — pattern-match the
# family instead of listing each wave dir by hand
lane-listening/
*-listening/
